{
  "$comment": "CV presets. Each section is defined once in `$sections`: its heading, its icon, and how it selects items. A preset lists the sections it shows, in order, by id, and overrides only what it does differently there, e.g. `{ \"id\": \"publications\", \"limit\": 5 }`; `null` removes a key. `detail` chooses whether an item's `details` field renders — this is what replaced make_short.py stripping % SKIP markers out of the .tex. An item appears in a preset only if the preset name is in its `cvs` array AND it matches a section. A preset with `includeAll` ignores `cvs` entirely and takes every item that matches a section — that is what separates the complete CV from the curated `full` one. A section may give a `short` name, which the contents list uses where it is short of room. A section's heading is written once, in the complete preset's shape; a preset that shows fewer than every item a section could hold gets \"Select \" in front of it, worked out at render time rather than typed in.",
  "$sections": {
    "education": {
      "heading": "Education",
      "icon": "education",
      "match": {
        "type": "education"
      }
    },
    "positions": {
      "heading": "Professional Appointments",
      "short": "Appointments",
      "icon": "positions",
      "match": {
        "type": "position"
      }
    },
    "publications": {
      "heading": "Publications",
      "icon": "publications",
      "match": {
        "type": "publication"
      },
      "layout": "publications",
      "groupBy": "status",
      "page": "/publications/"
    },
    "awards-major": {
      "heading": "Awards",
      "icon": "awards",
      "match": {
        "type": "award",
        "tier": "major"
      }
    },
    "grants-major": {
      "heading": "Grants & Fellowships",
      "icon": "grants",
      "match": {
        "type": "grant",
        "tier": "major"
      }
    },
    "software": {
      "heading": "Software",
      "icon": "code",
      "match": {
        "type": "software"
      },
      "layout": "grid",
      "page": "/software/"
    },
    "talks-invited": {
      "heading": "Invited Talks",
      "icon": "talks",
      "match": {
        "type": "presentation",
        "kind": [
          "invited",
          "seminar"
        ]
      }
    },
    "talks-contributed": {
      "heading": "Presentations",
      "icon": "talks",
      "match": {
        "type": "presentation",
        "kind": [
          "contributed",
          "poster",
          "accepted"
        ]
      }
    },
    "conferences": {
      "heading": "Conferences",
      "icon": "conferences",
      "match": {
        "type": "presentation",
        "kind": [
          "organizer",
          "attended"
        ]
      }
    },
    "mentoring": {
      "heading": "Mentoring",
      "icon": "mentoring",
      "match": {
        "type": "mentoring"
      }
    },
    "teaching": {
      "heading": "Teaching",
      "icon": "teaching",
      "match": {
        "type": "teaching"
      }
    },
    "peer-review": {
      "heading": "Peer Review",
      "icon": "publications",
      "list": "peer-review"
    },
    "service": {
      "heading": "Professional Service",
      "short": "Service",
      "icon": "service",
      "match": {
        "type": "service"
      }
    },
    "outreach": {
      "heading": "Outreach",
      "icon": "outreach",
      "match": {
        "type": "outreach"
      }
    },
    "grants-minor": {
      "heading": "Small Grants",
      "icon": "grants",
      "match": {
        "type": "grant",
        "tier": "minor"
      }
    },
    "media": {
      "heading": "Media",
      "icon": "media",
      "match": {
        "type": "media"
      }
    }
  },
  "complete": {
    "label": "All",
    "detail": "full",
    "includeAll": true,
    "sections": [
      "education",
      "positions",
      "grants-major",
      "awards-major",
      "publications",
      "software",
      "talks-invited",
      "talks-contributed",
      "conferences",
      "mentoring",
      "teaching",
      "peer-review",
      "service",
      "outreach",
      "grants-minor",
      "media"
    ]
  },
  "np": {
    "label": "NP",
    "detail": "full",
    "sections": [
      "education",
      "positions",
      "grants-major",
      "awards-major",
      "publications",
      "software",
      "talks-invited",
      "talks-contributed",
      "conferences",
      "mentoring",
      "teaching",
      "peer-review",
      "service",
      "outreach",
      "grants-minor",
      "media"
    ]
  },
  "2page": {
    "label": "2P",
    "detail": "summary",
    "sections": [
      "education",
      "positions",
      {
        "id": "grants-major",
        "limit": 6
      },
      {
        "id": "awards-major",
        "limit": 6
      },
      {
        "id": "publications",
        "limit": 10
      },
      {
        "id": "software",
        "limit": 5
      },
      {
        "id": "talks-invited",
        "limit": 8,
        "detail": "full"
      },
      {
        "id": "mentoring",
        "limit": 5,
        "detail": "full"
      },
      "peer-review",
      "service"
    ]
  },
  "1page": {
    "label": "1P",
    "detail": "summary",
    "sections": [
      "education",
      "positions",
      {
        "id": "grants-major",
        "limit": 4
      },
      {
        "id": "awards-major",
        "limit": 4
      },
      {
        "id": "publications",
        "groupBy": null,
        "limit": 5
      },
      {
        "id": "software",
        "limit": 5
      }
    ]
  }
}
