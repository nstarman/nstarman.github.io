---
// Prose with its [text](url) links as links — the HTML half of lib/inline.js.
// Pass `spans` already split, or `text` (and `base`, for `item:` targets) to
// split here.
import { spans as split } from '@nstarkman/data-resolver/inline.js';

const { spans, text, base = '' } = Astro.props;
const parts = spans ?? split(text, base);
---
{parts.map((x) => (x.alt && x.url ? <a class="pid" href={x.url} data-href={x.url} data-alt-href={x.alt.url}>
              <span class="pid__words">{x.t}</span><span class="pid__id" hidden>
              <svg class="ico" aria-hidden="true" focusable="false"><use href={`#i-${x.alt.icon}`} /></svg> {x.alt.t}</span></a>
  : x.alt ? <span class="pid"><span class="pid__words">{x.t}</span><span class="pid__id" hidden>
              <svg class="ico" aria-hidden="true" focusable="false"><use href={`#i-${x.alt.icon}`} /></svg> {x.alt.t}</span></span>
  : x.url ? <a href={x.url}>{x.t}</a>
  : x.forms ? <span class="amt" data-code={x.forms.code} data-us={x.forms.us} data-dollar={x.forms.dollar}>{x.t}</span>
  : x.t))}
