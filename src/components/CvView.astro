---
// Renders a resolved preset. Shared by /cv/ and /cv/<preset>/ so the two can
// never drift.
import { PRESET } from '../lib/cards.js';
import '../styles/cv/page.css';
import '../styles/cv/minimap.css';
import CvHeader from './CvHeader.astro';
import { softwarePapers, positionStops } from '../lib/data.js';
import { detailLines } from '../lib/inline.js';
import CollabMini from './CollabMini.astro';
import ConfMini from './ConfMini.astro';
import Inline from './Inline.astro';
import CvToc from './CvToc.astro';
import CvTimelineItem from './CvTimelineItem.astro';
import Card from './Card.astro';
import NumBox from './NumBox.astro';
import { spacingUnits } from '../lib/cvspacing.js';
import CV_STYLES from '../../cv/lib/styles.json';
import CV_GAPS from '../../cv/lib/gaps.json';

// Worth offering only when it splits the section: if every package has a
// paper, or none does, the button would just be a slower "All".
function paperCut(section) {
  const withPaper = section.items.filter((i) => softwarePapers(i).length).length;
  return withPaper > 0 && withPaper < section.items.length;
}

// Author-position stops for the publications selector, from the section's own
// items; None/All bracket them.
const posStops = (section) => positionStops(section.items).map((s2) => s2.n);

// `pick` turns the same CV into the builder's picker: every entry keeps its
// full rendering and gains a checkbox. Reading what you are selecting is the
// point — a list of bare titles is not the CV you are about to compile.
// `picked` is the starting selection, so the server renders the right ticks
// rather than the client unticking 155 boxes after paint.
const { cv, pick = false, picked = null, level = 'full', completeLines = cv.includeAll } = Astro.props;
const isPicked = (id) => !picked || picked.has(id);
// Elaboration is a list of lines, and in the builder each one is its own
// choice — inclusion is a tick, not a level.
const detail = (i) => (cv.detail === 'full' || pick ? detailLines(i, { complete: cv.includeAll }) : []);
// Which of those lines only the complete CV shows. They are appended last, so
// everything from this index on is complete-only — the builder needs to know,
// because seeding from NP must not tick a line the NP CV does not print.
const baseLines = (i) => detailLines(i).length;
// The section's own page, named by its icon rather than by the heading two
// inches to its left repeated in full. A page with no icon keeps the word, so
// adding one to config/presets.json cannot produce a nameless arrow.
const PAGE_ICON = { '/publications/': 'paper', '/software/': 'code' };
const pageName = (page) => page.replaceAll('/', '');
// The kind of gap between a section's entries, as cv/lib/gaps.json names it —
// the same choice cv.typ makes by layout. Its size, at the builder's normal
// density, lets a field convert between a multiple and points.
const entryGap = (s) => (['list', 'grid', 'publications'].includes(s.layout) ? s.layout : 'entries');
const gapBase = (name) => CV_GAPS[name].normal;
// How each section's heading prints: none, or one of the heading variants
// the PDF styles draw, as cv/lib/styles.json lists them — the style's first,
// its usual heading, to start. Each is a stop of a slider, shown as a sample
// letter drawn as the manifest says (underlined, or plain), named in words
// for its title; each names the styles that draw it, so the builder shows
// only the current style's. The first style is the menu's first, and so the
// one showing.
const FIRST_STYLE = Object.keys(CV_STYLES)[0];
const FIRST_USUAL = Object.keys(CV_STYLES[FIRST_STYLE].headings)[0];
const HEADS = [];
for (const [name, st] of Object.entries(CV_STYLES)) {
  for (const [v, look] of Object.entries(st.headings)) {
    let h = HEADS.find((x) => x.v === v);
    if (!h) HEADS.push((h = { v, ...look, styles: [] }));
    h.styles.push(name);
  }
}

// Consecutive talk sections — Invited Talks, Presentations, Conferences — as
// one run, so the conference map can span them. Every other section is a run
// of one.
const isTalks = (s) => s.items.length > 0 && s.items.every((item) => item.type === 'presentation');
const runs = [];
cv.sections.forEach((s, i) => {
  const talks = isTalks(s);
  const last = runs.at(-1);
  if (talks && last?.talks) last.sections.push({ s, i });
  else runs.push({ talks, sections: [{ s, i }] });
});

// The gutter map a heading's button opens, if it has one: the collaborators
// on Publications, the conferences on every talk heading — the map spans the
// run, so the reader may meet it from any of them.
const mapFor = (s) => {
  if (s.id === 'publications') return { id: 'cv-collab-map', words: 'where my collaborators have worked' };
  if (isTalks(s)) return { id: 'cv-conf-map', words: 'where I have given talks' };
  return null;
};

---
{!pick && <CvHeader current={cv.name} pdf={`/cv/starkman-cv-${cv.name}.pdf`} />}

{/* The builder places its own, above its controls, so that on a narrow screen
    the strip it becomes sits under the heading rather than below the toolbar. */}
{!pick && <CvToc sections={cv.sections} />}

{runs.map((run) => {
  const sections = run.sections.map(({ s, i }) => {
    // A collapsed section is a <details>: the disclosure is native, so it needs
    // no script and keeps working with JavaScript off. Every section takes the
    // same wrapper either way, so the spacing rules see one shape.
    const collapsed = s.collapsed && !pick;
    const Wrap = collapsed ? 'details' : 'div';
    const Head = collapsed ? 'summary' : 'div';
    const selectable = pick && s.items.length > 0;
    return (
    <Wrap class={`cvsec${i === 0 ? ' cvsec--first' : ''}${i === cv.sections.length - 1 ? ' cvsec--last' : ''}${selectable ? ' pickgroup' : ''}${s.id === 'publications' ? ' cvsec--hasmap' : ''}`}>
      <Head class="cvsechead">
        {selectable && (
          <input type="checkbox" class="groupbox"
                 checked={s.items.every((i) => isPicked(i.id))}
                 aria-label={`Include every ${s.heading} entry`} />
        )}
        {pick && s.key && (
          <input type="checkbox" class="itembox" value={s.key}
                 checked={isPicked(s.key)}
                 aria-label={`Include ${s.heading}`} />
        )}
        <h3 class="cvsection" id={s.id}>{s.heading}</h3>
        {collapsed && <span class="cvcount">{s.items.length}</span>}
        {/* Publications only, and only in the picker. The section checkbox is all
            or nothing; this is the same author-position cut the publications page
            offers, so a first-author CV is one click rather than nineteen. Hidden
            until the heading is hovered or something inside it takes focus, so it
            does not compete with the headings that have no such control. */}
        {selectable && s.id === 'publications' && posStops(s).length > 0 && (
          <span class="possel" role="group" aria-label="Select publications by author position">
            <button type="button" class="posbtn" data-possel="none">None</button>
            {posStops(s).map((n) => (
              <button type="button" class="posbtn" data-possel={n}>{n}</button>
            ))}
            <button type="button" class="posbtn" data-possel="all">All</button>
          </span>
        )}
        {/* Software's version of the same idea. Two stops rather than five,
            because the only cut worth making here is "has a paper", and shown
            only when it would actually cut something. */}
        {selectable && s.id === 'software' && paperCut(s) && (
          <span class="possel" role="group" aria-label="Select software by whether it has a paper">
            <button type="button" class="posbtn" data-papersel="all">All</button>
            <button type="button" class="posbtn posbtn--icon" data-papersel="yes"
                    aria-label="Only software with a paper" title="Only software with a paper">
              <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-paper" /></svg>
            </button>
          </span>
        )}
        {selectable && s.items.some((i) => detail(i).length > 0) && (
          <label class="subgrouplab">
            <input type="checkbox" class="subgroup" checked={level === 'full'}
                   aria-label={`Include every detail line under ${s.heading}`} />
            detail
          </label>
        )}
        {/* Beside `detail`, the other choices about how a section is printed
            rather than what is in it. They open below the rule, so the heading
            row stays one line. */}
        {pick && (
          <button type="button" class="fmtbtn posbtn posbtn--icon" aria-expanded="false"
                  aria-controls={`fmt-${s.id}`}
                  aria-label={`Formatting for ${s.heading}`} title="Formatting">
            <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-sliders" /></svg>
          </button>
        )}
        {s.page && !pick && (
          <a class="more seclink" href={s.page} aria-label={`All ${pageName(s.page)}`}
             title={`All ${pageName(s.page)}`}>
            All {PAGE_ICON[s.page]
              ? <svg class="ico" aria-hidden="true" focusable="false"><use href={`#i-${PAGE_ICON[s.page]}`} /></svg>
              : pageName(s.page)}</a>
        )}
        {/* In the `}` gutter, centred on the column where each paper's source
            link sits, so it reads as part of that column rather than as another
            control on the heading row. Publications, for the people in these
            bylines, and each talk heading, for the places in the run of talk
            sections they share. The button is rendered here because it
            belongs to this row; what it does is in lib/minipick.js, with the map
            it opens and with the panel's own copy of it. */}
        {mapFor(s) && (
          <button type="button" class="cvminibtn" aria-expanded="false"
                  aria-controls={mapFor(s).id}
                  aria-label={`Show ${mapFor(s).words}`}
                  title={`Show ${mapFor(s).words}`}>
            <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-map" /></svg>
          </button>
        )}
      </Head>

      {pick && (
        <div class="fmtrow" id={`fmt-${s.id}`} hidden>
          {/* One line per thing formatted — its heading, the student legend
              that opens Publications, its entries — the subject in bold,
              then its options. Each spacing is one key of the template's
              `spacing`: `<id>.heading`, `<id>.legend`, and the section's id
              for its entries; the legend's place is `<id>.legend` of its
              `place`. An option hides where it would do nothing: the
              heading's spacing and the legend's Title place with no heading, the
              legend's spacing with the legend up on the heading's line. */}
          {[
            { sub: 'Heading', style: true, key: `${s.id}.heading`, gap: 'heading', words: `Space below the ${s.heading} heading` },
            ...(s.id === 'publications'
              ? [{ sub: 'Legend', place: true, key: `${s.id}.legend`, gap: 'legend', words: `Space below the ${s.heading} legend of student marks` }]
              : []),
            { sub: 'Items', key: s.id, gap: entryGap(s), words: `Space between ${s.heading} entries` },
          ].map((o) => (
            <>
              <span class="fmtsub">{o.sub}</span>
              {/* The subject's options, from the left, straight after it. */}
              <span class="fmtline">
              {o.place && (
                <span class="fmtopt fmtopt--place">
                  <span class="fmtlab">Place</span>
                  <span class="pubfilter pubfilter--inline fmtslider" role="radiogroup" data-stops="3"
                        aria-label={`Where the ${s.heading} legend sits`} data-place-of={o.key}>
                    <label title="On its own line, below the heading">
                      <input type="radio" class="posradio" name={`place:${o.key}`} value="below" checked />Below</label>
                    <label title="On its own line, below the heading, at its right">
                      <input type="radio" class="posradio" name={`place:${o.key}`} value="right" />Right</label>
                    <label title="On the heading's line, at its right">
                      <input type="radio" class="posradio" name={`place:${o.key}`} value="title" />Title</label>
                  </span>
                </span>
              )}
              {o.place ? null : o.style ? (
                  <span class="fmtopt">
                    <span class="fmtlab">Style</span>
                    <span class="pubfilter pubfilter--inline fmtslider" role="radiogroup"
                          aria-label={`How the ${s.heading} heading prints`} data-heading-of={s.id}
                          data-stops={1 + HEADS.filter((h) => h.styles.includes(FIRST_STYLE)).length}>
                      {HEADS.map((h) => (
                        <label title={h.label} data-styles={h.styles.join(' ')} hidden={!h.styles.includes(FIRST_STYLE)}>
                          <input type="radio" class="posradio" name={`heading:${s.id}`} value={h.v} aria-label={h.label}
                                 checked={h.v === FIRST_USUAL} />
                          <span class:list={['headsample', { 'headsample--under': h.underline }]} aria-hidden="true">X</span></label>
                      ))}
                      <label title="No heading">
                        <input type="radio" class="posradio" name={`heading:${s.id}`} value="none" />None</label>
                    </span>
                  </span>
                ) : null}
              {/* "Select Publications" when only some are ticked — or not.
                  A list section is taken whole, so never says it. */}
              {o.style && s.items.length > 0 && (
                <span class="fmtopt fmtopt--prefix" hidden>
                  <span class="fmtlab">Prefix</span>
                  <span class="pubfilter pubfilter--inline fmtslider" role="radiogroup" data-stops="2"
                        aria-label={`Whether the ${s.heading} heading says Select`} data-prefix-of={s.id}>
                    <label title={`“Select ${s.heading}” while only some are ticked`}>
                      <input type="radio" class="posradio" name={`prefix:${s.id}`} value="select" checked />Select</label>
                    <label title={`“${s.heading}” however many are ticked`}>
                      <input type="radio" class="posradio" name={`prefix:${s.id}`} value="none" />None</label>
                  </span>
                </span>
              )}
                <span class:list={['fmtopt', { 'fmtopt--headgap': o.style, 'fmtopt--legendgap': o.place }]}>
                  <span class="fmtlab">Spacing</span>
                  <NumBox name={o.key} label={o.words} units={spacingUnits(gapBase(o.gap))}
                          unitName={`${o.key}.unit`} unitLabel={`${o.words}, in`} compact />
                </span>
              </span>
            </>
          ))}
        </div>
      )}

      {s.layout === 'list' ? (
        <ul class="plainlist">
          {s.entries.map((e) => (
            <li><Inline text={e} /></li>
          ))}
        </ul>
      ) : s.layout === 'grid' ? (
        /* Software: the same s-portrait-summary cards the software page's long tail uses. The
           packages carry no dates worth a gutter, and the published-vs-other
           split lived on the papers, which the publication list already holds. */
        <div class="soft soft--mini">
          {s.items.map((item) => (
            <Card item={item} preset={PRESET.softwareOther} id={`item-${item.id}`}>
              <a slot="corner" class="srclink" href={`/records/${item.id}.json`}
                 aria-label={`${item.title} — JSON source`} title="JSON source">{'}'}</a>
              {pick && (
                <input slot="name" type="checkbox" class="itembox" value={item.id}
                       data-paper={softwarePapers(item).length ? 'yes' : undefined}
                       checked={isPicked(item.id)}
                       aria-label={`Include ${item.title}`} />
              )}
            </Card>
          ))}
        </div>
      ) : (
      <div class="timeline">
        {s.items.map((item) => (
          <CvTimelineItem item={item} pick={pick} picked={isPicked(item.id)}
                          lines={detail(item)} baseCount={baseLines(item)}
                          level={level} completeLines={completeLines} />
        ))}
      </div>
      )}
      {s.dropped > 0 && <p class="dropped">{s.dropped} more not shown.</p>}
      {/* Inside the section on purpose. It is absolutely positioned into the
          right margin and sticks while the section is on screen, so the section's
          own box is what stops it: past the last publication it scrolls away with
          everything else rather than following the reader down the page. */}
      {s.id === 'publications' && <CollabMini ids={s.items.map((item) => item.id)} />}
    </Wrap>
    );
  });
  // A run of talk sections shares one wrapper, so the conference map in it
  // sticks through all of them and stops after the last.
  return run.talks ? (
    <div class="cvtalks">
      {sections}
      <ConfMini ids={run.sections.flatMap(({ s }) => s.items.map((item) => item.id))} />
    </div>
  ) : sections;
})}
