---
// The packages of mine a paper — or a research topic's papers — used, each an
// inline-card to its entry on /software/. `id` names the row's label, and so
// must be unique on the page.
import { siteHref } from '../lib/cards.js';

const { items, id } = Astro.props;
---
{items.length > 0 && (
  <div class="swrow">
    <span class="swrow-head" id={id}>Software</span>
    <ul aria-labelledby={id}>
      {items.map((s) => <li><a class="inline-card" href={siteHref(s)}>{s.title}</a></li>)}
    </ul>
  </div>
)}
