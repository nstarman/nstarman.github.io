---
// One formatting row: a section's own, or — with `all` — the one behind the
// builder's settings button, which sets every section's at once. Used only in the builder.
import NumBox from './NumBox.astro';
import { spacingUnits } from '../lib/cvspacing.js';
import CV_STYLES from '../../cv/lib/styles.json';
import CV_GAPS from '../../cv/lib/gaps.json';
import { SCHOLAR_STALE_DAYS } from '../lib/presets.js';
import person from '../../config/person.json';

const { s, all = false } = Astro.props;
// The kind of gap between a section's entries, as cv/lib/gaps.json names it —
// the same choice cv.typ makes by layout. Its size, at the builder's normal
// density, lets a field convert between a multiple and points.
const entryGap = (s) => (['list', 'grid', 'publications'].includes(s.layout) ? s.layout : 'entries');
const gapBase = (name) => CV_GAPS[name].normal;
// How each section's heading prints: none, or one of the heading variants
// the PDF styles draw, as cv/lib/styles.json lists them — the style's first,
// its usual heading, to start. Each is a stop of a slider, shown as a sample
// letter drawn as the manifest says (underlined, or plain), named in words
// for its title; each names the styles that draw it, so the builder shows
// only the current style's. The first style is the menu's first, and so the
// one showing.
const FIRST_STYLE = Object.keys(CV_STYLES)[0];
const FIRST_USUAL = Object.keys(CV_STYLES[FIRST_STYLE].headings)[0];
const HEADS = [];
for (const [name, st] of Object.entries(CV_STYLES)) {
  for (const [v, look] of Object.entries(st.headings)) {
    let h = HEADS.find((x) => x.v === v);
    if (!h) HEADS.push((h = { v, ...look, styles: [] }));
    h.styles.push(name);
  }
}
---
<div class:list={['fmtrow', { 'fmtrow--all': all }]} id={`fmt-${s.id}`} hidden>
  {/* One line per thing formatted — its heading, the student legend
      that opens Publications, its entries — the subject in bold,
      then its options. Each spacing is one key of the template's
      `spacing`: `<id>.heading`, `<id>.legend`, and the section's id
      for its entries; the legend's place is `<id>.legend` of its
      `place`. An option hides where it would do nothing: the
      heading's spacing and the legend's Title place with no heading, the
      legend's spacing with the legend up on the heading's line. */}
  {[
    { sub: 'Heading', style: true, key: `${s.id}.heading`, gap: 'heading', words: `Space below the ${s.heading} heading` },
    ...(s.id === 'publications'
      ? [{ sub: 'Legend', place: true, key: `${s.id}.legend`, gap: 'legend', words: `Space below the ${s.heading} legend of student marks` }]
      : []),
    { sub: 'Items', key: s.id, gap: entryGap(s), columns: s.layout === 'grid' && !all, words: `Space between ${s.heading} entries`,
      // Dated entries have a right-hand column for their place.
      places: !all && (s.layout ?? 'timeline') === 'timeline' && s.items.length > 0,
      // A publication list can open with its headline numbers.
      tally: !all && s.layout === 'publications' },
  ].map((o) => (
    <>
      <span class="fmtsub">{o.sub}</span>
      {/* The subject's options, from the left, straight after it. */}
      <span class="fmtline">
      {o.place && (
        <span class="fmtopt fmtopt--place">
          <span class="fmtlab">Place</span>
          <span class="pubfilter pubfilter--inline fmtslider" role="radiogroup" data-stops="3"
                aria-label={`Where the ${s.heading} legend sits`} data-place-of={o.key}>
            <label title="On its own line, below the heading">
              <input type="radio" class="posradio" name={`place:${o.key}`} value="below" checked />Below</label>
            <label title="On its own line, below the heading, at its right">
              <input type="radio" class="posradio" name={`place:${o.key}`} value="right" />Right</label>
            <label title="On the heading's line, at its right">
              <input type="radio" class="posradio" name={`place:${o.key}`} value="title" />Title</label>
          </span>
        </span>
      )}
      {o.place ? null : o.style ? (
          <span class="fmtopt">
            <span class="fmtlab">Style</span>
            <span class="pubfilter pubfilter--inline fmtslider" role="radiogroup"
                  aria-label={`How the ${s.heading} heading prints`} data-heading-of={all ? undefined : s.id} data-heading-all={all ? '' : undefined}
                  data-stops={1 + HEADS.filter((h) => h.styles.includes(FIRST_STYLE)).length}>
              {HEADS.map((h) => (
                <label title={h.label} data-styles={h.styles.join(' ')} hidden={!h.styles.includes(FIRST_STYLE)}>
                  <input type="radio" class="posradio" name={`heading:${s.id}`} value={h.v} aria-label={h.label}
                         checked={h.v === FIRST_USUAL} />
                  <span class:list={['headsample', { 'headsample--under': h.underline }]} aria-hidden="true">X</span></label>
              ))}
              <label title="No heading">
                <input type="radio" class="posradio" name={`heading:${s.id}`} value="none" />None</label>
            </span>
          </span>
        ) : null}
      {/* A grid's columns, a slider of stops as Place is; 3 is the usual. */}
      {o.columns && (
        <span class="fmtopt">
          <span class="fmtlab">Columns</span>
          <span class="pubfilter pubfilter--inline fmtslider" role="radiogroup" data-stops="4"
                aria-label={`Columns in the ${s.heading} grid`} data-columns-of={s.id}>
            {[2, 3, 4, 5].map((n) => (
              <label><input type="radio" class="posradio" name={`columns:${s.id}`} value={String(n)} checked={n === 3} />{n}</label>
            ))}
          </span>
        </span>
      )}
      {/* Whether entries print their place in the right-hand column; an
          amount prints either way. */}
      {o.places && (
        <label class="fmtopt fmtcheck" title={`Print each ${s.heading} entry's place`}>
          <input type="checkbox" name={`location:${s.id}`} data-location-of={s.id} checked />Places</label>
      )}
      {/* The tally, and which h-index it adds, if any: each source's says where
          it is from, as the sources disagree. */}
      {o.tally && (
        <span class="fmtopt">
          <label class="fmtcheck" title={`Open ${s.heading} with its counts`}>
            <input type="checkbox" name={`tally:${s.id}`} data-tally-of={s.id} />Tally</label>
          <select class="btn btn--sel" name={`hindex:${s.id}`} data-hindex-of={s.id} aria-label={`The h-index in the ${s.heading} tally`}>
            <option value="">no h-index</option>
            <option value="ads">h-index: ADS</option>
            <option value="scholar">h-index: Google Scholar</option>
            <option value="scholar-since">{`h-index: Google Scholar, since ${person.metrics?.googleScholar?.since ?? 'recent'}`}</option>
          </select>
          {/* Shown by the builder's script when the hand-read Scholar numbers are old. */}
          <span class="fmtstale" data-scholar-stale data-asof={person.metrics?.googleScholar?.asOf} data-days={SCHOLAR_STALE_DAYS} hidden role="status">Scholar numbers read {person.metrics?.googleScholar?.asOf}: update them</span>
        </span>
      )}
      {/* "Select Publications" when only some are ticked — or not.
          A list section is taken whole, so never says it. */}
      {o.style && !all && s.items.length > 0 && (
        <span class="fmtopt fmtopt--prefix" hidden>
          <label class="bl" title={`“Select ${s.heading}” while only some are ticked`}>
            <input type="checkbox" name={`prefix:${s.id}`} data-prefix-of={s.id} /> “Select” prefix</label>
        </span>
      )}
        <span class:list={['fmtopt', { 'fmtopt--headgap': o.style, 'fmtopt--legendgap': o.place }]}>
          <span class="fmtlab">Spacing</span>
          <NumBox name={o.key} label={o.words} units={spacingUnits(gapBase(o.gap))}
                  unitName={`${o.key}.unit`} unitLabel={`${o.words}, in`} compact />
        </span>
      </span>
    </>
  ))}
  {all && (
    <>
      {/* How the PDF is printed, apart from what is in it: its look, from
          cv/lib/styles.json (the manifest styles.typ checks itself against, so
          the menu cannot offer a style the template lacks), and its paper. */}
      <span class="fmtsub">Document</span>
      <span class="fmtline">
        <label class="fmtlab" for="style">Style</label>
        <select class="btn btn--sel" id="style">
          {Object.entries(CV_STYLES).map(([n, st]) => <option value={n}>{st.label}</option>)}
        </select>
        <label class="fmtlab" for="format">Page</label>
        <select class="btn btn--sel" id="format">
          <option value="">Style's default</option>
          <option value="a4">A4</option>
          <option value="letter">US Letter, 12pt</option>
        </select>
        <label class="fmtlab" for="names">Institution names</label>
        <select class="btn btn--sel" id="names">
          <option value="" disabled hidden>Mixed</option>
          <option value="0">Full</option>
          <option value="1">Shorter</option>
          <option value="2">Shortest</option>
        </select>
      </span>
      <span class="fmtsub">Amounts</span>
      <span class="fmtline">
        <label class="fmtlab" for="currency">Currency</label>
        <select class="btn btn--sel" id="currency">
          <option value="">USD, CAD</option>
          <option value="us">US$, CA$</option>
          <option value="dollar">$, CA$</option>
        </select>
      </span>
      <span class="fmtsub">Education</span>
      <span class="fmtline">
        <label class="fmtopt fmtcheck" title="Put each university on its own line, below the degree, with no comma">
          <input type="checkbox" id="schoolbelow" />Put the university on its own line, below the degree</label>
      </span>
      <span class="fmtsub">Mentoring</span>
      <span class="fmtline">
        <label class="fmtopt fmtcheck" title="Cite a mentee's papers by DOI, else arXiv id, instead of in words">
          <input type="checkbox" id="paperids" />Cite a mentee's papers by identifier (DOI, else arXiv)</label>
      </span>
      <span class="fmtsub">Selecting</span>
      <span class="fmtline">
        <label class="fmtopt fmtcheck">
          <input type="checkbox" id="selprefix" />“Select” prefix</label>
      </span>
      {/* The right-hand column of dated entries: as wide as its widest place or
          amount, or capped so a long one wraps. */}
      <span class="fmtsub">Right column</span>
      <span class="fmtline">
        <label class="fmtopt fmtcheck" title="Stop the column at a set width, so a long place or amount wraps onto a second line">
          <input type="checkbox" id="trailcap" />Cap its width, so long places and amounts wrap</label>
      </span>
      <span class="fmtline">
        <label class="fmtopt fmtcheck" title="Size the right column to the figures and places that fit, not the longest, so the middle text wraps later; it stays one column">
          <input type="checkbox" id="fill" />Fill the middle column: size the right column to the figures, so text wraps later</label>
      </span>
      <span class="fmtsub">Order</span>
      <span class="fmtline">
        <button type="button" class="btn" id="resetorder" disabled>Reset section order</button>
      </span>
    </>
  )}
</div>
