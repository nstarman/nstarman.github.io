---
// One publication. `brief` is the landing-page variant: year and a single
// `paper` button stacked in the right-hand column, everything else dropped.
import { authors, venueLine, year, links, authorPosition, venueUrl, HIGHLIGHT_TOPICS } from '../lib/data.js';
import { mathParts } from '../lib/maths.js';
import { spans } from '../lib/inline.js';
import LinkIcons from './LinkIcons.astro';

const { item, brief = false, maxAuthors = 8, abstract = false, anchor } = Astro.props;

const { shown, etal, collaboration } = authors(item, brief ? 3 : maxAuthors);
const venue = venueLine(item);
const venueHref = venueUrl(item);
const all = links(item);
const paper = all.find((l) => l.rel === 'paper') ?? all.find((l) => l.rel === 'preprint');
const trail = brief ? [] : all;
const pending = item.status !== 'published' ? item.status : null;
// The filter on /publications/ is CSS over this attribute, so it has to be on
// the outermost element — that is what gets hidden.
const pos = authorPosition(item);
// Only a topic /research/ actually shows has a section to link to.
const topic = HIGHLIGHT_TOPICS.find(([key]) => key === item.highlight?.topic);
---
<article id={anchor} class={`${brief ? 'entry--brief' : 'entry--full'}${pending ? ' entry--unpub' : ''}`}
         data-pos={pos ?? undefined}
         data-year={year(item) || undefined}
         data-tags={item.tags?.length ? item.tags.join(' ') : undefined}>
  <div class="body">
    <div class="ttl">
      {/* No link at all before a submitted paper reaches arXiv: a bare title, not a dead '#'. */}
      {paper ? <a href={paper.url}>{item.title}</a> : item.title}
      {pending && <span class="statustag">{pending}</span>}
    </div>

    <p class="meta">
      {collaboration && <>{collaboration}, </>}
      {shown.map((a, i) => (
        <>{i > 0 && ', '}{a.me
          ? <span class="me">{a.name}</span>
          : a.url
            ? <a class="authorlink" href={a.url}>{a.name}</a>
            : a.name}</>
      ))}
      {etal && <>, et al.</>}
      {brief && venue && <> · {venueHref
        ? <a class="venue venuelink" href={venueHref}>{venue}</a>
        : <span class="venue">{venue}</span>}</>}
    </p>

    {!brief && (venue || item.arxiv) && (
      <p class="venueline">
        {venue && (venueHref
          ? <a class="venue venuelink" href={venueHref}>{venue}</a>
          : <span class="venue">{venue}</span>)}
        {venue && <span class="dot">·</span>}
        {!venue && item.arxiv && <>arXiv:{item.arxiv}<span class="dot">·</span></>}
        <span class="yr">{year(item)}</span>
      </p>
    )}

    {/* The research card without its title or links — the title above
        already is the way into the paper. */}
    {abstract && item.highlight && (
      <div class="card hl-card hl-card--pub">
        <img src={`/${item.highlight.image}`} alt={item.highlight.alt} loading="lazy" />
        <div class="hl-body">
          <p>{spans(item.highlight.description, '/cv/').map((s) => s.url ? <a href={s.url}>{s.t}</a> : s.t)}</p>
          {topic && <a class="hl-context" href={`/research/#hl-topic-${topic[0]}`}
                       title={`${topic[1]} research highlights`}>Context&nbsp;›</a>}
        </div>
      </div>
    )}

    {abstract && item.abstract && (
      <details class="absmore">
        <summary>Abstract</summary>
        <p class="abstract">
          {/* Only the MathML Temml produced is set as HTML; the surrounding prose
              stays ordinary text and is escaped as usual. */}
          {mathParts(item.abstract).map((part) =>
            part.maths ? <Fragment set:html={part.html} /> : part.text)}
        </p>
      </details>
    )}
  </div>

  {brief && (
    <div class="side">
      <span class="yr">{year(item)}</span>
      {paper && <a class="btn" href={paper.url} title="paper">paper</a>}
    </div>
  )}

  {!brief && <LinkIcons links={trail} />}
</article>
