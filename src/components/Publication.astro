---
// One publication, as /publications/ lists it.
import { PRESET } from '../lib/cards.js';
import { authors, venueLine, year, links, authorPosition, softwareUsed } from '../lib/data.js';
import { mathParts } from '../lib/maths.js';
import LinkIcons from './LinkIcons.astro';
import Byline from './Byline.astro';
import Venue from './Venue.astro';
import Card from './Card.astro';
import SoftwareRow from './SoftwareRow.astro';

const { item, maxAuthors = 8, abstract = false, earlier = [], anchor } = Astro.props;

const { shown, etal, collaboration } = authors(item, maxAuthors);
const venue = venueLine(item);
const trail = links(item);
const pending = item.status !== 'published' ? item.status : null;
// The filter on /publications/ is CSS over this attribute, so it has to be on
// the outermost element — that is what gets hidden.
const pos = authorPosition(item);
---
<article id={anchor} class={`entry--full${pending ? ` entry--unpub entry--${pending}` : ''}`}
         data-pos={pos ?? undefined}
         data-year={year(item) || undefined}
         data-tags={item.tags?.length ? item.tags.join(' ') : undefined}>
  <div class="body">
    {/* The title is words: the link trail is the way into the paper. */}
    <div class="ttl" id={`pub-${item.id}`}>{item.title}</div>

    <p class="meta">
      {collaboration && <>{collaboration}, </>}
      <Byline shown={shown} />
      {etal && <>, et al.</>}
    </p>

    {/* Its status, beside the venue it is submitted to or accepted by. */}
    {(venue || item.arxiv || pending) && (
      <p class="venueline">
        <Venue item={item} />
        {venue && <span class="dot">·</span>}
        {!venue && item.arxiv && <>arXiv:{item.arxiv}<span class="dot">·</span></>}
        <span class="yr">{year(item)}</span>
        {pending && <span class="statustag">{pending}</span>}
      </p>
    )}

    {/* The research card without its title or links — the link trail
        already is the way into the paper — in the lighter tint, with the way
        to its topic on /research/. */}
    {abstract && item.highlight && (
      <Card item={item} preset={PRESET.paperHighlight}
            id={`hl-${item.id}`} />
    )}

    {/* The packages of mine it used, read from its software section. */}
    {abstract && <SoftwareRow items={softwareUsed([item])} id={`pub-sw-${item.id}`} />}

    {abstract && item.abstract && (
      <details class="absmore">
        <summary>Abstract</summary>
        <p class="abstract">
          {/* Only the MathML Temml produced is set as HTML; the surrounding prose
              stays ordinary text and is escaped as usual. */}
          {mathParts(item.abstract).map((part) =>
            part.maths ? <Fragment set:html={part.html} /> : part.text)}
        </p>
      </details>
    )}

    {/* Each proceeding of this paper, as a strip under it. */}
    {earlier.map((e) => <Card item={e} id={`pub-${e.id}`} preset={PRESET.proceeding} maxAuthors={maxAuthors} />)}
  </div>

  <LinkIcons links={trail} />
</article>
