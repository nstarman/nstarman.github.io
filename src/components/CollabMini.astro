---
// The collaborator map, shrunk to fit the CV's right margin.
//
// Same data and same projection as the full map on /research/ — imported, not
// reimplemented, so the two cannot disagree about where anyone worked. What is
// dropped is the prose: no per-person post list, no paper titles, no hover
// linking. At 176px those are unreadable, and the full map is one click away.
//
// What is kept is the picker, because the picker is the thing that makes a map
// of thirty-four people answer a question rather than just decorate. Here it
// earns more than it does on /research/: the CV it sits beside is a list of
// papers, so picking a collaborator can light up the ones we wrote together.
//
// Markup only. The arithmetic is lib/collabmini.js and the behaviour is
// lib/minipick.js, the same split CollabMap.astro makes.
import { miniMap, map } from '../lib/collabmini.js';

const { entries, dots, trails, label } = miniMap();
---

<aside class="cvmini" id="cv-collab-map" hidden>
  <div class="cvmini-stick">
    {/* The arrow is right-aligned, pointing out of the panel the way the
        "All X →" links do elsewhere on the site. Facing it is a second copy of
        the button that opened the map: that one rides on the Publications
        heading and scrolls away with it, and a panel that sticks to the
        viewport must be closable from where it is, not from where it started. */}
    <div class="cvmini-top">
      <button type="button" class="cvmini-shut" aria-controls="cv-collab-map"
              aria-expanded="true"
              aria-label="Hide where my collaborators have worked"
              title="Hide where my collaborators have worked">
        <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-map" /></svg>
      </button>
      <a class="cvmini-more" href="/research/#collaborators">Expanded View &rarr;</a>
    </div>

    <svg class="cvmini-svg" viewBox={`0 0 ${map.width} ${map.height}`} role="img"
         aria-label={`Map: where ${label} have worked. The same information is on the collaborator page.`}>
      <path class="cvmini-land" d={map.land} />
      {/* Lakes are drawn over the land in the ocean's colour, as on the full
          map: two paths and no fill-rule to get wrong. */}
      <path class="cvmini-lakes" d={map.lakes} />
      {/* Trajectories under the dots, so a pin sits on its own line rather than
          being crossed by it. Faint until someone is picked: thirty-four of
          them at this size is texture, not information — the picker is what
          turns one of them back into a path through a career. */}
      {trails.map((t) => (
        <polyline class="cvmini-trail" data-c={String(t.c)} points={t.points} />
      ))}
      {dots.map((d) => (
        <circle class={d.shared ? 'is-shared' : ''} data-c={String(d.c)}
                cx={d.x} cy={d.y} r="9" />
      ))}
    </svg>

    {/* Under the map, where the full one on /research/ puts its picker. The
        link above and the control below is the same shape as that figure, so
        the small copy reads as the same thing rather than a third arrangement. */}
    <select class="cvmini-who" aria-label="Highlight one collaborator">
      <option value="">Everyone</option>
      {entries.map((e) => (
        <option value={String(e.c)} data-papers={e.papers.join(' ')}>{e.name}</option>
      ))}
    </select>
  </div>
</aside>

<script>
  import { wireMiniMap } from '../lib/minipick.js';
  wireMiniMap();
</script>
