---
// One row of the CV's timeline: the date gutter, the entry, its detail lines
// and its links. In the builder (`pick`) it also carries the tick-boxes, so
// what you select is what you are reading.
import { dateLabel, authors, venueLine, links, REL_ICON, relKey, authorPosition, money }
  from '../lib/data.js';
import LinkIcons from '@nstarkman/card-builder/LinkIcons.astro';
import Inline from '@nstarkman/card-builder/Inline.astro';
import { lineTier, achievementTicked } from '@nstarkman/data-resolver/inline.js';
import Byline from '@nstarkman/card-builder/Byline.astro';
import Venue from '@nstarkman/card-builder/Venue.astro';

/**
 * @prop item
 * @prop pick           render the builder's tick-boxes
 * @prop picked         whether this entry starts ticked
 * @prop lines          its detail lines, one span array each
 * @prop baseCount      detail lines from this index on are complete-only (appended last)
 * @prop detailCount    where the detail lines end; any after are achievements, which
 *                     print wherever `cvs` marks them and so are never complete-only
 * @prop achievementCvs the `cvs` of each achievement line, from `detailCount` on
 * @prop startPreset    the preset the builder is seeded from; an achievement starts ticked only if it prints there
 * @prop level          the starting detail level; 'full' starts the lines ticked
 * @prop completeLines  whether the complete-only lines start ticked
 * @prop recipientInline whether the recipient starts on the title line (the preset's say, else the item's)
 * @prop member         a role listed under its institution's own row, which
 *                     names the institution — so this one sets it apart, to
 *                     show only if the section is turned back to separate rows
 */
const { item, pick = false, picked = true, lines = [], baseCount = lines.length, achievementCvs = [], detailCount = lines.length,
        level = 'full', startPreset = null, completeLines = false, member = false,
        recipientInline = item.recipientInline } = Astro.props;

// What rides in the left date gutter rather than under the text: an
// institution's homepage anywhere, and a talk's whole trail — a presentation's
// only link is the event, and it belongs beside the date it happened on.
const inGutter = (l) => l.rel === 'homepage' || item.type === 'presentation';
const gutterLinks = links(item).filter(inGutter);
const bodyLinks = links(item).filter((l) => !inGutter(l));
const byline = item.type === 'publication' ? authors(item, 4) : null;
---
<div class={`tl${item.type === 'publication' ? ' tl--pub' : ''}${pick ? ' tl--pick' : ''}${member ? ' tl--member' : ''}${item.status && item.status !== 'published' ? ' tl--unpub' : ''}`}
     id={`item-${item.id}`}>
  {pick && (
    <input type="checkbox" class="itembox" value={item.id}
           data-pos={item.type === 'publication'
             ? (authorPosition(item) ?? undefined) : undefined}
           checked={picked}
           aria-label={`Include ${item.title}`} />
  )}
  <a class="srclink" href={`/records/${item.id}.json`}
     aria-label={`${item.title} — JSON source`} title="JSON source">{'}'}</a>
  <span class="when">
    {dateLabel(item)}
    {gutterLinks.length > 0 && (
      <span class="gutterlinks">
    {gutterLinks.map((l) => (
      <a class="homelink" href={l.url}
         aria-label={`${item.event ?? item.institution ?? item.organization ?? item.title} ${l.label ?? l.rel}`}
         title={l.label ?? l.rel}>
        <svg class="ico" aria-hidden="true" focusable="false">
          <use href={`#i-${REL_ICON[relKey(l)] ?? 'link'}`} />
        </svg>
      </a>
    ))}
      </span>
    )}
  </span>
  <span class="what">
    <strong>{item.title}</strong>
    {item.institution && (member
      ? <span class="inst">, {item.institution}</span>
      : <>, {pick && item.institutionNames?.length > 0
          /* The builder's: the institution's name is its own menu, so it is said once. */
          ? <select class="namesel" data-names-of={item.id} aria-label={`Institution name for ${item.title}`}
                    title="Choose how much of the institution's name prints">
              <option value="0">{item.institution}</option>
              <option value="1">{item.institutionNames[0]}</option>
              {item.institutionNames.length > 1 && <option value="2">{item.institutionNames.at(-1)}</option>}
            </select>
          : item.institution}</>)}
    {/* The builder's: the institution an award or grant names, and whether it prints. */}
    {pick && item.funder && ['award', 'grant'].includes(item.type) && (
      <label class="funderopt" title="Print this institution after the title">, <input type="checkbox" class="funderbox"
             data-funder-of={item.id} checked
             aria-label={`Print ${item.funder} after ${item.title}`} /><span class="funderopt__name">{item.funder}</span></label>
    )}
    {item.event && <>, {item.event}</>}
    {item.type === 'publication' && (
      <> — <Byline shown={byline.shown} />{byline.etal && <>, et al</>}
        {(byline.etal || venueLine(item)) && '.'}
        {venueLine(item) && <> <Venue item={item} /></>}
      </>
    )}
    {/* Grants show their figure; awards keep theirs in the record only. */}
    {item.amount && item.type !== 'award' && (
      <> — {pick
        /* The builder's: the figure follows its Currency menu, so it carries each form. */
        ? <span class="amt" data-code={money(item.amount)} data-us={money(item.amount, 'us')}
                data-dollar={money(item.amount, 'dollar')}>{money(item.amount)}</span>
        : money(item.amount)}{item.declined && ' (declined)'}</>
    )}
    {item.declined && item.type === 'award' && <> (declined)</>}
    {item.kind === 'accepted' && <> (accepted, not attended)</>}
    {item.recipient && (
      <span class={`recipient${recipientInline ? ' recipient--inline' : ''}`}>
        <span class="recipient__text">To {item.recipient}</span>
        {pick && (
          <label class="inlineopt" title="Print on the title line">
            <input type="checkbox" class="inlinebox" data-id={item.id}
                   checked={!!recipientInline} data-default={item.recipientInline ? '' : undefined}
                   aria-label={`Put the recipient of ${item.title} on the title line`} /> same line
          </label>
        )}
      </span>
    )}
    {/* Last on the line, after the venue. The CV page does not group by
        status the way the PDF does, so without it a submitted paper is
        indistinguishable from a published one — but it qualifies the
        whole citation, not the title, so it reads at the end. */}
    {item.status && item.status !== 'published' && (
      <span class="statustag">{item.status}</span>
    )}
    {lines.map((line, i) => {
      const tier = lineTier(i, baseCount, detailCount);
      const cvs = tier === 'achievement' ? achievementCvs[i - detailCount] ?? [] : null;
      return (
      <span class="sub">
        {pick && (
          <input type="checkbox" class="subbox" data-id={item.id} data-line={i}
                 data-complete={tier === 'complete' ? '' : undefined}
                 data-cvs={cvs?.join(',')}
                 checked={{ base: level === 'full', complete: level === 'full' && completeLines,
                            achievement: achievementTicked(cvs, startPreset, completeLines) }[tier]}
                 aria-label={`Include this line under ${item.title}`} />
        )}
        <Inline spans={line} />
      </span>
      );
    })}
    {/* publications keep their trail in a gutter of its own, as on the
        publications page; everything else that is not in the date
        gutter sits under the text */}
    {item.type !== 'publication' && <LinkIcons links={bodyLinks} />}
  </span>
  {item.type === 'publication' && <LinkIcons links={bodyLinks} />}
</div>
