---
// One gap the CV builder can set: ‹ [value] › [× | pt]. The arrows step by
// 0.5 in multiples and by 1 in points; the field takes a typed value, held to
// the unit's limits; changing the unit converts the value, from `base`, the
// gap's own size in points (cv/lib/gaps.json), so it keeps its length.
//
// A change — by arrow, by typing, or by unit — fires one bubbling `change`
// from the root's field, after the value is settled, so a page listens for
// that alone, and reads and sets the value with readGap/writeGap
// (src/lib/gapin.js).
import { UNITS, DEFAULT_GAP } from '../lib/gapin.js';

const { key, label, base } = Astro.props;
---
<span class="gapin" data-key={key} data-base={base} role="group" aria-label={label}>
  <button type="button" class="gapin-step" data-dir="-1" aria-label={`Less: ${label}`}>‹</button>
  <input class="gapin-val" type="text" inputmode="decimal" size="4"
         value={DEFAULT_GAP.value} data-last={DEFAULT_GAP.value} aria-label={`${label}, value`} />
  <button type="button" class="gapin-step" data-dir="1" aria-label={`More: ${label}`}>›</button>
  <select class="gapin-unit" data-last={DEFAULT_GAP.unit} aria-label={`${label}, unit`}>
    {Object.keys(UNITS).map((u) => <option value={u} selected={u === DEFAULT_GAP.unit}>{u === 'x' ? '×' : u}</option>)}
  </select>
</span>

<script>
  import { clampGap, stepGap, convertGap, readGap, writeGap } from '../lib/gapin.js';

  // Capturing, so the value is settled before any page's own listener reads it.
  document.addEventListener('change', (e) => {
    const root = e.target.closest?.('.gapin');
    if (!root) return;
    const was = readGap(root);
    const unit = root.querySelector('.gapin-unit').value;
    if (e.target.classList.contains('gapin-unit')) {
      writeGap(root, { value: convertGap(was.value, was.unit, unit, Number(root.dataset.base)), unit });
    } else {
      writeGap(root, { value: clampGap(e.target.value, unit) ?? was.value, unit });
    }
  }, true);

  document.addEventListener('click', (e) => {
    const btn = e.target.closest?.('.gapin-step');
    if (!btn) return;
    const root = btn.closest('.gapin');
    const was = readGap(root);
    writeGap(root, { value: stepGap(was.value, was.unit, Number(btn.dataset.dir)), unit: was.unit });
    root.querySelector('.gapin-val').dispatchEvent(new Event('change', { bubbles: true }));
  });

  // Enter commits, as it would in a form.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && e.target.classList?.contains('gapin-val')) e.target.blur();
  });
</script>

<style>
  .gapin{display:inline-flex; align-items:center; gap:.15rem}
  .gapin-step, .gapin-val, .gapin-unit{
    font-family:var(--mono); font-size:.6rem; color:var(--ink-mute); background:var(--surface);
    border:1px solid var(--rule-strong); line-height:1.5; padding:.05rem .4rem;
  }
  .gapin-step{border-radius:999px; cursor:pointer; padding:.05rem .45rem}
  .gapin-step:hover{color:var(--accent); border-color:var(--accent-line); background:var(--accent-soft)}
  .gapin-val{width:3.8em; text-align:center; border-radius:4px; color:var(--ink)}
  .gapin-val:focus{outline:none; border-color:var(--accent-line)}
  .gapin-unit{border-radius:999px; cursor:pointer}
</style>
