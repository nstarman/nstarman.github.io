---
// The CV pages' heading row, and the condensed copy that joins the header once
// it scrolls away. Shared by /cv/<preset>/ and /tools/cv/, the builder, which
// keeps the heading and the condensed bar but none of the length links: it is
// a tool, reached from /tools/, not another length of the CV.
import { presetNames, preset } from '../lib/presets.js';

const { current, pdf = null } = Astro.props;
const href = (n) => (n === 'np' ? '/cv/' : `/cv/${n}/`);
const vars = `--stops:${presetNames.length};--i:${Math.max(0, presetNames.indexOf(current))}`;
const onBuilder = current === 'builder';
---
<div class="cvbar" aria-hidden="true">
  <div class="wrap">
    {pdf
      ? <a class="btn" href={pdf} tabindex="-1"><span class="dl">Download </span>PDF</a>
      : <span class="spacer"></span>}
    <span class="more">
      {onBuilder
        /* The builder has no lengths to jump to; the slot offers Save
           Selection instead. */
        ? <span class="cvtoggle cvtoggle--main">
            <button class="btn" type="button" id="savebar" tabindex="-1">Save Selection</button>
          </span>
        : <span class="cvtoggle cvtoggle--main" style={vars}>
            {presetNames.map((n) => (
              <a href={href(n)} class={n === current ? 'on' : ''} tabindex="-1">{preset(n).label}</a>
            ))}
          </span>}
    </span>
  </div>
</div>

{/* The builder is a tool, not a fourth length: it carries none of the length
    links, only its own heading. */}
{!onBuilder && (
  /* Phones only: opens the length toggle, which collapses behind the current
     length there, as the author-position filter does on /publications/. */
  <input type="checkbox" id="lenmore" class="posradio" aria-label="Show CV lengths" />
)}

<div class="h2row">
  <div class="ttlgroup">
    <h2>Curriculum Vitae</h2>
    {pdf && <a class="btn" href={pdf}><span class="dl">Download </span>PDF</a>}
  </div>
  {!onBuilder && (
    <span class="more">
      <label for="lenmore" class="lenmore" title="CV length">{preset(current).label}&nbsp;<span aria-hidden="true">▾</span></label>
      <span class="cvtoggle cvtoggle--main cvlengths" style={vars} role="group" aria-label="CV length">
        {presetNames.map((n) => (
          <a href={href(n)} class={n === current ? 'on' : ''}
             aria-current={n === current ? 'true' : undefined}>{preset(n).label}</a>
        ))}
      </span>
    </span>
  )}
</div>

<script>
  // The condensed bar joins the header once the real controls have scrolled
  // past, so the length toggle, the download and the builder stay reachable
  // without scrolling back up.
  const bar = document.querySelector('.cvbar');
  const controls = document.querySelector('.h2row');

  if (bar && controls) {
    const NAV = 52; // the sticky nav's height
    const syncBar = () => {
      const on = controls.getBoundingClientRect().bottom < NAV;
      bar.classList.toggle('is-on', on);
      bar.setAttribute('aria-hidden', on ? 'false' : 'true');
      for (const el of bar.querySelectorAll('a, button')) el.tabIndex = on ? 0 : -1;
    };
    syncBar();
    addEventListener('scroll', syncBar, { passive: true });
    addEventListener('resize', syncBar, { passive: true });
  }

  // Drag the thumb to a length. Without this the links still work: each stop
  // is a plain <a>, so a click navigates with no script at all. Dragging only
  // moves --i while the pointer is down, then clicks the link nearest to where
  // it was let go (which also runs the scroll-position hand-off in CvToc).
  for (const track of document.querySelectorAll('.cvtoggle--main:has(a)')) {
    const links = [...track.querySelectorAll('a')];
    let x0 = null, dragged = false;
    const at = (e) => {
      const r = track.getBoundingClientRect();
      return Math.min(links.length - 1, Math.max(0, ((e.clientX - r.left) / r.width) * links.length - 0.5));
    };
    track.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      x0 = e.clientX; dragged = false;
    });
    track.addEventListener('pointermove', (e) => {
      if (x0 === null) return;
      if (!dragged && Math.abs(e.clientX - x0) < 4) return;
      if (!dragged) { dragged = true; track.setPointerCapture(e.pointerId); track.classList.add('is-dragging'); }
      track.style.setProperty('--i', at(e));
    });
    const end = (e) => {
      if (x0 === null) return;
      x0 = null;
      track.classList.remove('is-dragging');
      if (!dragged) return;
      dragged = false;
      const to = links[Math.round(at(e))];
      if (to.classList.contains('on')) track.style.setProperty('--i', links.indexOf(to));
      else to.click();
    };
    track.addEventListener('pointerup', end);
    track.addEventListener('pointercancel', end);
    // Pointer capture sends the click that ends a drag to the track, not to a link.
  }
</script>
