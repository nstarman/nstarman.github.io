---
// /software/ is in areas — SOFTWARE_GROUPS, each with its introduction — and
// within an area, tiers: the lead package, the headliners as cards, then the
// rest and the utilities ever smaller. Area and tier both come from the data.
import { PRESET } from '../lib/cards.js';
import { byType, softwarePapers, SOFTWARE_GROUPS } from '../lib/data.js';
import { spans } from '../lib/inline.js';
import contributions from '/config/contributions.json';
import Card from './Card.astro';

// The landing page shows the lead and the headliners only, with no areas;
// the rest is what "All software →" is for.
const { tail = true } = Astro.props;

// The fourth tier: everything else he has a merged pull request in, which is
// far too many to render as cards and not his to present as his own. Generated
// by scripts/collect-contributions.mjs, refreshed monthly by a workflow.
const contributed = tail ? contributions.repos : [];
const year = (d) => d.slice(0, 4);

const all = byType('software');
const lead = all.find((s) => s.tier === 'flagship');
// Array.sort is stable, so equal `order` keeps byType's newest-first.
const headliners = (items) => items.filter((s) => s.tier === 'major')
  .sort((a, b) => (a.order ?? 0) - (b.order ?? 0));
const byTitle = (items, tier) => items.filter((s) => s.tier === tier)
  .sort((a, b) => a.title.localeCompare(b.title));
const groups = tail
  ? SOFTWARE_GROUPS
    .map(([key, label, intro]) => ({ key, label, intro, items: all.filter((s) => s.group === key) }))
    .filter((g) => g.items.length > 0)
  : [];
// If nothing in a grid or an area has a paper, the paper filter empties it —
// and a heading over nothing introduces nothing. Marked here rather than in
// CSS because it is a fact about the data, and it is recomputed every build.
const emptied = (items) => (!items.some((s) => softwarePapers(s).length) ? 'tier-nopaper' : undefined);
---
{!tail && (
  <>
    {lead && (
      <div class="lead">
        <Card item={lead} id={`sw-${lead.id}`} preset={PRESET.softwareFlagship} />
      </div>
    )}
    <div class:list={['soft', emptied(headliners(all))]}>
      {headliners(all).map((s) => <Card item={s} id={`sw-${s.id}`} preset={PRESET.softwareMajor} />)}
    </div>
  </>
)}

{/* Flat, every part a sibling of the filter's radios, so the paper filter is
    a plain sibling selector — see software.astro. */}
{groups.map((g) => (
  <>
    <h3 id={`sw-group-${g.key}`} class:list={['hl-topic', emptied(g.items)]}>{g.label}</h3>
    <p class:list={['hl-intro', 'sw-intro', emptied(g.items)]}>{spans(g.intro, '/cv/').map((s) => (s.url ? <a href={s.url}>{s.t}</a> : s.t))}</p>
    {g.items.includes(lead) && (
      <div class="lead">
        <Card item={lead} id={`sw-${lead.id}`} preset={PRESET.softwareFlagship} />
      </div>
    )}
    {/* One grid for the area, its tiers in order. Each card keeps its tier's
        size beside a larger one rather than stretching to it (soft--area). */}
    <div class:list={['soft', 'soft--area', emptied(g.items.filter((s) => s !== lead))]}>
      {headliners(g.items).map((s) => <Card item={s} id={`sw-${s.id}`} preset={PRESET.softwareMajor} />)}
      {byTitle(g.items, 'minor').map((s) => <Card item={s} id={`sw-${s.id}`} preset={PRESET.softwareMinor} />)}
      {/* Things worth having that are not research software: smaller cards
          again, because they are useful rather than notable. */}
      {byTitle(g.items, 'utility').map((s) => <Card item={s} id={`sw-${s.id}`} preset={PRESET.softwareUtility} />)}
    </div>
  </>
))}

{contributed.length > 0 && (
  <details class="contribs">
    <summary>
      <span class="contribs-lede">Other Open-Source Contributions</span>
      <span class="cvcount">{contributed.length}</span>
    </summary>
    <ul class="contriblist">
      {contributed.map((r) => (
        <li>
          <a href={r.url}>{r.repo}</a>
          <span class="contrib-since" title={`First pull request ${r.first}`}>{year(r.first)}</span>
          {r.description && <span class="contrib-desc">{r.description}</span>}
        </li>
      ))}
    </ul>
  </details>
)}
