---
// Where the people I have written with have worked, and when.
//
// Inline SVG on a committed Equal Earth outline — no tiles, so no third party
// sees a visitor's viewport, and the whole thing works offline. See issue #22.
//
// The list underneath is not a fallback: it is the same data in the form a
// screen reader, a keyboard, or a small phone can actually use, and it is where
// the paper titles live in full.
import '../styles/map.css';
import { collaboratorMap, lastFirst, map } from '../lib/collabmap.js';

const people = collaboratorMap();
const pins = people.flatMap((p) => p.pins.map((pin) => ({ ...pin, person: p })));
const trails = people.filter((p) => p.pins.length > 1);
// "2 papers together, 1 assist" — an assist is a paper of theirs that thanks me.
const plural = (n, w) => `${n} ${w}${n > 1 ? 's' : ''}`;
const together = (papers) => {
  const assists = papers.filter((p) => p.assist).length;
  const written = papers.length - assists;
  return [written && `${plural(written, 'paper')} together`, assists && plural(assists, 'assist')]
    .filter(Boolean).join(', ');
};
const label = (pin) =>
  [pin.organization, pin.place].filter(Boolean).join(' — ')
  + ` (${pin.start}${pin.end ? `–${pin.end}` : '–present'})`;
---

<figure class="cmap">
  <figcaption>
    <span class="cmap-key cmap-key--shared">
      <svg viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="4" /></svg>
      wrote or assisted on a paper together
    </span>
    <span class="cmap-key">
      <svg viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="4" /></svg>
      another post
    </span>
    <span class="cmap-key cmap-key--trail">
      <svg viewBox="0 0 24 12" aria-hidden="true"><line x1="1" y1="6" x2="23" y2="6" /></svg>
      one person over time
    </span>
    <a class="cmap-proj" href="https://en.wikipedia.org/wiki/Equal_Earth_projection">Equal Earth projection</a>
  </figcaption>

  <div class="cmap-stage">
  <svg viewBox={`0 0 ${map.width} ${map.height}`} role="img"
       aria-label={`World map: ${pins.length} posts held by ${people.length} collaborators, `
                 + `on an Equal Earth projection. The same information is listed below.`}>
    <path class="cmap-land" d={map.land} />
    {/* Drawn over the land in the ocean's colour rather than cut out of it:
        two paths and no fill-rule to get wrong. */}
    <path class="cmap-lakes" d={map.lakes} />

    {/* Trajectories first, so pins sit on top of their own lines. */}
    {trails.map((p) => (
      <polyline class="cmap-trail" data-c={people.indexOf(p)} style={`--h:${p.hue}`}
                points={p.pins.map((pin) => `${pin.x.toFixed(2)},${pin.y.toFixed(2)}`).join(' ')} />
    ))}

    {pins.map((pin) => (
      <g class="cmap-pin" data-c={people.indexOf(pin.person)} style={`--h:${pin.person.hue}`}>
        {/* A link to the person's record below, for a reader with no script to
            pick them with; the script's click handler takes over where there is
            one. Out of the tab order: the record's own heading is the link for
            the keyboard. */}
        <a href={`#collab-${people.indexOf(pin.person)}`} tabindex="-1">
          {/* <title> is the native tooltip and the accessible name at once. */}
          <title>{pin.person.name} — {label(pin)}{pin.papers.length ? `; ${together(pin.papers)}` : ''}</title>
          <circle cx={pin.x.toFixed(2)} cy={pin.y.toFixed(2)}
                  r={pin.papers.length ? 4.5 : 3} class={pin.papers.length ? 'is-shared' : ''} />
        </a>
      </g>
    ))}
  </svg>
  {/* Shown by mapzoom.js: with no script there is nothing for them to do. */}
  <div class="cmap-zoom" role="group" aria-label="Zoom the map" hidden>
    <button type="button" data-zoom="in" aria-label="Zoom in">+</button>
    <button type="button" data-zoom="out" aria-label="Zoom out" disabled>−</button>
    <button type="button" data-zoom="reset" aria-label="Show the whole world" disabled>⤢</button>
  </div>
  </div>

  <div class="cmap-pick">
    <label for="cmap-who" hidden>Show</label>
    <select id="cmap-who" class="cmap-who btn btn--sel" hidden>
      <option value="">Everyone</option>
      {people.map((p, i) => <option value={String(i)}>{lastFirst(p.name)}</option>)}
    </select>
    <span class="cmap-partial"
          title="Mostly scraped from public ORCID records: it shows what each person has chosen to publish there, so posts can be missing, undated, or out of date.">May be incomplete / wrong</span>
  </div>



  <ol class="cmap-list">
    {people.map((p) => (
      <li id={`collab-${people.indexOf(p)}`} data-orcid={p.orcid} data-c={people.indexOf(p)} style={`--h:${p.hue}`}>
        {/* Where the record came from, and the way to check it. */}
        <a class="cmap-orcid" href={`https://orcid.org/${p.orcid}`}
           aria-label={`${p.name} on ORCID`} title={`${p.name} on ORCID — ${p.orcid}`}>
          <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-orcid" /></svg>
        </a>
        <h3><a href={`#collab-${people.indexOf(p)}`}>{lastFirst(p.name)}</a></h3>
        <ol hidden>
          {p.pins.map((pin) => (
            <li>
              <div class="cmap-post">
              <span class="cmap-when">{pin.start}–{pin.end ?? 'present'}</span>
              <span class="cmap-where">{pin.organization}{pin.place && <>, {pin.place}</>}</span>
              {pin.role && <span class="cmap-role">{pin.role}</span>}
              </div>
              {pin.papers.length > 0 && (
                <ul class="cmap-papers">
                  {pin.papers.map((paper) => (
                    <li><span class="inline-card">{paper.url ? <a href={paper.url}>{paper.title}</a> : paper.title}{paper.doi && !paper.doi.startsWith('10.48550/') && <> <span class="cmap-sep" aria-hidden="true">·</span> <a class="cmap-doi" href={`https://doi.org/${paper.doi}`}>{paper.doi}</a></>}</span>{paper.assist && <span class="cmap-assist"> — assist</span>}</li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ol>
        {p.unplacedPapers.length > 0 && (
          <p class="cmap-note" hidden>
            Also {together(p.unplacedPapers)}, from when their ORCID record names no post.
          </p>
        )}
      </li>
    ))}
  </ol>
</figure>

<script>
  import { wireAll } from '../lib/mappick.js';
  import { wireZoom } from '../lib/mapzoom.js';
  wireAll();
  wireZoom();
</script>
