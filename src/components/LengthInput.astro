---
// A length, relative or absolute: ‹ [value] › [× | pt]. The arrows step by
// 0.5 in multiples and by 1 in points; the field takes a typed value, held to
// the unit's limits; changing the unit converts the value, from `base`, the
// size in points that × multiplies, so it keeps its length. `key` is the
// page's name for the value, carried as data-key for it to find.
//
// The CV builder uses it for every spacing it offers, with `base` from
// cv/lib/gaps.json.
//
// A change — by arrow, by typing, or by unit — fires one bubbling `change`
// from the root's field, after the value is settled, so a page listens for
// that alone, and reads and sets the value with readLength/writeLength
// (src/lib/lengthinput.js).
import { UNITS, DEFAULT_LENGTH } from '../lib/lengthinput.js';

const { key, label, base } = Astro.props;
---
<span class="lengthin" data-key={key} data-base={base} role="group" aria-label={label}>
  <button type="button" class="lengthin-step" data-dir="-1" aria-label={`Less: ${label}`}>‹</button>
  <input class="lengthin-val" type="text" inputmode="decimal" size="4"
         value={DEFAULT_LENGTH.value} data-last={DEFAULT_LENGTH.value} aria-label={`${label}, value`} />
  <button type="button" class="lengthin-step" data-dir="1" aria-label={`More: ${label}`}>›</button>
  <select class="lengthin-unit" data-last={DEFAULT_LENGTH.unit} aria-label={`${label}, unit`}>
    {Object.keys(UNITS).map((u) => <option value={u} selected={u === DEFAULT_LENGTH.unit}>{u === 'x' ? '×' : u}</option>)}
  </select>
</span>

<script>
  import { clampLength, stepLength, convertLength, readLength, writeLength } from '../lib/lengthinput.js';

  // Capturing, so the value is settled before any page's own listener reads it.
  document.addEventListener('change', (e) => {
    const root = e.target.closest?.('.lengthin');
    if (!root) return;
    const was = readLength(root);
    const unit = root.querySelector('.lengthin-unit').value;
    if (e.target.classList.contains('lengthin-unit')) {
      writeLength(root, { value: convertLength(was.value, was.unit, unit, Number(root.dataset.base)), unit });
    } else {
      writeLength(root, { value: clampLength(e.target.value, unit) ?? was.value, unit });
    }
  }, true);

  document.addEventListener('click', (e) => {
    const btn = e.target.closest?.('.lengthin-step');
    if (!btn) return;
    const root = btn.closest('.lengthin');
    const was = readLength(root);
    writeLength(root, { value: stepLength(was.value, was.unit, Number(btn.dataset.dir)), unit: was.unit });
    root.querySelector('.lengthin-val').dispatchEvent(new Event('change', { bubbles: true }));
  });

  // Enter commits, as it would in a form.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && e.target.classList?.contains('lengthin-val')) e.target.blur();
  });
</script>

<style>
  .lengthin{display:inline-flex; align-items:center; gap:.15rem}
  .lengthin-step, .lengthin-val, .lengthin-unit{
    font-family:var(--mono); font-size:.6rem; color:var(--ink-mute); background:var(--surface);
    border:1px solid var(--rule-strong); line-height:1.5; padding:.05rem .4rem;
  }
  .lengthin-step{border-radius:999px; cursor:pointer; padding:.05rem .45rem}
  .lengthin-step:hover{color:var(--accent); border-color:var(--accent-line); background:var(--accent-soft)}
  .lengthin-val{width:3.8em; text-align:center; border-radius:4px; color:var(--ink)}
  .lengthin-val:focus{outline:none; border-color:var(--accent-line)}
  .lengthin-unit{border-radius:999px; cursor:pointer}
</style>
