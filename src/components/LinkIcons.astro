---
// The link trail, as marks rather than words. Every list of links on the site
// renders through here — publications, the CV, the software cards — so the
// glyph for a `rel` is decided once, in LinkIcon.
import LinkIcon from './LinkIcon.astro';

const { links = [] } = Astro.props;
---
{links.length > 0 && (
  <ul class="btns btns--icon">
    {links.map((l) => <LinkIcon link={l} />)}
  </ul>
)}
