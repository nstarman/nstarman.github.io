---
// The link trail, as marks rather than words. Every list of links on the site
// renders through here — publications, the CV, the software cards — so the
// glyph for a `rel` is decided once.
import { REL_ICON, relKey } from '../lib/data.js';

const { links = [] } = Astro.props;
---
{links.length > 0 && (
  <ul class="btns btns--icon">
    {links.map((l) => (
      <li>
        <a class="iconbtn" href={l.url} aria-label={l.label ?? l.rel} title={l.label ?? l.rel}>
          <svg class="ico" aria-hidden="true" focusable="false"><use href={`#i-${REL_ICON[relKey(l)] ?? 'link'}`} /></svg>
        </a>
      </li>
    ))}
  </ul>
)}
