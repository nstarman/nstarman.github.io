---
// /tools/embed/ — pick an item, then its card: one of the website's presets or
// any size, layout, title, text, extras, links and look. The preview is the live embed; the
// snippet is an iframe, HTML or Markdown for an image, or the PNG or PDF
// itself, drawn here in the browser from the preview — nothing is pre-rendered.
import fs from 'node:fs';
import Base from '../../layouts/Base.astro';
import { items, relKey, splitTitle } from '../../lib/data.js';
import {
  LOOKS, DIALS, FIGURE_AT, FIGURE_ALIGN, FIGURE_SLOTS, FOOT_AT, FOOT_END, RAIL_ALIGN, FIXED_MIN_HEIGHT, TEXTS, TITLES, AUTHORS, AUTHORS_MAX, BACKGROUNDS, SITE_PRESETS, BUILDER_DEFAULT, CARD_TYPES, FIXED_MIN, FIXED_MAX, hasFigure, hasPosition, hasRole, hasVenue, hasStatus, hasContext, cardLinks, cardText, embedHref, ownLink, siteHref, adsHref, journalHref,
} from '../../lib/cards.js';

const pool = items.filter((i) => CARD_TYPES.includes(i.type));
// The steps in px, as global.css has them, for the settings that can be typed
// in px — the text and title sizes, padding (the top's; the sides are a
// little wider), corners and buttons: their rows' stops are labelled with these, not the steps' names,
// which say nothing about a size. With the range a typed size may take.
const STEP_PX = {
  textsize: { minor: 11.5, compact: 12.5, standard: 14, feature: 16, display: 18.4, min: 8, max: 40, what: 'The text size, in pixels' },
  titlesize: { minor: 12.4, compact: 13.5, standard: 15.2, feature: 17.3, display: 19.9, min: 8, max: 60, what: 'The title size, in pixels' },
  padding: { minor: 8, compact: 11, standard: 15, feature: 19, display: 24, min: 0, max: 64, what: 'The padding, in pixels, the same on every side' },
  corners: { minor: 10, compact: 12, standard: 16, feature: 18, display: 22, min: 0, max: 64, what: 'The corner radius, in pixels' },
  buttons: { minor: 21, compact: 23, standard: 26, feature: 30, display: 35, min: 12, max: 64, what: 'The link buttons, in pixels; the icon is half' },
};
const groups = [
  ['publication', 'Publications'],
  ['highlight', 'Syntheses'],
  ['software', 'Software'],
].map(([type, label]) => ({ label, items: pool.filter((i) => i.type === type) }))
  .filter((g) => g.items.length > 0);
// Opens on the latest submitted paper — the one most likely to be shown off.
// Items come newest first.
const pubs = pool.filter((i) => i.type === 'publication');
const start = (pubs.find((i) => i.status === 'submitted') ?? pubs[0] ?? pool[0]).id;

// The link keys a card can be cut to, each named in the builder: code, a
// preprint or data by where it goes — GitHub, arXiv, Zenodo — and ADS; a
// paper, the docs and the rest by what they are, wherever they are hosted. A
// key's links share its pill, so one that covers two places names both. The
// card's name, though, keeps the key.
const PLACES = { 'arxiv.org': 'arXiv', 'github.com': 'GitHub', 'zenodo.org': 'Zenodo', 'pypi.org': 'PyPI', 'openreview.net': 'OpenReview', 'ui.adsabs.harvard.edu': 'ADS' };
const BY_PLACE = ['code', 'repo', 'preprint', 'data', 'doi'];
const placeOf = (l) => {
  if (relKey(l) === 'ads') return 'ADS';
  if (!BY_PLACE.includes(l.rel)) return l.rel;
  const url = new URL(l.url, 'https://nstarkman.space');
  if (/zenodo/.test(url.pathname)) return 'Zenodo';
  return PLACES[url.host.replace(/^www\./, '')] ?? (l.rel === 'doi' ? 'DOI' : l.rel);
};
const linkChoices = (i) => {
  const byKey = new Map();
  for (const l of cardLinks(i)) {
    const k = relKey(l);
    const o = byKey.get(k) ?? { names: new Set(), titles: new Set() };
    o.names.add(placeOf(l));
    o.titles.add(l.label ?? l.rel);
    byKey.set(k, o);
  }
  return [...byKey].map(([k, o]) => [k, [...o.names].join(' · '), [...o.titles].join(', ')]);
};
const data = {
  site: Astro.site.href.replace(/\/$/, ''),
  fixedMin: FIXED_MIN,
  fixedMax: FIXED_MAX,
  stepPx: STEP_PX,
  fixedMinHeight: FIXED_MIN_HEIGHT,
  // The faces a card is set in, for Typst to draw its PDF with.
  fonts: fs.readdirSync('public/fonts/card').filter((f) => f.endsWith('.otf')).sort().map((f) => `/fonts/card/${f}`),
  // The builder's own default first, then the website's cards.
  presets: [{ slug: BUILDER_DEFAULT, where: 'default' }, ...SITE_PRESETS],
  items: Object.fromEntries(pool.map((i) => [i.id, {
    title: i.title, href: embedHref(i), figure: hasFigure(i), pos: hasPosition(i), role: hasRole(i), venue: hasVenue(i), status: hasStatus(i) ? i.status : null, context: hasContext(i), split: !!splitTitle(i), byline: i.type === 'publication', text: !!(cardText(i).summary || cardText(i).details), links: linkChoices(i), link: ownLink(i) ? placeOf(ownLink(i)) : null, site: siteHref(i)?.replace(/#.*/, '') ?? null, ads: adsHref(i) ? 'ADS' : null, journal: journalHref(i) ? 'journal' : null, linkIs: ['ads', 'journal'].find((l) => ownLink(i)?.url && ownLink(i).url === (l === 'ads' ? adsHref(i) : journalHref(i))) ?? null,
  }])),
};
---
<Base title="Card Builder — Nathaniel Starkman" description="Export a card from nstarkman.space as an iframe or an image.">
  <main>
    <section>
      <div class="wrap">
        <div class="h2row"><h2>Card Builder</h2></div>
        <p class="lede">Any card on this site, for another page: as an <code>&lt;iframe&gt;</code> that stays
          current, as a PNG for places that strip iframes, such as a GitHub README, or as a PDF. Every card has a
          name — size, layout, what it shows, then its look — and the website’s own are the presets. Every item is
          listed in <a href="/embed/index.json">/embed/index.json</a>.</p>

        {/* One form round the controls, the preview and the snippet, so the
            format toggle beside the snippet is part of it too. */}
        {/* autocomplete off: the browser would otherwise put back, on a reload,
            whatever was last typed or ticked, over the item's own card. */}
        <form id="eb" novalidate autocomplete="off">
        <div class="eb">
          <div class="eb-row">
            <label class="eb-key" for="eb-card">Item</label>
            <select name="card" id="eb-card">
              {groups.map((g) => (
                <optgroup label={g.label}>
                  {g.items.map((i) => <option value={i.id} selected={i.id === start}>{i.title}</option>)}
                </optgroup>
              ))}
            </select>
            {/* The website's own cards, to check a setting against — never a
                place to start, so as small as a control can be. It says which
                one the controls make, or custom. */}
            <select name="preset" class="eb-preset" aria-label="The website's card these settings make">
              <option value={BUILDER_DEFAULT}>default</option>
              <option value="">custom</option>
              {SITE_PRESETS.map((p) => <option value={p.slug}>{p.where}</option>)}
            </select>
          </div>

          {/* The size, each dimension on its own: the width fills the card's
              container — the preview's stage, which can then be dragged — or
              is set; the height fits its content or is set, so cards side by
              side can share one. A set value opens out of its pill when it is
              clicked and folds back into it, as "640px", once one is chosen. */}
          <div class="eb-row">
            <fieldset class="eb-group">
              <legend class="eb-key">Size</legend>
              <span class="eb-dim">width</span>
              <span class="pilltoggle">
                <label title="Fills its container"><input type="radio" class="posradio" name="wmode" value="fill" />fill</label>
                <label class="eb-setpx" title="A set width — click to set it"><input type="radio" class="posradio" name="wmode" value="px" aria-controls="eb-px" /><span id="eb-w-shown">set</span></label>
              </span>
              <span class="eb-dim">height</span>
              <span class="pilltoggle">
                <label title="Grows with its content"><input type="radio" class="posradio" name="hmode" value="fit" />fit</label>
                <label class="eb-setpx" title="A set height — click to set it"><input type="radio" class="posradio" name="hmode" value="px" aria-controls="eb-px" /><span id="eb-h-shown">set</span></label>
              </span>
              {/* What is set, typed; a few widths, which keep the shape where
                  the height is set too; and, both set, a few shapes, which set
                  the height from the width. Only the numbers are kept. */}
              <span class="eb-px" id="eb-px" role="group" aria-label="Width and height" hidden>
                <span class="sep" aria-hidden="true">|</span>
                <label id="eb-px-w" title="The width, in pixels"><input type="number" name="px" min={FIXED_MIN} max={FIXED_MAX} step="1" value="320" aria-label="Width in pixels" />px wide</label>
                <span class="pilltoggle" id="eb-widths" role="radiogroup" aria-label="Preset widths"></span>
                <label id="eb-px-h" title="The height, in pixels"><input type="number" name="hpx" min={FIXED_MIN_HEIGHT} max={FIXED_MAX} step="1" value="400" aria-label="Height in pixels" />px high</label>
                <span class="pilltoggle" id="eb-shapes" role="radiogroup" aria-label="Shape">
                  {['4x5', '1x1', '8x5', '4x1'].map((a) => <label title={`${a.replace('x', ' wide by ')} high`}><input type="radio" class="posradio" name="shape" value={a} />{a.replace('x', ':')}</label>)}
                </span>
              </span>
            </fieldset>
          </div>

          {/* What the card shows, on one row of pills: each shown or not by
              its tick box — title:none, authors:none, text:none when not.
              Which title, byline or text is chosen under the preview, with the
              rest of what tunes the card: ticking the pill, or clicking that
              part in the preview, brings it up. */}
          <div class="eb-row">
            <fieldset class="eb-group">
              <legend class="eb-key eb-key--check">
                <label class="eb-keylabel"><input type="checkbox" class="eb-check" id="eb-title-on" checked />Title</label>
              </legend>
            </fieldset>
            <fieldset class="eb-group" id="eb-authors">
              <legend class="eb-key eb-key--check eb-key--inline">
                <label class="eb-keylabel"><input type="checkbox" class="eb-check" id="eb-authors-on" checked />Authors</label>
              </legend>
            </fieldset>
            {/* Where and when a paper appeared — the venue extra, which reads with
                its byline. */}
            <span class="eb-group" id="eb-venue">
              <label class="eb-key eb-key--check eb-key--inline" title="Where and when it appeared: the journal, or the arXiv number, and the year"><input type="checkbox" class="eb-check" name="extra" value="venue" />Published</label>
            </span>
            <fieldset class="eb-group" id="eb-text">
              <legend class="eb-key eb-key--check eb-key--inline">
                <label class="eb-keylabel"><input type="checkbox" class="eb-check" id="eb-text-on" checked />Text</label>
              </legend>
            </fieldset>
            {/* The figure: shown or not — figure:none when not. Its size is
                chosen under the preview. */}
            <span class="eb-group" id="eb-figure">
              <label class="eb-key eb-key--check eb-key--inline" title="The highlight figure"><input type="checkbox" class="eb-check" id="eb-figure-on" />Figure</label>
            </span>
            {/* The other extras — a package's role, a paper's context link —
                in a menu of tick boxes, filled per item, and gone where it
                has neither. Pilled when any is ticked. */}
            <details class="eb-group eb-drop" id="eb-extras-drop">
              <summary class="eb-key eb-key--check eb-key--inline" title="A package's role, a paper's context link">Extras <span aria-hidden="true">▾</span></summary>
              <span class="eb-drop-menu" id="eb-extras"></span>
            </details>
          </div>

          {/* The item's link buttons, each named by where it goes. */}
          <fieldset class="eb-row">
            <legend class="eb-key">Buttons</legend>
            <span class="pilltoggle" id="eb-links"></span>
          </fieldset>

          <fieldset class="eb-row">
            <legend class="eb-key">Theme</legend>
            <span class="pilltoggle">
              <label><input type="radio" class="posradio" name="theme" value="auto" checked />follow the reader</label>
              <label><input type="radio" class="posradio" name="theme" value="light" />light</label>
              <label><input type="radio" class="posradio" name="theme" value="dark" />dark</label>
            </span>
          </fieldset>
        </div>

        <div class="eb-h eb-head" id="eb-io-head">
          {/* The settings as JSON: everything here but the item, to keep or to
              load onto another one. */}
          <span class="eb-io">
            <span class="eb-io-key">Settings</span>
            <button type="button" class="btn" id="eb-export" title="Save these settings as JSON">Save</button>
            <button type="button" class="btn" id="eb-import" title="Load settings saved as JSON onto this item">Load</button>
            <input type="file" id="eb-import-file" accept="application/json,.json" hidden />
          </span>
        </div>
        <div class="eb-preview" id="eb-preview" aria-live="polite"></div>
        {/* The card's parts are outlined in the preview; clicking one brings up
            what tunes it. Show all is the way in without a pointer. */}
        <p class="eb-tune-hint">Click a part of the card to tune it, or <button type="button" class="eb-linkbtn" id="eb-tune-all">show all</button>.</p>
        <div class="eb eb-dials">
          {/* The areas: fixed — the top, the left side, the center, the right
              side and the bottom — the parts moving between them. First of
              the rows, one for each area that has settings and something in
              it: a side's width — fitting what is in it, at least so many px,
              a share of the card, or as wide as its buttons; and for the top
              and bottom areas, the sides that run beside them, taking their
              corners — left, the area runs over them. */}
          {['left', 'right'].map((side) => (
            <fieldset class="eb-row" id={`eb-area-${side}-row`} data-tune={`area-${side}`} hidden>
              <legend class="eb-key">Area<small>({side === 'left' ? 'Left' : 'Right'})</small></legend>
              <span class="eb-sub">
                <span class="eb-dim">width</span>
                <span class="eb-px">
                  <span class="pilltoggle" role="radiogroup" aria-label={`The ${side} side's width`}>
                    <label title="As wide as what is in it"><input type="radio" class="posradio" name={`w${side}`} value="" checked />fit</label>
                    <label title="At least so many px, growing to fit what is in it"><input type="radio" class="posradio" name={`w${side}`} value="min" />min</label>
                    <label title="A share of the card's width"><input type="radio" class="posradio" name={`w${side}`} value="share" />share</label>
                    <label id={`eb-w-${side}-buttons`} title="As wide as its buttons, laid out so many to a row"><input type="radio" class="posradio" name={`w${side}`} value="buttons" />buttons</label>
                  </span>
                  <label id={`eb-w-${side}-n`}><input type="number" name={`w${side}n`} min="0" max="800" step="1" placeholder="–" aria-label={`The ${side} side's width`} /><span id={`eb-w-${side}-unit`}>px</span></label>
                </span>
              </span>
            </fieldset>
          ))}
          {['top', 'bottom'].map((end) => (
            <fieldset class="eb-row" id={`eb-area-${end}-row`} data-tune={`area-${end}`} hidden>
              <legend class="eb-key">Area<small>({end === 'top' ? 'Top' : 'Bottom'})</small></legend>
              <span class="eb-sub">
                <span class="eb-dim">beside it</span>
                <span class="pilltoggle eb-checks" role="group" aria-label={`The sides that run beside the ${end} area, taking its corners`}>
                  {['left', 'right'].map((side) => <label id={`eb-win-${side}-${end}`} title={`The ${side} side runs ${end === 'top' ? 'up' : 'down'} beside the ${end} area, taking its corner`}><input type="checkbox" class="eb-check" name={`win${side}`} value={end} />{side === 'left' ? 'LHS' : 'RHS'}</label>)}
                </span>
              </span>
            </fieldset>
          ))}

          {/* Which title: whole | split sits right after full, the title it
              weights, and is shown for a full title whose short title is part
              of it. none is the tick box's above, so its radio is never shown. */}
          <fieldset class="eb-row" id="eb-title-row" data-tune="title" hidden>
            <legend class="eb-key">Title</legend>
            <span class="eb-sub">
              {/* Its area, first: the top area, across the card above the
                  figure, the words and the rails — empty, it takes no room —
                  or the center, the words' own column. */}
              <span class="eb-dim">area</span>
              <span class="pilltoggle" role="radiogroup" aria-label="The area the title sits in">
                <label title="In the words' own column"><input type="radio" class="posradio" name="titleat" value="center" checked />center</label>
                <label title="Across the card, above the figure, the words and the rails"><input type="radio" class="posradio" name="titleat" value="top" />top</label>
              </span>
              {/* Then its position across that area. */}
              <span class="eb-dim">position</span>
              <span class="eb-pair">
                <span class="pubfilter pubfilter--inline eb-sizes" data-stops="3" role="radiogroup" aria-label="The title at the left, center or right of its area">
                  {RAIL_ALIGN.map((v) => <label><input type="radio" class="posradio" name="titlealign" value={v} checked={v === 'left'} />{v}</label>)}
                </span>
              </span>
              <span class="eb-dim">length</span>
              <span class="eb-titles">
                <span class="pilltoggle">
                  <label><input type="radio" class="posradio" name="title" value="full" />full</label>
                </span>
                <span class="pubfilter pubfilter--inline eb-rest" id="eb-rest" data-stops="2" role="radiogroup" aria-label="Weight of the rest of the full title">
                  <label title="The whole title at the title's weight"><input type="radio" class="posradio" name="rest" value="whole" />whole</label>
                  <label title="Only the short title at the title's weight, the rest regular"><input type="radio" class="posradio" name="rest" value="split" checked />split</label>
                </span>
                <span class="pilltoggle">
                  {TITLES.filter((v) => v !== 'full').map((v) => <label hidden={v === 'none'}><input type="radio" class="posradio" name="title" value={v} />{v}</label>)}
                </span>
              </span>
              {/* Where the title links: nowhere, to the item itself — named by
                  where that is — or to its entry on this site. */}
              <span class="eb-dim">link</span>
              <span class="pilltoggle" role="radiogroup" aria-label="Where the title links">
                <label title="The title as words"><input type="radio" class="posradio" name="titlelink" value="" checked />none</label>
                <label id="eb-tl-link" title="The title a link to the item itself"><input type="radio" class="posradio" name="titlelink" value="link" /><span></span></label>
                <label id="eb-tl-ads" title="The title a link to its ADS abstract"><input type="radio" class="posradio" name="titlelink" value="ads" /><span></span></label>
                <label id="eb-tl-journal" title="The title a link to where it was published: the journal's own page"><input type="radio" class="posradio" name="titlelink" value="journal" /><span></span></label>
                <label id="eb-tl-site" title="The title a link to its entry on this site"><input type="radio" class="posradio" name="titlelink" value="site" /><span></span></label>
              </span>
              <span class="eb-dim">weight</span>
              <span class="pilltoggle" role="radiogroup" aria-label="The title's weight">
                <label title="Medium, or regular where I am past second author"><input type="radio" class="posradio" name="titleweight" value="" checked />auto</label>
                {['regular', 'medium', 'bold'].map((v) => <label><input type="radio" class="posradio" name="titleweight" value={v} />{v}</label>)}
                <label title="Bold where I am first author, regular otherwise"><input type="radio" class="posradio" name="titleweight" value="mine" />mine</label>
              </span>
              {/* Its size: a step, a size typed, or — the default — following
                  the text size. */}
              <span class="eb-dim">size</span>
              <span class="eb-px">
                <label title={STEP_PX.titlesize.what}><input type="number" name="titlesizepx" min={STEP_PX.titlesize.min} max={STEP_PX.titlesize.max} step="0.1" aria-label="Title size in pixels" />px</label>
                <span class="pubfilter pubfilter--inline eb-sizes" data-stops={LOOKS.length + 1} role="radiogroup" aria-label="Title size">
                  {LOOKS.map((v) => <label title={`${v}: ${STEP_PX.titlesize[v]}px`}><input type="radio" class="posradio" name="titlesize" value={v} />{STEP_PX.titlesize[v]}</label>)}
                  <label title="Follows the text size"><input type="radio" class="posradio" name="titlesize" value="text" checked />by text</label>
                </span>
              </span>
            </span>
          </fieldset>

          {/* Which byline: short or full — or, in its place, my author
              position beside the year. Never both, so position is one of the
              choices. none is the tick box's above. Then, for a byline, my
              students marked or plain. */}
          <fieldset class="eb-row" id="eb-authors-row" data-tune="authors" hidden>
            <legend class="eb-key">Authors</legend>
            <span class="eb-sub">
              <span class="eb-dim">length</span>
              <span class="eb-pair">
                <span class="pilltoggle">
                  {AUTHORS.filter((v) => v !== 'position').map((v) => <label hidden={v === 'none'}><input type="radio" class="posradio" name="authors" value={v} />{v}</label>)}
                  {/* So many names: a choice like the others, its number typed. */}
                  <label class="eb-px" title={`So many names, 1–${AUTHORS_MAX}, keeping mine`}><input type="radio" class="posradio" name="authors" value="n" /><input type="number" name="authorsn" min="1" max={AUTHORS_MAX} step="1" placeholder="#" aria-label="Number of names" /></label>
                </span>
                {/* Set apart: in place of the byline, not a length of it. */}
                <span class="pilltoggle" id="eb-pos">
                  <label title="My author position, as 1st | 2026, in place of the byline"><input type="radio" class="posradio" name="authors" value="position" />position</label>
                </span>
              </span>
              <span class="eb-dim" id="eb-marks-key">students</span>
              <span class="pilltoggle" id="eb-marks" role="radiogroup" aria-label="Marking of my students">
                <label title="My students set like any other co-author"><input type="radio" class="posradio" name="marks" value="plain" checked />plain</label>
                <label title="My students coloured, with † and ‡"><input type="radio" class="posradio" name="marks" value="marked" />marked</label>
              </span>
              {/* For a byline: each co-author a link — to their ORCID, or to the
                  papers we wrote together on the collaborator map — or not. */}
              <span class="eb-dim" id="eb-orcid-key">link</span>
              <span class="pilltoggle" id="eb-orcid" role="radiogroup" aria-label="Where each co-author links">
                <label title="The names as words"><input type="radio" class="posradio" name="authorlink" value="" checked />none</label>
                <label title="Each co-author a link to their ORCID, where they have one"><input type="radio" class="posradio" name="authorlink" value="orcid" />ORCID</label>
                <label title="Each co-author a link to the papers we wrote together, on the collaborator map at /research/, where they are on it"><input type="radio" class="posradio" name="authorlink" value="site" />our papers</label>
              </span>
              {/* For a position: in the rail, or a corner of the card. */}
              <span class="eb-dim" id="eb-corner-key">corner</span>
              <span class="eb-pair" id="eb-corner">
                <span class="pilltoggle" role="radiogroup" aria-label="Where my position sits">
                  <label title="In the rail, beside the buttons"><input type="radio" class="posradio" name="posx" value="" checked />rail</label>
                  <label title="The card's left corner"><input type="radio" class="posradio" name="posx" value="left" />left</label>
                  <label title="The card's right corner"><input type="radio" class="posradio" name="posx" value="right" />right</label>
                </span>
                <span class="pilltoggle" id="eb-posy" role="radiogroup" aria-label="The top or bottom corner">
                  <label><input type="radio" class="posradio" name="posy" value="top" />top</label>
                  <label><input type="radio" class="posradio" name="posy" value="bottom" checked />bottom</label>
                </span>
                {/* In a rail at a side, my position sits at the end the buttons
                    do not: swapping turns the rail over, top for bottom. An
                    action, not a setting. */}
                <span id="eb-swap"><button type="button" class="eb-linkbtn" title="Swap my position and the buttons, end for end in the rail">⇅ swap</button></span>
              </span>
            </span>
          </fieldset>

          {/* Which text: the record's summary or its details. none is the
              tick box's above. */}
          <fieldset class="eb-row" id="eb-text-row" data-tune="text" hidden>
            <legend class="eb-key">Text</legend>
            <span class="pilltoggle">
              {TEXTS.map((v) => <label hidden={v === 'none'}><input type="radio" class="posradio" name="text" value={v} />{v}</label>)}
            </span>
          </fieldset>

          {/* The figure: its area — the left side, the center or the right
              side — and its position there: at a side, where in the card's
              height and across its column; in the center, its slot among
              the parts; its size in
              its column — filling it (auto), a share of it, or its own px;
              and whether it is a link. Clicking the figure in the preview
              brings it up. */}
          <fieldset class="eb-row" id="eb-figure-row" data-tune="figure" hidden>
            <legend class="eb-key">Figure</legend>
            <span class="eb-sub">
              {/* The area it sits in, then — in a side — where in that area. */}
              <span class="eb-dim">area</span>
              <span class="pilltoggle" role="radiogroup" aria-label="The area the figure sits in">
                {FIGURE_AT.map((v) => <label title={{ left: 'In the left side', center: 'In the center, among the words', right: 'In the right side' }[v]}><input type="radio" class="posradio" name="figat" value={v} checked={v === 'center'} />{{ left: 'LHS', center: 'center', right: 'RHS' }[v]}</label>)}
              </span>
              <span class="eb-dim">position</span>
              <span class="eb-pair">
                {/* In the center, which of its slots: among its parts. */}
                <span class="pubfilter pubfilter--inline eb-sizes" data-stops="5" id="eb-figslot" role="radiogroup" aria-label="Where among the center's parts the figure sits">
                  {FIGURE_SLOTS.map((v) => [v, v === 'top' ? 'above title' : `below ${v}`]).map(([v, name]) => <label><input type="radio" class="posradio" name="figslot" value={v} checked={v === 'title'} />{name}</label>)}
                </span>
                <span class="pubfilter pubfilter--inline eb-sizes" data-stops="3" id="eb-figv" role="radiogroup" aria-label="Figure at the top, center or bottom of its area">
                  {FIGURE_ALIGN.map((v) => <label><input type="radio" class="posradio" name="figv" value={v} checked={v === 'center'} />{v}</label>)}
                </span>
                <span class="pubfilter pubfilter--inline eb-sizes" data-stops="3" id="eb-figh" role="radiogroup" aria-label="Figure at the left, center or right of its area">
                  {['left', 'center', 'right'].map((v) => <label title={`At the ${v} of its column, where narrower than it`}><input type="radio" class="posradio" name="figh" value={v} checked={v === 'center'} />{v}</label>)}
                </span>
              </span>
              <span class="eb-dim">size</span>
              <span class="eb-px">
                <label title="The figure's width: a share of its column, or its own px; empty fills the column"><input type="number" name="figpx" min="8" max="800" step="1" placeholder="auto" aria-label="Figure width" /></label>
                <span class="pilltoggle" role="radiogroup" aria-label="The figure's width, as">
                  <label title="A share of its column"><input type="radio" class="posradio" name="figunit" value="%" checked />%</label>
                  <label title="Its own width in px"><input type="radio" class="posradio" name="figunit" value="px" />px</label>
                </span>
                <span class="pilltoggle" role="radiogroup" aria-label="Figure size">
                  {['auto', 25, 33, 50, 75, 100].map((v) => <label><input type="radio" class="posradio" name="figp" value={v} />{v}</label>)}
                </span>
              </span>
              <span class="eb-dim">link</span>
              <span class="pilltoggle eb-checks">
                <label title="The figure a link to the item"><input type="checkbox" class="eb-check" name="figlink" />link</label>
              </span>
              {/* The white around the figure: as it is, none, a step, or px. */}
              <span class="eb-dim">frame</span>
              <span class="eb-px">
                <label title="The white around the figure, in pixels"><input type="number" name="framepx" min="0" max="32" step="1" placeholder="auto" aria-label="Figure frame in pixels" />px</label>
                <span class="pilltoggle" role="radiogroup" aria-label="Figure frame">
                  <label title="As it is"><input type="radio" class="posradio" name="frame" value="" checked />auto</label>
                  <label title="The bare image"><input type="radio" class="posradio" name="frame" value="none" />none</label>
                  {LOOKS.map((v) => <label title={v}><input type="radio" class="posradio" name="frame" value={v} />{{ minor: 3, compact: 4, standard: 4.8, feature: 8, display: 12 }[v]}</label>)}
                </span>
              </span>
            </span>
          </fieldset>

          {/* Space between two of the card's slots: added with the ⊕ that
              shows between two parts in the preview, each then px or flex —
              what room is left, pushing the two apart. */}
          <fieldset class="eb-row" data-tune="space" hidden>
            <legend class="eb-key">Space</legend>
            <span class="eb-sub">
              <span class="eb-dim">between</span>
              <span class="eb-tracks" id="eb-tracks"></span>
            </span>
          </fieldset>

          {/* The buttons — with the year and context, the rail — and the area
              they sit in: the left side, under the words, the right side, or
              the bottom; where in it; and how they are laid out, so many to a
              row. Clicking any of them in the preview brings it up. */}
          <fieldset class="eb-row" data-tune="foot" hidden>
            <legend class="eb-key">Buttons</legend>
            <span class="eb-sub">
              {/* The area they sit in: a side, under the words, or the bottom.
                  Then where in it. */}
              <span class="eb-dim">area</span>
              <span class="pilltoggle" role="radiogroup" aria-label="The area the buttons sit in">
                {FOOT_AT.map((v) => <label title={{ left: 'In the left side, under its figure', center: 'Under the words', right: 'In the right side, under its figure', bottom: 'In the bottom area, the full width' }[v]}><input type="radio" class="posradio" name="foot" value={v} />{{ left: 'LHS', center: 'center', right: 'RHS', bottom: 'bottom' }[v]}</label>)}
              </span>
              <span class="eb-dim">position</span>
              <span class="eb-pair">
                <span class="pubfilter pubfilter--inline eb-sizes" data-stops="3" role="radiogroup" aria-label="Up and down: in a side, the buttons at its top, center or bottom; under the words or at the bottom, the year at the top, center or bottom of the buttons">
                  {FOOT_END.map((v) => <label><input type="radio" class="posradio" name="footend" value={v} checked={v === 'top'} />{v}</label>)}
                </span>
                <span class="pubfilter pubfilter--inline eb-sizes" data-stops="3" role="radiogroup" aria-label="The buttons at the left, center or right of their area">
                  {RAIL_ALIGN.map((v) => <label><input type="radio" class="posradio" name="railalign" value={v} checked={v === 'left'} />{v}</label>)}
                </span>
              </span>
              <span class="eb-dim">layout</span>
              <span class="eb-px">
                <label title="The link buttons to a row before the next"><input type="number" name="perrow" min="1" max="12" step="1" placeholder="√n" aria-label="Link buttons per row" />per row</label>
                <span class="pilltoggle" role="radiogroup" aria-label="Link buttons to a row">
                  <label title="As near square as they go: ⌈√n⌉ to a row"><input type="radio" class="posradio" name="perp" value="square" checked />square</label>
                  <label title="As many to a row as fit"><input type="radio" class="posradio" name="perp" value="fit" />fit</label>
                </span>
              </span>
              {/* Their size: a step, a size typed, or on a fixed box the box's. */}
              <span class="eb-dim">size</span>
              <span class="eb-px">
                <label title={STEP_PX.buttons.what}><input type="number" name="buttonspx" min={STEP_PX.buttons.min} max={STEP_PX.buttons.max} step="1" aria-label="Button size in pixels" />px</label>
                <span class="pubfilter pubfilter--inline eb-sizes eb-dial" data-stops={LOOKS.length + 1} role="radiogroup" aria-label="Button size">
                  {LOOKS.map((v) => <label title={`${v}: ${STEP_PX.buttons[v]}px`}><input type="radio" class="posradio" name="buttons" value={v} />{STEP_PX.buttons[v]}</label>)}
                  <label class="eb-bywidth" title="Follows the box's width"><input type="radio" class="posradio" name="buttons" value="width" />by width</label>
                </span>
              </span>
              <span class="eb-dim">gap</span>
              <span class="eb-px">
                <label title="The space between the buttons, in pixels; empty is a third of the text's height"><input type="number" name="bgap" min="0" max="32" step="1" placeholder="auto" aria-label="Space between buttons, in pixels" />px</label>
              </span>
              {/* The context link: in the rail, or floating in a corner. */}
              <span class="eb-dim" id="eb-ctx-key">context</span>
              <span class="eb-pair" id="eb-ctx">
                <span class="pilltoggle" role="radiogroup" aria-label="Where the context link sits">
                  <label title="In the rail"><input type="radio" class="posradio" name="ctxx" value="" checked />rail</label>
                  <label title="Floating in the card's left corner"><input type="radio" class="posradio" name="ctxx" value="left" />left</label>
                  <label title="Floating in the card's right corner"><input type="radio" class="posradio" name="ctxx" value="right" />right</label>
                </span>
                <span class="pilltoggle" id="eb-ctxy" role="radiogroup" aria-label="The top or bottom corner">
                  <label><input type="radio" class="posradio" name="ctxy" value="top" />top</label>
                  <label><input type="radio" class="posradio" name="ctxy" value="bottom" checked />bottom</label>
                </span>
              </span>
            </span>
          </fieldset>

          {/* The look, under the card it draws: the text size, then the
              card's tint — a scale: none, the lighter tint /publications/
              uses, the site's, and twice it — then padding and corners, each
              set on its own. On a fixed box each may instead follow the box's
              width — the last stop. The buttons' size is in the Buttons row. */}
          {DIALS.map((d) => (<>
            {d === 'padding' && (
              <fieldset class="eb-row" data-tune="background" hidden>
                <legend class="eb-key">Background</legend>
                <span class="pubfilter pubfilter--inline eb-sizes" data-stops={BACKGROUNDS.length} role="radiogroup" aria-label="Background">
                  {BACKGROUNDS.map((v) => <label><input type="radio" class="posradio" name="background" value={v} checked={v === 'normal'} />{v}</label>)}
                </span>
              </fieldset>
            )}
            {d !== 'buttons' && <fieldset class="eb-row" data-tune={d} hidden>
              <legend class="eb-key">{{ textsize: 'Text size' }[d] ?? d[0].toUpperCase() + d.slice(1)}</legend>
              {/* Text size, padding and corners may be any size typed, as a fixed
                  box's width may: the box shows the step's in px, and typing
                  leaves the steps. */}
              {STEP_PX[d] && (
                <span class="eb-px">
                  <label title={STEP_PX[d].what}><input type="number" name={`${d}px`} min={STEP_PX[d].min} max={STEP_PX[d].max} step={d === 'textsize' ? '0.1' : '1'} aria-label={`${d} in pixels`} />px</label>
                </span>
              )}
              <span class="pubfilter pubfilter--inline eb-sizes eb-dial" data-stops={LOOKS.length + 1} role="radiogroup" aria-label={d}>
                {LOOKS.map((v) => <label title={STEP_PX[d] ? `${v}: ${STEP_PX[d][v]}px` : undefined}><input type="radio" class="posradio" name={d} value={v} />{STEP_PX[d] ? STEP_PX[d][v] : v}</label>)}
                <label class="eb-bywidth" title="Follows the box's width"><input type="radio" class="posradio" name={d} value="width" />by width</label>
              </span>
            </fieldset>}
          </>))}
        </div>

        {/* The format changes only the snippet, never the preview — which is
            always the live card — so it sits here, as a row of pills. */}
        <div class="eb-h eb-head">
          <h3>Use</h3>
          <span class="pilltoggle" role="radiogroup" aria-label="Format">
            <label title="An iframe that stays current"><input type="radio" class="posradio" name="format" value="iframe" checked />iframe</label>
            <label title="The PNGs, light and dark, for HTML"><input type="radio" class="posradio" name="format" value="html" />HTML</label>
            <label title="The PNG, for Markdown"><input type="radio" class="posradio" name="format" value="markdown" />Markdown</label>
            <label title="The PNGs themselves"><input type="radio" class="posradio" name="format" value="png" />PNG</label>
            <label title="The card as a PDF, drawn by Typst: its text selectable and its links live"><input type="radio" class="posradio" name="format" value="pdf" />PDF</label>
          </span>
        </div>
        <div class="eb-codebox">
          <textarea class="eb-code" id="eb-code" readonly rows="6" aria-label="Snippet to copy"></textarea>
          <span class="eb-tools">
            <button type="button" class="iconbtn" id="eb-copy" aria-label="Copy snippet" title="Copy snippet">
              <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-copy" /></svg>
            </button>
            {/* The PNGs and PDFs are drawn here, from the preview, when asked for. */}
            <button type="button" class="iconbtn" id="eb-download" hidden aria-label="Download PNG" title="Download PNG">
              <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-download" /></svg>
            </button>
          </span>
        </div>
        <p class="eb-note" id="eb-note"></p>
        {/* The card's name: what the snippet and the embed URL carry, and what
            a preset is called. Under the snippet, as what it is built from.
            Hidden until asked for — the controls above already say it — and
            then shown on the same line. A button, not <details>, so the name
            can sit beside it rather than below. */}
        <p class="eb-name">
          <button type="button" class="eb-fold" id="eb-name-toggle" aria-expanded="false" aria-controls="eb-slug">Name</button>
          <code id="eb-slug" hidden></code>
        </p>
        </form>
      </div>
    </section>
  </main>
</Base>

<script id="eb-data" type="application/json" set:html={JSON.stringify(data)} />

<script>
  import { domToPng } from 'modern-screenshot';
  import { AUTHORS_MAX, DIALS, SPACE_TRACKS, formatName, parseName } from '../../lib/cardname.js';

  const { site, fonts, fixedMin, fixedMax, fixedMinHeight, stepPx: STEP_PX, presets, items } = JSON.parse(document.getElementById('eb-data').textContent);
  const form = document.getElementById('eb');
  const el = (id) => document.getElementById(id);
  const preview = el('eb-preview');
  const code = el('eb-code');
  const note = el('eb-note');
  const extras = el('eb-extras');
  // The Extras menu closes on a click outside it, or Escape.
  const drop = el('eb-extras-drop');
  document.addEventListener('click', (e) => { if (drop.open && !drop.contains(e.target)) drop.open = false; });
  drop.addEventListener('keydown', (e) => { if (e.key === 'Escape' && drop.open) { drop.open = false; drop.querySelector('summary').focus(); } });
  const download = el('eb-download');
  const copy = el('eb-copy');
  const esc = (s) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');

  let height = 0; // the previewed card's height, as it last reported it
  let shown = ''; // the preview's src, so a snippet-only change leaves it alone

  // The role, status and context, where the item has them, and on a row of
  // their own a toggle per link it carries. The figure and the venue are on the row
  // above.
  function buildExtras(id) {
    const it = items[id];
    const x = (on, v, title) => (on ? `<label title="${title}"><input type="checkbox" class="eb-check" name="extra" value="${v}" />${v}</label>` : '');
    extras.innerHTML = x(it.role, 'role', 'My role in the package')
      + x(it.status, 'status', `Its status, ${it.status}, on the venue line`)
      + x(it.context, 'context', 'A link to its topic on /research/');
    el('eb-extras-drop').hidden = !extras.innerHTML;
    el('eb-links').innerHTML = it.links.map(([k, name, title]) => `<label title="${esc(title)}"><input type="checkbox" class="eb-check" name="link" value="${k}" checked />${esc(name)}</label>`).join('');
  }

  // A preset as it comes out for this item: the extras it has not got drop,
  // so an item with no figure still matches the default.
  const has = (it, x) => ({ figure: it.figure, venue: it.venue, status: it.status, role: it.role, context: it.context })[x];
  // The byline as this item can have it: none with no authors, and none for a
  // position it has not got.
  const authorsFor = (it, a) => (!it.byline || (a === 'position' && !it.pos) ? 'none' : a);
  // The title's link as this item can have it: none to a place it has not got.
  const linkFor = (it, l) => (l && it[l] ? l : false);
  function fit(name, it) {
    const c = parseName(name);
    // A list of buttons to keep, read against the links this item has.
    const keys = it.links.map(([k]) => k);
    const kept = c.links === 'all' ? keys : keys.filter((k) => c.links.includes(k));
    return formatName({ ...c, links: kept.length === keys.length ? 'all' : kept, extras: c.extras.filter((x) => has(it, x)), authors: authorsFor(it, c.authors), titleLink: linkFor(it, c.titleLink), figure: it.figure ? c.figure : 'none',
                        rest: it.split ? c.rest : 'split', text: it.text ? c.text : 'none' });
  }

  // Every item starts from the builder's default, following the reader's theme.
  function start() {
    apply(presets[0].slug);
    form.elements.theme.value = 'auto';
  }

  // A name → the controls. An extra the item has not got stays off.
  function apply(name) {
    let c;
    try { c = parseName(name); } catch { return; }
    form.elements.wmode.value = c.width === 'fill' ? 'fill' : 'px';
    form.elements.hmode.value = c.height === 'fit' ? 'fit' : 'px';
    if (c.width !== 'fill') form.elements.px.value = c.width;
    for (const d of DIALS) setDial(d, c.dials[d] ?? (c.width === 'fill' ? 'standard' : 'width'));
    setDial('titlesize', c.dials.titlesize ?? 'text');
    for (const d in STEP_PX) if (/^\d/.test(c.dials[d] ?? '')) form.elements[`${d}px`].value = c.dials[d]; // a size, on no step
    if (c.height !== 'fit') form.elements.hpx.value = c.height;
    el('eb-figure-on').checked = c.figure !== 'none';
    if (c.figure !== 'none') form.elements.figat.value = c.figure;
    form.elements.figv.value = c.figureAlign ?? 'center';
    form.elements.figpx.value = c.figureSize === 'auto' ? '' : parseInt(c.figureSize, 10);
    form.elements.figunit.value = typeof c.figureSize === 'string' && c.figureSize.endsWith('px') ? 'px' : '%';
    form.elements.figh.value = c.figureH ?? 'center';
    form.elements.figslot.value = c.figureSlot ?? 'title';
    for (const side of ['left', 'right']) {
      const { width = '', top, bottom } = c.sides?.[side] ?? {};
      const [kind, n = ''] = width.split('=');
      form.elements[`w${side}`].value = kind;
      form.elements[`w${side}n`].value = n;
      for (const b of form.querySelectorAll(`[name=win${side}]`)) b.checked = !!{ top, bottom }[b.value];
    }
    form.elements.figlink.checked = !!c.figureLink;
    form.elements.foot.value = c.foot;
    form.elements.footend.value = c.footEnd ?? (['left', 'right'].includes(c.foot) ? 'top' : 'bottom');
    form.elements.railalign.value = c.railAlign ?? (['left', 'right'].includes(c.foot) ? c.foot : 'left');
    form.elements.titleweight.value = c.titleWeight ?? '';
    const framePx = /^[0-9]/.test(c.frame ?? '');
    form.elements.frame.value = framePx ? '' : c.frame ?? '';
    form.elements.framepx.value = framePx ? c.frame : '';
    form.elements.bgap.value = c.buttonGap ?? '';
    space = { ...(c.space ?? {}) };
    showTracks();
    form.elements.perrow.value = typeof c.perRow === 'number' ? c.perRow : '';
    form.elements.perp.value = typeof c.perRow === 'number' ? '' : c.perRow === 'fit' ? 'fit' : 'square';
    form.elements.title.value = c.title;
    form.elements.rest.value = c.rest ?? 'split';
    form.elements.titlelink.value = c.titleLink || '';
    form.elements.titleat.value = c.titleAt ?? 'center';
    form.elements.titlealign.value = c.titleAlign ?? 'left';
    form.elements.authors.value = typeof c.authors === 'number' ? 'n' : c.authors;
    form.elements.authorsn.value = typeof c.authors === 'number' ? c.authors : '';
    form.elements.posx.value = c.posX ?? '';
    form.elements.ctxx.value = c.contextX ?? '';
    form.elements.ctxy.value = c.contextY ?? 'bottom';
    form.elements.authorlink.value = c.authorLink || '';
    form.elements.posy.value = c.posY ?? 'bottom';
    form.elements.marks.value = c.marks ?? 'plain';
    form.elements.background.value = c.background;
    form.elements.text.value = c.text;
    for (const b of form.querySelectorAll('[name=extra]')) b.checked = c.extras.includes(b.value);
    for (const b of form.querySelectorAll('[name=link]')) b.checked = c.links === 'all' || c.links.includes(b.value);
  }

  // The controls → the card's name, written by src/lib/cardname.js.
  function spec() {
    const f = new FormData(form);
    const id = f.get('card');
    const all = [...form.querySelectorAll('[name=link]')];
    const on = all.filter((b) => b.checked).map((b) => b.value);
    const width = f.get('wmode') === 'px' ? Math.min(fixedMax, Math.max(fixedMin, Math.round(+f.get('px') || 320))) : null;
    const height = f.get('hmode') === 'px' ? boxHeight() : null;
    // By width belongs to a set width: there a setting left at it is left out.
    const dials = Object.fromEntries(DIALS.map((d) => [d, f.get(d)]).filter(([, v]) => v && v !== 'width'));
    // The title size, unless it follows the text's.
    if (f.get('titlesize') && f.get('titlesize') !== 'text') dials.titlesize = f.get('titlesize');
    // A size typed, on no step, is that many px.
    for (const d in STEP_PX) if (!f.get(d) && f.get(`${d}px`) !== '') dials[d] = String(typedPx(d));
    const slug = formatName({
      width: width ?? 'fill', height: height ?? 'fit', dials,
      figure: !items[id].figure || !el('eb-figure-on').checked ? 'none' : f.get('figat'), figureAlign: f.get('figv'), figureSlot: f.get('figat') === 'center' ? f.get('figslot') : undefined, figureSize: f.get('figpx') === '' ? 'auto' : f.get('figunit') === 'px' ? `${figWidth()}px` : figWidth(), figureH: ['left', 'right'].includes(f.get('figat')) && f.get('figh') !== 'center' ? f.get('figh') : undefined, sides: sides(f), figureLink: f.get('figlink') === 'on',
      foot: f.get('foot'), footEnd: f.get('footend'), railAlign: f.get('railalign'), titleWeight: f.get('titleweight') || undefined, frame: f.get('framepx') !== '' ? String(clampInt(f.get('framepx'), 0, 32)) : f.get('frame') || undefined, buttonGap: f.get('bgap') !== '' ? String(clampInt(f.get('bgap'), 0, 32)) : undefined, space: { ...space }, title: f.get('title'), titleLink: linkFor(items[id], f.get('titlelink')), titleAt: f.get('titleat'), titleAlign: f.get('titlealign'), rest: items[id].split ? f.get('rest') : 'split',
      authors: authorsFor(items[id], f.get('authors') === 'n' ? namesN() : f.get('authors')), marks: f.get('marks'), authorLink: f.get('authorlink') || false, posX: f.get('posx') || undefined, contextX: f.get('ctxx') || undefined, contextY: f.get('ctxy'), posY: f.get('posy'), text: items[id].text ? f.get('text') : 'none',
