    font-family:var(--mono); font-size:.72rem; letter-spacing:.06em; text-transform:uppercase; cursor:pointer}
  .eb .eb-word{width:9ch; padding:0 .2em; border:0; border-bottom:1px solid var(--rule-strong); background:none; color:var(--ink); font-family:var(--mono); font-size:.8rem}
  .eb .eb-word:invalid{border-bottom-color:var(--accent)}
  :global(.eb-place[hidden]){display:none}
