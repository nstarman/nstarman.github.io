  /* Sized to the choice it shows, not its longest option, so custom sits by its arrow. */
  .eb .eb-preset{flex:0 1 auto; field-sizing:content; max-width:11rem; padding:0; border:0; background:none; cursor:pointer;
    font-family:var(--mono); font-size:.66rem; color:var(--ink-faint); text-overflow:ellipsis}
  .eb .eb-preset:hover, .eb .eb-preset:focus-visible{color:var(--ink)}
  .eb .pilltoggle{flex-wrap:wrap}
  .eb-sizes, .eb-rest{align-self:center; text-transform:uppercase}
