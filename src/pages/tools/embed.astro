  .eb-drop-menu{position:absolute; top:calc(100% + .3rem); left:0; z-index:5; display:flex; flex-direction:column; gap:.35rem;
    padding:.5rem .75rem; white-space:nowrap; background:var(--surface); border:1px solid var(--rule-strong); border-radius:.6rem;
