  .eb-rest[hidden], .eb-row[hidden]{display:none}
  /* The width stop: a number to type, the width of its siblings. */
  .eb-px{display:inline-flex; flex-wrap:wrap; align-items:baseline; gap:.4rem 1rem}
  .eb-px > label{display:inline-flex; align-items:baseline; gap:.15em}
  #eb-w-shown, #eb-h-shown{text-transform:none}
  :global(.eb-dim){font-family:var(--mono); font-size:.68rem; color:var(--ink-faint)}
  .eb-px > [hidden]{display:none}
  .eb-px[hidden], .eb-sizes[hidden], .eb-sizes [hidden]{display:none}
  /* Global: the Space row builds its tracks' boxes from script, which the
     page's scoped styles do not reach. */
  :global(.eb-px input[type="number"]){width:3.2em; padding:0; border:0; border-bottom:1px solid var(--rule-strong);
    background:none; font:inherit; color:inherit; text-align:right; -moz-appearance:textfield}
  :global(.eb-px input[type="number"]::-webkit-inner-spin-button), :global(.eb-px input[type="number"]::-webkit-outer-spin-button){-webkit-appearance:none; margin:0}
  /* Choose-one rows are bare pills; the extras, any number of which can be on,
