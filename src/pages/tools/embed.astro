  .eb-preview[data-theme="dark"]{background:#0B0E14}
  .eb-preview[data-theme="light"]{background:#FFFFFF}
  /* The stage can be dragged taller, for room under the card; one that fills
     its width can be dragged narrower or wider too, to see it reflow. */
  .eb-preview{resize:vertical; min-height:6rem}
