---
import fs from 'node:fs';
import Base from '../../layouts/Base.astro';
import CvHeader from '../../components/CvHeader.astro';
import CvView from '../../components/CvView.astro';
import CvToc from '../../components/CvToc.astro';
import CvFmtRow from '../../components/CvFmtRow.astro';
import '../../styles/cv/builder.css';
import { resolve, memberIds, presetNames, preset } from '../../lib/presets.js';
import { buildInfo } from '../../lib/buildinfo.js';
import CV_STYLES from '../../../cv/lib/styles.json';

// The picker is the complete CV itself, rendered server-side with a checkbox on
// every entry — so what you tick is what you are about to compile, and the page
// is readable and linkable without JavaScript. Only the compile step needs the
// client.
const cv = resolve('complete');
// The CV people actually want is the normal one; start there and trim.
const START = 'np';
const picked = new Set(memberIds(START));
const startLevel = preset(START).detail;
// The complete CV is the only one that prints `detailsComplete`, so seeding the
// picker from any other preset must leave those lines unticked — otherwise
// "start from NP, compile" quietly puts back a line the NP CV does not have.
const startsComplete = Boolean(preset(START).includeAll);
const membership = Object.fromEntries(presetNames.map((n) => [n, memberIds(n)]));
const total = memberIds('complete').length;
// Stamped into a saved selection so it can be taken back to the data it names.
const site = buildInfo();
// What the client script needs from the build, as one data island: each
// preset's members, its detail level, whether it prints the complete-only
// lines (only the complete CV does), and the faces to compile with. Those are
// whatever public/fonts/ holds — the folder scripts/build-cv-pdfs.sh compiles
// with too — so a face added there needs no list updating here.
const builderData = {
  membership,
  detail: Object.fromEntries(presetNames.map((n) => [n, preset(n).detail])),
  place: Object.fromEntries(presetNames.map((n) => [n, preset(n).place ?? {}])),
  recipientInline: Object.fromEntries(presetNames.map((n) => [n, preset(n).recipientInline])),
  spacing: Object.fromEntries(presetNames.map((n) => [n, preset(n).spacing ?? {}])),
  unabridged: Object.fromEntries(presetNames.map((n) => [n, Boolean(preset(n).includeAll)])),
  // Each preset's grid columns, by section id, where it sets them.
  columns: Object.fromEntries(presetNames.map((n) => [n,
    Object.fromEntries(preset(n).sections.filter((s) => s.columns).map((s) => [s.id, s.columns]))])),
  site,
  // Each PDF style's heading variants, its usual one first.
  headings: Object.fromEntries(Object.entries(CV_STYLES).map(([n, st]) => [n, Object.keys(st.headings)])),
  fonts: fs.readdirSync('public/fonts').filter((f) => f.endsWith('.otf')).sort().map((f) => `/fonts/${f}`),
};
---
<Base title="CV Builder — Nathaniel Starkman">
  <main>
    <section>
      <div class="wrap">
        <CvHeader current="builder" />
        <CvToc sections={cv.sections} />

        <p class="lede">
          Tick what you want and compile a PDF in your browser. Nothing is sent anywhere —
          the Typst compiler runs locally as WebAssembly, from the same template and the
          same data as the pre-built versions.
        </p>

        <div class="builderbar">
          <span class="bl">Start from</span>
          {presetNames.map((n) => (
            <button class="btn" type="button" data-preset={n}>{preset(n).label}</button>
          ))}
          <button class="btn" type="button" data-all="0">None</button>
          <span class="sep">|</span>
          <button class="btn" type="button" id="load">Load</button>
          <input type="file" id="loadfile" accept="application/json,.json"
                 hidden aria-hidden="true" tabindex="-1" />
          {/* The count and Save Selection are one element: it sits here, and
              moves into the condensed bar while that is showing. */}
          <span class="selgroup" id="selgroup">
            <span class="count" id="count">{picked.size} / {total}</span>
            <button class="btn" type="button" id="savebar">Save Selection</button>
          </span>
        </div>

        <div class="builderbar builderbar--go">
          {/* Left of Compile, because it is a choice about the thing being
              compiled rather than a second action. */}
          <label class="bl" for="style">Style</label>
          {/* From cv/lib/styles.json, the manifest styles.typ checks itself
              against, so the menu cannot offer a style the template lacks. */}
          <select class="btn btn--sel" id="style">
            {Object.entries(CV_STYLES).map(([n, st]) => <option value={n}>{st.label}</option>)}
          </select>
          <button class="btn btn--go" type="button" id="build"
                  title="The compiler is ~10 MB and loads on first use.">Compile PDF</button>
          <a class="btn" id="download" download="starkman-cv-custom.pdf" hidden>Download</a>
          <span class="status" id="status"></span>
          {/* Settings for every section at once; each is still its own below. */}
          <button class="fmtbtn posbtn posbtn--icon" type="button" aria-expanded="false" aria-controls="fmt-all"
                  aria-label="Settings for every section" title="Settings for every section">
            <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-sliders" /></svg>
          </button>
        </div>

        <CvFmtRow s={{ id: 'all', heading: 'every section', layout: 'entries' }} all />

        <iframe id="preview" title="CV preview" hidden></iframe>

        <div id="tree">
          <CvView cv={cv} pick picked={picked} level={startLevel} completeLines={startsComplete} />
        </div>
      </div>
    </section>
  </main>

  <!-- A JSON data island rather than define:vars: combined with set:html, Astro
       wrapped the script in an IIFE and the global assignment never ran, so every
       preset button silently selected nothing. -->
  <script type="application/json" id="builderdata" set:html={JSON.stringify(builderData)}></script>

  <script>
    import { cvModel } from '../../lib/cvmodel.js';
    import { encode, decode, loadReport } from '../../lib/selection.js';
    import { plural } from '../../lib/inline.js';
    import { compilePdf } from '../../lib/typstcompile.js';
    import { readSpacing, writeSpacing } from '../../lib/cvspacing.js';
    import { move, holdDrag } from '../../lib/secorder.js';

    const $ = (id) => document.getElementById(id);
    const { membership: MEMBERSHIP, detail: DETAIL, unabridged: UNABRIDGED, columns: PRESET_COLUMNS, place: PLACE, recipientInline: RECIPIENT_INLINE, spacing: SPACING, site: SITE, fonts: FONTS,
            headings: HEADINGS } =
      JSON.parse($('builderdata').textContent);
    const boxes = () => [...document.querySelectorAll('.itembox')];
    /** The "Start from" button whose selection is still exactly what is
     *  ticked stays lit; any change to the selection puts it out. */
    const unmarkStart = () => {
      for (const b of document.querySelectorAll('[data-preset], [data-all="0"]')) b.removeAttribute('aria-pressed');
    };
    const subs = () => [...document.querySelectorAll('.subbox')];

    /** An unticked line greys out in place, so the page keeps showing what it
     *  is about to compile rather than describing it. */
    const applyDetail = () => {
      retire('Selection changed — compile again.');
      unmarkStart();
      for (const b of subs()) b.closest('.sub').classList.toggle('is-off', !b.checked);
      // a section's control reflects its lines rather than driving them
      for (const g of document.querySelectorAll('.pickgroup')) {
        const head = g.querySelector('.subgroup');
        if (!head) continue;
        const kids = [...g.querySelectorAll('.subbox')];
        const on = kids.filter((k) => k.checked).length;
        head.checked = on === kids.length;
        head.indeterminate = on > 0 && on < kids.length;
      }
    };
    const status = (msg) => { $('status').textContent = msg; };

    /** A compiled PDF is only good for the selection, the detail, the style
     *  and the spacing it was compiled from. Anything that changes one of those retires it:
     *  otherwise Download hands over a file that no longer matches the page,
     *  and the preview goes on showing it. Silent when there is nothing
     *  compiled, which is why the init call below costs nothing. */
    const retire = (why) => {
      const dl = $('download');
      if (dl.hidden) return;
      URL.revokeObjectURL(dl.href);
      dl.hidden = true;
      dl.removeAttribute('href');
      const frame = $('preview');
      frame.hidden = true;
      frame.removeAttribute('src');
      status(why);
    };

    /** Whether the author-position cut `want` ("all" or a number) takes this entry. An
     *  entry with no position — no author marked `me` — is only in "all". */
    const inCut = (b, want) => want === 'all' || (Number.isFinite(Number(b.dataset.pos)) && Number(b.dataset.pos) <= Number(want));

    const recount = () => {
      retire('Selection changed — compile again.');
      unmarkStart();
      const on = boxes().filter((b) => b.checked).length;
      $('count').textContent = `${on} / ${boxes().length}`;
      // a group box reflects its children rather than driving them
      for (const g of document.querySelectorAll('.pickgroup')) {
        const kids = [...g.querySelectorAll('.itembox')];
        const head = g.querySelector('.groupbox');
        const n = kids.filter((k) => k.checked).length;
        head.checked = n === kids.length;
        head.indeterminate = n > 0 && n < kids.length;
      }
      for (const row of document.querySelectorAll('.fmtrow')) syncFmt(row);
      // The author-position slider rests on the stop whose cut is exactly what
      // is ticked — so "All" lights however everything came to be selected —
      // and on none when the selection matches no stop.
      for (const bar of document.querySelectorAll('.possel .pubfilter')) {
        const items = [...bar.closest('.pickgroup').querySelectorAll('.itembox')];
        const btns = [...bar.querySelectorAll('button')];
        const at = btns.findIndex((b) => items.every((i) => i.checked === inCut(i, b.dataset.possel)));
        btns.forEach((b, k) => b.setAttribute('aria-pressed', String(k === at)));
        if (at < 0) delete bar.dataset.at; else bar.dataset.at = at;
      }
    };

    /** The settings row's choice, copied to every section's own. */
    const applyGlobal = (t) => {
      if (t.id === 'selprefix') {
        for (const g of prefixGroups()) g.checked = t.checked;
        return;
      }
      if (t.name?.startsWith('heading:')) {
        for (const g of headingGroups()) setHeading(g, t.value);
        syncHeading();
        return;
      }
      const box = t.closest('.numbox');
      if (!box) return;
      const want = readSpacing(box);
      // Heading gaps and entry gaps; the legend's is its own.
      const heading = keyOf(box) === 'all.heading';
      for (const f of spacingFields()) {
        const k = keyOf(f);
        if (heading ? k.endsWith('.heading') : !k.includes('.')) writeSpacing(f, want);
      }
    };

    document.addEventListener('change', (e) => {
      const t = e.target;
      if (t.closest?.('.fmtrow--all')) {
        applyGlobal(t);
        retire('Settings changed — compile again.');
        return;
      }
      if (t.name?.startsWith('heading:')) {
        setHeading(t.closest('[data-heading-of]'), t.value);
        retire('Heading changed — compile again.');
        return;
      }
      if (t.name?.startsWith('group:')) {
        t.closest('.cvsec').classList.toggle('cvsec--sep', !t.checked);
        retire('Grouping changed — compile again.');
        return;
      }
      if (t.name?.startsWith('prefix:')) { retire('Heading changed — compile again.'); return; }
      if (t.name?.startsWith('columns:')) { retire('Columns changed — compile again.'); return; }
      if (t.name?.startsWith('place:')) {
        syncFmt(t.closest('.fmtrow'));
        retire('Placement changed — compile again.');
        return;
      }
      // A spacing field has settled its own value by now (it listens first).
      if (t.closest?.(`${SECTION_ROW} .numbox`)) { retire('Spacing changed — compile again.'); return; }
      if (t.classList?.contains('subgroup')) {
        t.closest('.pickgroup').querySelectorAll('.subbox')
          .forEach((b) => (b.checked = t.checked));
        applyDetail();
        return;
      }
      if (t.classList?.contains('subbox')) { applyDetail(); return; }
      if (t.classList?.contains('inlinebox')) {
        t.closest('.recipient').classList.toggle('recipient--inline', t.checked);
        retire('Recipient placement changed — compile again.');
        return;
      }
      if (t.classList?.contains('groupbox')) {
        const on = t.checked;
        t.closest('.pickgroup').querySelectorAll('.itembox').forEach((b) => (b.checked = on));
      }
      recount();
    });

    // Taking focus can scroll a checkbox that sits under the sticky bars into
    // view, which moves the page on a plain click. A mouse click needs no
    // focus ring; the keyboard still reaches the box.
    document.addEventListener('mousedown', (e) => {
      if (e.target.closest('.subgrouplab, .subbox')) e.preventDefault();
    });

    document.addEventListener('click', (e) => {
      const t = e.target.closest('button');
      if (!t) return;
      if (t.classList.contains('fmtbtn')) {
        const open = t.getAttribute('aria-expanded') !== 'true';
        t.setAttribute('aria-expanded', String(open));
        $(t.getAttribute('aria-controls')).hidden = !open;
      }
      if (t.dataset.move !== undefined) {
        const head = t.closest('.cvsec').querySelector('.cvsection');
        const at = head.getBoundingClientRect().top;
        setOrder(move(currentOrder(), head.id, Number(t.dataset.move)));
        // The section moved under the pointer; bring it back, so a second press
        // moves it again rather than something else.
        scrollBy(0, head.getBoundingClientRect().top - at);
        retire('Order changed — compile again.');
        // The button the press landed on may now be disabled, and focus with it.
        if (t.disabled) t.closest('.cvsec').querySelector('.secmove button:not(:disabled)')?.focus();
      }
      if (t.id === 'resetorder') {
        setOrder(FIRST_ORDER);
        retire('Order reset — compile again.');
      }
      // "Start from" starts from the preset's sections in their usual order too.
      if (t.dataset.all !== undefined || t.dataset.preset) setOrder(FIRST_ORDER);
      if (t.dataset.all !== undefined) {
        boxes().forEach((b) => (b.checked = t.dataset.all === '1'));
        recount();
        if (t.dataset.all === '0') t.setAttribute('aria-pressed', 'true');
      }
      if (t.dataset.possel !== undefined) {
        // Scoped to the section the button sits in, so it can never reach
        // another section's entries.
        const group = t.closest('.pickgroup');
        const want = t.dataset.possel;
        let on = 0;
        for (const b of group.querySelectorAll('.itembox')) {
          const keep = inCut(b, want);
          b.checked = keep;
          if (keep) on += 1;
        }
        recount();
        status(want === 'all' ? `All ${on} publications selected.`
          : `${on} publications with author position ${want} or better.`);
      }
      if (t.dataset.papersel !== undefined) {
        // Scoped to its own section, exactly as the position cut is.
        const group = t.closest('.pickgroup');
        const all = t.dataset.papersel === 'all';
        let on = 0;
        for (const b of group.querySelectorAll('.itembox')) {
          const keep = all || b.dataset.paper !== undefined;
          b.checked = keep;
          if (keep) on += 1;
        }
        recount();
        status(all ? `All ${on} packages selected.`
          : `${on} packages with a paper.`);
      }
      if (t.dataset.preset) {
        const ids = new Set(MEMBERSHIP[t.dataset.preset] ?? []);
        boxes().forEach((b) => (b.checked = ids.has(b.value)));
        // A preset is not only which entries appear but how much each says, so
        // the detail controls move with it.
        const full = (DETAIL[t.dataset.preset] ?? 'full') === 'full';
        // A complete-only line belongs to the complete CV alone, so it stays
        // unticked for every other preset even though they are "full" detail.
        const unabridged = UNABRIDGED[t.dataset.preset] ?? false;
        subs().forEach((b) => {
          b.checked = full && (b.dataset.complete === undefined || unabridged);
        });
        // Its grids' columns too, the usual 3 where it does not say.
        for (const g of columnGroups()) setColumns(g, PRESET_COLUMNS[t.dataset.preset]?.[g.dataset.columnsOf] ?? 3);
        for (const g of placeGroups()) setPlace(g, PLACE[t.dataset.preset]?.[g.dataset.placeOf]);
        // The preset's say on recipients, else each entry's own.
        for (const b of inlineBoxes()) {
          b.checked = RECIPIENT_INLINE[t.dataset.preset] || b.dataset.default !== undefined;
          b.closest('.recipient').classList.toggle('recipient--inline', b.checked);
        }
        for (const f of spacingFields()) writeSpacing(f, SPACING[t.dataset.preset]?.[keyOf(f)] ?? null);
        for (const row of document.querySelectorAll('.fmtrow')) syncFmt(row);
        applyDetail();
        recount();
        t.setAttribute('aria-pressed', 'true');
      }
    });

    // Docked under the sticky header, the settings for every section are a
    // pop-over: a click anywhere else, or Escape, puts it away. Inline at the
    // top of the page it is a row like the sections', and stays until closed.
    const closeGlobal = () => {
      const btn = document.querySelector('.fmtbtn[aria-controls="fmt-all"]');
      if (btn?.getAttribute('aria-expanded') !== 'true') return;
      if (!$('fmt-all').classList.contains('is-docked')) return;
      btn.setAttribute('aria-expanded', 'false');
      $('fmt-all').hidden = true;
    };
    document.addEventListener('click', (e) => {
      if (!e.target.closest('#fmt-all, .fmtbtn[aria-controls="fmt-all"]')) closeGlobal();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeGlobal(); });

    // ── formatting ──────────────────────────────────────────────────────
    // The fields are the state, so there is no second copy to drift.
    // Each box's input is named for its spacing key; empty, it is the gap's
    // own size and is left out.
    // The settings button's row sets every section's at once and holds no
    // state of its own, so it is left out of everything read back.
    const SECTION_ROW = '.fmtrow:not(.fmtrow--all)';
    const spacingFields = () => [...document.querySelectorAll(`${SECTION_ROW} .numbox`)];
    const keyOf = (box) => box.querySelector('input').name;
    /** Spacing key → `{value, unit}`, for the boxes with a value. */
    const currentSpacing = () => {
      const out = {};
      for (const f of spacingFields()) {
        const g = readSpacing(f);
        if (g) out[keyOf(f)] = g;
      }
      return out;
    };

    // A heading choice per section, each a slider of radios.
    const headingGroups = () => [...document.querySelectorAll('[data-heading-of]')];
    const globalHeading = () => document.querySelector('[data-heading-all]');
    const usualHeading = () => HEADINGS[$('style').value]?.[0] ?? 'none';
    const shownChoice = (g) => g.querySelector('label:not([hidden]) > :checked')?.value;
    const setHeading = (group, v) => {
      for (const r of group.querySelectorAll('input')) r.checked = r.value === v;
      syncFmt(group.closest('.fmtrow'));
    };
    /** Hide what would do nothing: with no heading, its spacing and the
     *  legend's Title place — there is no line to put the legend on — and,
     *  with the legend up on the heading's line, the gap below it. The prefix
     *  shows only while the section is part-ticked, the one time its
     *  heading says "Select". */
    const syncFmt = (row) => {
      const none = row.querySelector('[data-heading-of] label:not([hidden]) > :checked')?.value === 'none';
      row.querySelector('.fmtopt--headgap').hidden = none;
      const prefix = row.querySelector('.fmtopt--prefix');
      if (prefix) prefix.hidden = none || !row.closest('.pickgroup').querySelector('.groupbox').indeterminate;
      const place = row.querySelector('.fmtopt--place');
      if (!place) return;
      // Title is the last stop, so dropping it moves no other.
      const title = place.querySelector('input[value="title"]');
      title.parentElement.hidden = none;
      place.querySelector('[data-place-of]').dataset.stops = none ? 2 : 3;
      if (none && title.checked) setPlace(place.querySelector('[data-place-of]'), 'below');
      row.querySelector('.fmtopt--legendgap').hidden = !none && place.querySelector(':checked')?.value === 'title';
    };
    // Where a part sits, by its key; a name no stop has is the default.
    const placeGroups = () => [...document.querySelectorAll('[data-place-of]')];
    const setPlace = (group, v) => {
      const radios = [...group.querySelectorAll('input')];
      const want = radios.some((r) => r.value === v) ? v : 'below';
      for (const r of radios) r.checked = r.value === want;
    };
    /** Part key → where it sits, for the parts not in their usual place. */
    const currentPlace = () => Object.fromEntries(placeGroups()
      .map((g) => [g.dataset.placeOf, g.querySelector(':checked')?.value])
      .filter(([, v]) => v && v !== 'below'));
    // A grid's column count, by section id.
    const columnGroups = () => [...document.querySelectorAll('[data-columns-of]')];
    const setColumns = (group, n) => {
      const radios = [...group.querySelectorAll('input')];
      const want = radios.some((r) => r.value === String(n)) ? String(n) : '3';
      for (const r of radios) r.checked = r.value === want;
    };
    /** Section id → columns, for the grids not at the usual 3. */
    const currentColumns = () => Object.fromEntries(columnGroups()
      .map((g) => [g.dataset.columnsOf, Number(g.querySelector(':checked')?.value)])
      .filter(([, n]) => n && n !== 3));
    // Whether a part-ticked section's heading says "Select", by section id.
    const prefixGroups = () => [...document.querySelectorAll('[data-prefix-of]')];
    const setPrefix = (box, v) => { box.checked = v === 'select'; };
    // Whether roles at one institution print under it, by section id.
    const groupBoxes = () => [...document.querySelectorAll('[data-group-of]')];
    const setGroup = (box, separate) => {
      box.checked = !separate;
      box.closest('.cvsec').classList.toggle('cvsec--sep', separate);
    };
    /** Section id → true, for the sections whose roles print as separate rows. */
    const currentSeparate = () => Object.fromEntries(groupBoxes()
      .filter((g) => !g.checked).map((g) => [g.dataset.groupOf, true]));
    /** Section id → `select`, for the sections whose heading says "Select". */
    const currentPrefix = () => Object.fromEntries(prefixGroups()
      .filter((g) => g.checked)
      .map((g) => [g.dataset.prefixOf, 'select']));
    /** Section id → how its heading prints, for every section. */
    const currentHeadings = () => Object.fromEntries(headingGroups().map((g) => [
      g.dataset.headingOf, shownChoice(g) ?? usualHeading(),
    ]));
    /** Offer only the heading variants the chosen style draws. A choice the
     *  style lacks — after a style change, or from a file — becomes its usual
     *  heading rather than vanishing. The slider's thumb finds its stop by
     *  position, so a stop taken away goes to the end — after None — and the
     *  count of stops follows. */
    const syncHeading = () => {
      const style = $('style').value;
      for (const g of [...headingGroups(), globalHeading()]) {
        const stops = [...g.querySelectorAll('label[data-styles]')];
        for (const l of stops) l.hidden = !l.dataset.styles.split(' ').includes(style);
        for (const l of stops.filter((l) => l.hidden)) g.append(l);
        g.dataset.stops = 1 + stops.filter((l) => !l.hidden).length;
        if (!shownChoice(g)) setHeading(g, usualHeading());
      }
    };

    // ── section order ───────────────────────────────────────────────────
    // The sections' own order in the page is the state, as the fields are for
    // formatting. The contents list follows it, and so does the compile.
    const sections = () => [...document.querySelectorAll('#tree .cvsec')];
    const secId = (s) => s.querySelector('.cvsection').id;
    const currentOrder = () => sections().map(secId);
    const FIRST_ORDER = currentOrder();
    const toc = document.querySelector('.cvtoc ol');
    // The talks' wrapper and what rides in it besides the sections (the map and
    // its data), taken once: they are not sections, so no later look can tell
    // them from a section's neighbours.
    const talks = document.querySelector('#tree .cvtalks');
    const talksExtras = [...talks.children].filter((c) => !c.matches('.cvsec'));

    /** Lay the page, the contents list and the move buttons out in `ids`'
     *  order; a section the list does not name goes last, as the compile has it. */
    const setOrder = (ids) => {
      const rank = (id) => { const i = ids.indexOf(id); return i < 0 ? ids.length : i; };
      const sorted = sections().sort((a, b) => rank(secId(a)) - rank(secId(b)));
      const tree = $('tree');
      // The conference map sticks through the run of talk sections, so it wraps
      // the first run there is, wherever the moves have left it.
      tree.append(...sorted);
      const run = [];
      for (const s of sorted) {
        if (s.dataset.talks !== undefined) run.push(s);
        else if (run.length) break;
      }
      if (run.length) { run[0].before(talks); talks.append(...run, ...talksExtras); }
      sorted.forEach((s, i) => {
        s.classList.toggle('cvsec--first', i === 0);
        s.classList.toggle('cvsec--last', i === sorted.length - 1);
        const [up, down] = s.querySelectorAll('.secmove button');
        up.disabled = i === 0;
        down.disabled = i === sorted.length - 1;
      });
      // Nothing to reset while it is as the page began.
      $('resetorder').disabled = sorted.every((s, i) => secId(s) === FIRST_ORDER[i]);
      if (toc) {
        const lis = new Map([...toc.children].map((li) => [li.querySelector('a').dataset.sec, li]));
        toc.append(...sorted.map((s) => lis.get(secId(s))));
      }
    };
    setOrder(currentOrder());

    // Holding a contents entry picks it up; the page follows when it is let go.
    if (toc) {
      holdDrag(toc, {
        onDrop: () => {
          setOrder([...toc.children].map((li) => li.querySelector('a').dataset.sec));
          retire('Order changed — compile again.');
        },
      });
    }

    // ── save & load ───────────────────────────────────────────────────────
    // A long selection is real work, and it is only ever one reload from gone.


    /** What is ticked right now: entries, and which lines of each. */
    const currentLines = () => {
      const lines = {};
      for (const b of subs()) {
        if (!b.checked) continue;
        (lines[b.dataset.id] ??= []).push(Number(b.dataset.line));
      }
      return lines;
    };

    const inlineBoxes = () => [...document.querySelectorAll('.inlinebox')];
    const currentInline = () => inlineBoxes().filter((b) => b.checked).map((b) => b.dataset.id);

    const saveSelection = () => {
      const chosen = boxes().filter((b) => b.checked).map((b) => b.value);
      const doc = encode({ items: chosen, lines: currentLines(), inline: currentInline(),
                          style: $('style').value, spacing: currentSpacing(),
                          heading: currentHeadings(), place: currentPlace(),
                          prefix: currentPrefix(), order: currentOrder(), columns: currentColumns(),
                          separate: currentSeparate(), site: SITE });
      // Indented: it is small, and a selection you can read and hand-edit in a
      // text editor is worth more than the bytes saved.
      const blob = new Blob([JSON.stringify(doc, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `starkman-cv-${SITE.short ?? 'selection'}.json`;
      a.click();
      // Freed on the next turn: revoking synchronously can beat the download.
      setTimeout(() => URL.revokeObjectURL(url), 0);
      status(`Saved ${plural(chosen.length, 'entry', 'entries')}${SITE.short ? ` from ${SITE.short}` : ''}.`);
    };

    /** Tick what the file says, and report anything the current data cannot. */
    const applySelection = (sel) => {
      for (const b of boxes()) b.checked = sel.items.has(b.value);
      for (const b of subs()) {
        b.checked = sel.lines.get(b.dataset.id)?.has(Number(b.dataset.line)) ?? false;
      }
      for (const b of inlineBoxes()) {
        b.checked = sel.inline.has(b.dataset.id);
        b.closest('.recipient').classList.toggle('recipient--inline', b.checked);
      }
      applyDetail();
      recount();

      // The style travels with the selection. Set directly rather than through
      // a change event: applyDetail and recount have already retired any
      // compiled PDF, and firing one here would only overwrite the message
      // below with a less specific one.
      const menu = $('style');
      const wanted = sel.style ?? 'default';
      const haveStyle = [...menu.options].some((o) => o.value === wanted);
      menu.value = haveStyle ? wanted : 'default';
      for (const g of prefixGroups()) setPrefix(g, sel.prefix[g.dataset.prefixOf]);
      for (const g of groupBoxes()) setGroup(g, Boolean(sel.separate[g.dataset.groupOf]));
      // Before the sync, which then turns any the style lacks into its usual.
      for (const g of headingGroups()) setHeading(g, sel.heading[g.dataset.headingOf] ?? usualHeading());
      syncHeading();
      for (const g of placeGroups()) setPlace(g, sel.place[g.dataset.placeOf]);
      for (const g of columnGroups()) setColumns(g, sel.columns[g.dataset.columnsOf]);
      for (const row of document.querySelectorAll('.fmtrow')) syncFmt(row);
      setOrder(sel.order.length ? sel.order : FIRST_ORDER);
      // A gap the file does not set, or sets out of bounds, is the default.
      for (const f of spacingFields()) writeSpacing(f, sel.spacing[keyOf(f)] ?? null);

      const known = new Set(boxes().map((b) => b.value));
      const { message, missing } = loadReport(sel, known, SITE, haveStyle);
      status(message);
      if (missing.length) console.warn('Entries not present in this build:', missing);
    };

    const loadFile = async (file) => {
      if (!file) return;
      try {
        applySelection(decode(await file.text()));
      } catch (err) {
        status(err?.message ?? 'That file could not be read.');
      }
    };

    document.addEventListener('click', (e) => {
      if (e.target.closest('#savebar')) saveSelection();
      if (e.target.closest('#load')) $('loadfile').click();
    });
    $('loadfile').addEventListener('change', (e) => {
      loadFile(e.target.files?.[0]);
      // Cleared so choosing the same file twice fires change again.
      e.target.value = '';
    });

    // The compile controls are one element, not two: when the condensed header
    // takes over they move into it and move back when it goes, so there is no
    // second button whose label, status and download link could drift.
    const bar = document.querySelector('.cvbar');
    const go = document.querySelector('.builderbar--go');
    if (bar && go) {
      const spacer = bar.querySelector('.spacer');
      const slot = bar.querySelector('.wrap');
      const home = document.createComment('compile controls');
      go.parentNode.insertBefore(home, go);
      // The selection count and Save Selection travel the same way, to the
      // bar's right end, and back to the end of the Start-from row.
      const sel = $('selgroup');
      const selSlot = $('selslot');
      const selHome = document.createComment('selection');
      sel.parentNode.insertBefore(selHome, sel);
      const place = () => {
        const on = bar.classList.contains('is-on');
        if (on === (go.parentNode === slot)) return;
        // The settings panel follows its button: a row in the page, and in the
        // bar — which has one line of room — a dropdown under it.
        $('fmt-all').classList.toggle('is-docked', on);
        if (on) { slot.insertBefore(go, spacer); selSlot.append(sel); }
        else {
          home.parentNode.insertBefore(go, home);
          selHome.parentNode.insertBefore(sel, selHome);
          sel.querySelector('button').tabIndex = 0;
        }
        if (spacer) spacer.hidden = on;
      };
      place();
      addEventListener('scroll', place, { passive: true });
      addEventListener('resize', place, { passive: true });
    }

    // A compiled PDF belongs to the style it was compiled with. Changing the
    // menu retires it — otherwise Download keeps handing over a file that no
    // longer matches what the menu says, and the preview keeps showing it.
    $('style').addEventListener('change', () => {
      syncHeading();
      retire('Style changed — compile again.');
    });

    $('build').addEventListener('click', async () => {
      const chosen = new Set(boxes().filter((b) => b.checked).map((b) => b.value));
      if (!chosen.size) return status('Nothing selected.');
      $('build').disabled = true;
      try {
        // Same resolver as the site and the CI PDFs — "complete" is the widest
        // section set, then the tick-boxes narrow it.
        const lines = currentLines();
        const model = cvModel('complete', chosen, (id, i) => lines[id]?.includes(i) ?? false,
                              { prefix: currentPrefix(), order: currentOrder(), separate: currentSeparate() });
        // The template reads this; absent, it compiles the default. The CLI
        // never writes it, so the pre-built PDFs cannot drift from this menu.
        const inline = new Set(currentInline());
        for (const s of model.sections) {
          for (const it of s.items) if (it.recipient) it.recipientInline = inline.has(it.id);
        }
        model.style = $('style').value;
        model.spacing = currentSpacing();
        model.heading = currentHeadings();
        model.place = currentPlace();
        const cols = currentColumns();
        for (const s of model.sections) s.columns = cols[s.id] ?? s.columns;
        const pdf = await compilePdf(model, FONTS, status);

        const url = URL.createObjectURL(new Blob([pdf], { type: 'application/pdf' }));

        // Preview in place as well as downloading — a CV you cannot see before
        // saving is a CV you save several times.
        const frame = $('preview');
        frame.hidden = false;
        frame.src = url;
        $('download').hidden = false;
        $('download').href = url;
        $('download').download = model.style === 'default'
          ? 'starkman-cv-custom.pdf' : `starkman-cv-custom-${model.style}.pdf`;

        const kb = Math.round(pdf.length / 1024);
        status(`Built ${chosen.size} entries · ${kb} KB.`);
      } catch (err) {
        console.error(err);
        status(`Compile failed: ${err?.message ?? err}`);
      } finally {
        $('build').disabled = false;
      }
    });

    recount();
    applyDetail();
    // A browser may restore the menu to another style on reload.
    syncHeading();
  </script>
</Base>
