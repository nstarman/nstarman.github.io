---
// /tools/card/ — pick an item, then its card: one of the website's presets or
// any size, layout, title, text, extras, links and look. The preview is the live embed; the
// snippet is an iframe, HTML or Markdown for an image, or the PNG or PDF
// itself, drawn here in the browser from the preview — nothing is pre-rendered.
import fs from 'node:fs';
import Base from '../../layouts/Base.astro';
import '../../styles/card-builder.css';
import NumBox from '../../components/NumBox.astro';
import Place from '../../components/Place.astro';
import TextLook from '../../components/TextLook.astro';
import { items } from '../../lib/data.js';
import { itemFacts } from '../../lib/cardbuilder/facts.js';
import {
  STEP_PX, FRAME_PX, LOOKS, DIALS, FIGURE_AT, FIGURE_SLOTS, FOOT_AT, FIXED_MIN_HEIGHT, TEXTS, TITLES, AUTHORS, AUTHORS_MAX, BACKGROUNDS, SITE_PRESETS, BUILDER_DEFAULT, CARD_TYPES, FIXED_MIN, FIXED_MAX,
} from '../../lib/cards.js';

const pool = items.filter((i) => CARD_TYPES.includes(i.type));
const groups = [
  ['publication', 'Publications'],
  ['highlight', 'Syntheses'],
  ['software', 'Software'],
].map(([type, label]) => ({ label, items: pool.filter((i) => i.type === type) }))
  .filter((g) => g.items.length > 0);
// Opens on the latest submitted paper — the one most likely to be shown off.
// Items come newest first.
const pubs = pool.filter((i) => i.type === 'publication');
const start = (pubs.find((i) => i.status === 'submitted') ?? pubs[0] ?? pool[0]).id;

const data = {
  site: Astro.site.href.replace(/\/$/, ''),
  fixedMin: FIXED_MIN,
  fixedMax: FIXED_MAX,
  stepPx: STEP_PX,
  framePx: FRAME_PX,
  fixedMinHeight: FIXED_MIN_HEIGHT,
  // The faces a card is set in, for Typst to draw its PDF with.
  fonts: fs.readdirSync('public/fonts/card').filter((f) => f.endsWith('.otf')).sort().map((f) => `/fonts/card/${f}`),
  // The builder's own default first, then the website's cards.
  presets: [{ slug: BUILDER_DEFAULT, where: 'default' }, ...SITE_PRESETS],
  items: Object.fromEntries(pool.map((i) => [i.id, itemFacts(i)])),
};
---
<Base title="Card Builder — Nathaniel Starkman" description="Export a card from nstarkman.space as an iframe or an image.">
  <main>
    <section>
      <div class="wrap">
        <div class="h2row"><h2>Card Builder</h2></div>
        <p class="lede">Any card on this site, for another page: as an <code>&lt;iframe&gt;</code> that stays
          current, as a PNG for places that strip iframes, such as a GitHub README, or as a PDF. Every card has a
          name — size, layout, what it shows, then its look — and the website’s own are the presets. Every item is
          listed in <a href="/embed/index.json">/embed/index.json</a>.</p>
        <noscript><p class="lede"><strong>This tool needs JavaScript.</strong> Without it, a card is still at{' '}
          <code>/embed/&lt;id&gt;/</code>, and <a href="/embed/index.json">/embed/index.json</a> lists every one.</p></noscript>

        {/* One form round the controls, the preview and the snippet, so the
            format toggle beside the snippet is part of it too. */}
        {/* autocomplete off: the browser would otherwise put back, on a reload,
            whatever was last typed or ticked, over the item's own card. */}
        <form id="eb" novalidate autocomplete="off">
        <div class="eb">
          <div class="eb-row">
            <label class="eb-key" for="eb-card">Item</label>
            <select name="card" id="eb-card">
              {groups.map((g) => (
                <optgroup label={g.label}>
                  {g.items.map((i) => <option value={i.id} selected={i.id === start}>{i.title}</option>)}
                </optgroup>
              ))}
            </select>
            {/* The website's own cards, to check a setting against — never a
                place to start, so as small as a control can be. It says which
                one the controls make, or custom. */}
            <select name="preset" class="eb-preset" aria-label="The website's card these settings make">
              <option value={BUILDER_DEFAULT}>default</option>
              <option value="">custom</option>
              {SITE_PRESETS.map((p) => <option value={p.slug}>{p.where}</option>)}
            </select>
          </div>

          {/* The size, each dimension on its own: the width fills the card's
              container — the preview's stage, which can then be dragged — or
              is set; the height fits its content or is set, so cards side by
              side can share one. A set value opens out of its pill when it is
              clicked and folds back into it, as "640px", once one is chosen. */}
          <div class="eb-row">
            <fieldset class="eb-group">
              <legend class="eb-key">Size</legend>
              <span class="eb-dim">width</span>
              <span class="pilltoggle">
                <label title="Fills its container"><input type="radio" class="posradio" name="wmode" value="fill" />fill</label>
                <label class="eb-setpx" title="A set width — click to set it"><input type="radio" class="posradio" name="wmode" value="px" aria-controls="eb-px" /><span id="eb-w-shown">set</span></label>
              </span>
              <span class="eb-dim">height</span>
              <span class="pilltoggle">
                <label title="Grows with its content"><input type="radio" class="posradio" name="hmode" value="fit" />fit</label>
                <label class="eb-setpx" title="A set height — click to set it"><input type="radio" class="posradio" name="hmode" value="px" aria-controls="eb-px" /><span id="eb-h-shown">set</span></label>
              </span>
              {/* What is set, typed; a few widths, which keep the shape where
                  the height is set too; and, both set, a few shapes, which set
                  the height from the width. Only the numbers are kept. */}
              <span class="eb-px" id="eb-px" role="group" aria-label="Width and height" hidden>
                <span class="sep" aria-hidden="true">|</span>
                <NumBox id="eb-px-w" title="The width, in pixels" name="px" min={FIXED_MIN} max={FIXED_MAX} value="320" label="Width in pixels" unit="px" after="wide" />
                <span class="pilltoggle" id="eb-widths" hidden role="radiogroup" aria-label="Preset widths"></span>
                <NumBox id="eb-px-h" title="The height, in pixels" name="hpx" min={FIXED_MIN_HEIGHT} max={FIXED_MAX} value="400" label="Height in pixels" unit="px" after="high" />
                <span class="pilltoggle" id="eb-shapes" role="radiogroup" aria-label="Shape">
                  {['4x5', '1x1', '8x5', '4x1'].map((a) => <label title={`${a.replace('x', ' wide by ')} high`}><input type="radio" class="posradio" name="shape" value={a} />{a.replace('x', ':')}</label>)}
                </span>
              </span>
            </fieldset>
          </div>

          {/* What the card shows, on one row of pills: each shown or not by
              its tick box — title:none, authors:none, text:none when not.
              Which title, byline or text is chosen under the preview, with the
              rest of what tunes the card: ticking the pill, or clicking that
              part in the preview, brings it up. */}
          <div class="eb-row eb-shows">
            <fieldset class="eb-group">
              <legend class="eb-key eb-key--check">
                <label class="eb-keylabel"><input type="checkbox" class="eb-check" id="eb-title-on" checked />Title</label>
              </legend>
            </fieldset>
            <fieldset class="eb-group" id="eb-authors">
              <legend class="eb-key eb-key--check eb-key--inline">
                <label class="eb-keylabel"><input type="checkbox" class="eb-check" id="eb-authors-on" checked />Authors</label>
              </legend>
            </fieldset>
            {/* Where and when a paper appeared — the venue extra, which reads with
                its byline. */}
            <span class="eb-group" id="eb-venue">
              <label class="eb-key eb-key--check eb-key--inline" title="Where and when it appeared: the journal, or the arXiv number, and the year"><input type="checkbox" class="eb-check" name="extra" value="venue" />Published</label>
            </span>
            <fieldset class="eb-group" id="eb-text">
              <legend class="eb-key eb-key--check eb-key--inline">
                <label class="eb-keylabel"><input type="checkbox" class="eb-check" id="eb-text-on" checked />Text</label>
              </legend>
            </fieldset>
            {/* The figure: shown or not — figure:none when not. Its size is
                chosen under the preview. */}
            <span class="eb-group" id="eb-figure">
              <label class="eb-key eb-key--check eb-key--inline" title="The highlight figure"><input type="checkbox" class="eb-check" id="eb-figure-on" />Figure</label>
            </span>
            {/* The other extras — a package's role, a paper's context link —
                in a menu of tick boxes, filled per item, and gone where it
                has neither. Pilled when any is ticked. */}
            <details class="eb-group eb-drop" id="eb-extras-drop">
              <summary class="eb-key eb-key--check eb-key--inline" title="A package's role, a paper's context link">Extras <span aria-hidden="true">▾</span></summary>
              <span class="eb-drop-menu" id="eb-extras"></span>
            </details>
          </div>

          {/* The item's link buttons, each named by where it goes. */}
          <fieldset class="eb-row">
            <legend class="eb-key">Buttons</legend>
            <span class="pilltoggle" id="eb-links"></span>
          </fieldset>

          <fieldset class="eb-row">
            <legend class="eb-key">Theme</legend>
            <span class="pilltoggle">
              <label><input type="radio" class="posradio" name="theme" value="auto" checked />follow the reader</label>
              <label><input type="radio" class="posradio" name="theme" value="light" />light</label>
              <label><input type="radio" class="posradio" name="theme" value="dark" />dark</label>
            </span>
          </fieldset>
        </div>

        <div class="eb-h eb-head" id="eb-io-head">
          {/* The settings as JSON: everything here but the item, to keep or to
              load onto another one. */}
          <span class="eb-io">
            <span class="eb-io-key">Settings</span>
            <button type="button" class="btn" id="eb-export" title="Save these settings as JSON">Save</button>
            <button type="button" class="btn" id="eb-import" title="Load settings saved as JSON onto this item">Load</button>
            <input type="file" id="eb-import-file" accept="application/json,.json" hidden />
          </span>
        </div>
        <div class="eb-preview" id="eb-preview" aria-live="polite"></div>
        {/* The card's parts are outlined in the preview; clicking one brings up
            what tunes it. Show all is the way in without a pointer. */}
        <p class="eb-tune-hint">Click a part of the card to tune it, or <button type="button" class="eb-linkbtn" id="eb-tune-all">show all</button>.</p>
        <div class="eb eb-dials">
          {/* The areas: fixed — the top, the left side, the center, the right
              side and the bottom — the parts moving between them. First of
              the rows, one for each area that has settings and something in
              it: a side's width — fitting what is in it, at least so many px,
              a share of the card, or as wide as its buttons; and for the top
              and bottom areas, the sides that run beside them, taking their
              corners — left, the area runs over them. */}
          {['left', 'right'].map((side) => (
            <fieldset class="eb-row" id={`eb-area-${side}-row`} data-tune={`area-${side}`} hidden>
              <legend class="eb-key">Area<small>({side === 'left' ? 'Left' : 'Right'})</small></legend>
              <span class="eb-sub">
                <span class="eb-dim">width</span>
                <span class="eb-px">
                  <span class="pilltoggle" role="radiogroup" aria-label={`The ${side} side's width`}>
                    <label title="As wide as what is in it"><input type="radio" class="posradio" name={`w${side}`} value="" checked />fit</label>
                    <label id={`eb-w-${side}-buttons`} title="As wide as its buttons, laid out so many to a row"><input type="radio" class="posradio" name={`w${side}`} value="buttons" />buttons</label>
                    {/* A width typed, as its unit says: chosen by typing it. */}
                    <input type="radio" class="posradio" name={`w${side}`} value="set" hidden />
                  </span>
                  {/* Or a width typed: a share of the card's, in %, or at least
                      so many px, growing to fit what is in it. */}
                  <NumBox id={`eb-w-${side}-n`} name={`w${side}n`} min="0" max="800" placeholder="–" label={`The ${side} side's width`} unitName={`w${side}u`} unitLabel={`The ${side} side's width, as`}
                    units={[{ value: 'share', label: '%', title: "A share of the card's width" }, { value: 'min', label: 'px', title: 'At least so many px, growing to fit what is in it', checked: true }]} />
                </span>
              </span>
            </fieldset>
          ))}
          {['top', 'bottom'].map((end) => (
            <fieldset class="eb-row" id={`eb-area-${end}-row`} data-tune={`area-${end}`} hidden>
              <legend class="eb-key">Area<small>({end === 'top' ? 'Top' : 'Bottom'})</small></legend>
              <span class="eb-sub">
                <span class="eb-dim">beside it</span>
                <span class="pilltoggle eb-checks" role="group" aria-label={`The sides that run beside the ${end} area, taking its corners`}>
                  {['left', 'right'].map((side) => <label id={`eb-win-${side}-${end}`} title={`The ${side} side runs ${end === 'top' ? 'up' : 'down'} beside the ${end} area, taking its corner`}><input type="checkbox" class="eb-check" name={`win${side}`} value={end} />{side === 'left' ? 'LHS' : 'RHS'}</label>)}
                </span>
                {/* Its height, with nothing in it: a strip of the card's padding. */}
                <span class="eb-dim">height</span>
                <span class="eb-px">
                  <NumBox title={`The ${end} area's height when nothing is in it; empty is a line's`} name={`h${end}`} min="0" max="400" placeholder="auto" from="20" label={`The ${end} area's height, in pixels`} unit="px" />
                </span>
              </span>
            </fieldset>
          ))}

          {/* Which title: whole | split sits right after full, the title it
              weights, and is shown for a full title whose short title is part
              of it. none is the tick box's above, so its radio is never shown. */}
          <fieldset class="eb-row" id="eb-title-row" data-tune="title" hidden>
            <legend class="eb-key">Title</legend>
            <span class="eb-sub">
              {/* Its area, first: the top area, across the card above the
                  figure, the words and the sides — empty, it takes no room —
                  or the center, the words' own column. */}
              <span class="eb-dim">area</span>
              <span class="eb-px">
                <select name="titleat" class="eb-menu" aria-label="The area the title sits in">
                  <option value="top" title="Across the card, above the figure, the words and the sides">top</option>
                  <option value="center" title="In the words' own column" selected>center</option>
                </select>
                {/* Then, on the same line, its position: up and down in the
                    top area, across either. */}
                <span class="eb-dim eb-inkey">position</span>
                <Place v="titlev" vId="eb-titlev" h="titlealign" label="The title's position" />
              </span>
              <span class="eb-dim">length</span>
              <span class="eb-titles">
                <span class="pilltoggle">
                  <label><input type="radio" class="posradio" name="title" value="full" />full</label>
                </span>
                <span class="pubfilter pubfilter--inline eb-rest" id="eb-rest" data-stops="2" role="radiogroup" aria-label="Weight of the rest of the full title">
                  <label title="The whole title at the title's weight"><input type="radio" class="posradio" name="rest" value="whole" />whole</label>
                  <label title="Only the short title at the title's weight, the rest regular"><input type="radio" class="posradio" name="rest" value="split" checked />split</label>
                </span>
                <span class="pilltoggle">
                  {TITLES.filter((v) => v !== 'full').map((v) => <label hidden={v === 'none'}><input type="radio" class="posradio" name="title" value={v} />{v}</label>)}
                </span>
                {/* Set apart: a pill after the title, where it stands. */}
                <span class="pilltoggle eb-checks" id="eb-tstatus">
                  <label title="Where it stands, while it is not yet out — submitted or accepted — as a pill after the title"><input type="checkbox" class="eb-check" name="titlestatus" />status</label>
                </span>
              </span>
              {/* Where the title links: nowhere, to the item itself — named by
                  where that is — or to its entry on this site. */}
              <span class="eb-dim">link</span>
              <span class="pilltoggle" role="radiogroup" aria-label="Where the title links">
                <label title="The title as words"><input type="radio" class="posradio" name="titlelink" value="" checked />none</label>
                <label id="eb-tl-link" title="The title a link to the item itself"><input type="radio" class="posradio" name="titlelink" value="link" /><span></span></label>
                <label id="eb-tl-ads" title="The title a link to its ADS abstract"><input type="radio" class="posradio" name="titlelink" value="ads" /><span></span></label>
                <label id="eb-tl-journal" title="The title a link to where it was published: the publisher's own page, or its DOI"><input type="radio" class="posradio" name="titlelink" value="journal" /><span></span></label>
                <label id="eb-tl-site" title="The title a link to its entry on this website: /publications/ or /software/"><input type="radio" class="posradio" name="titlelink" value="site" /><span></span></label>
              </span>
              {/* Its size — a size typed, or, the default, following the text
                  size — and on the same line its weight, from a menu. */}
              <span class="eb-dim">size</span>
              <span class="eb-px">
                <TextLook label="The title's" sizeName="titlesizepx" byName="titlesize" weightName="titleweight" styleName="titlestyle" faceName="titleface" max={STEP_PX.titlesize.max} sizeTitle={STEP_PX.titlesize.what} autoTitle="Medium, or regular where I am past second author" mine />
              </span>
            </span>
          </fieldset>

          {/* Which byline: short, full or so many names. none is the tick
              box's above. Then my students marked or plain, and where each
              co-author links. */}
          <fieldset class="eb-row" id="eb-authors-row" data-tune="authors" hidden>
            <legend class="eb-key">Authors</legend>
            <span class="eb-sub">
              {/* Their area, beside the venue's, where it shows: their own
                  line above it or below it, or one line shared, the venue after
                  them — the Published row's area, from this side. */}
              <span class="eb-dim" id="eb-aarea-key">area</span>
              <span class="eb-px" id="eb-aarea">
                <select name="authorsline" class="eb-menu" aria-label="The authors' area, beside the venue's">
                  <option value="above" title="A line of their own, above the venue's" selected>above published</option>
                  <option value="below" title="A line of their own, below the venue's">below published</option>
                  <option value="left" title="An area of their own, left of the venue's, on one line">left of published</option>
                  <option value="right" title="An area of their own, right of the venue's, on one line">right of published</option>
                  <option value="shared" title="One area, shared with the venue">with published</option>
                </select>
                {/* Sharing a line with the venue, which comes first. */}
                <span class="eb-dim eb-inkey" id="eb-aorder-key">order</span>
                <select name="authorsorder" id="eb-aorder" class="eb-menu" aria-label="The authors before or after the venue, on their line">
                  <option value="before" selected>before published</option>
                  <option value="after">after published</option>
                </select>
              </span>
              <span class="eb-dim">length</span>
              <span class="eb-pair">
                <span class="pilltoggle">
                  {AUTHORS.map((v) => <label hidden={v === 'none'}><input type="radio" class="posradio" name="authors" value={v} />{v}</label>)}
                  {/* So many names: a choice like the others, its number typed. */}
                  <label class="eb-px" title={`So many names, 1–${AUTHORS_MAX}, keeping mine`}><input type="radio" class="posradio" name="authors" value="n" /><NumBox name="authorsn" min="1" max={AUTHORS_MAX} by={1} from="5" placeholder="#" label="Number of names" /></label>
                </span>
                {/* Fewer names, to the length chosen, where they would run past
                    one line — the venue after them, where it is, included. */}
                <span class="pilltoggle eb-checks">
                  <label title="Fewer names where they would run past one line, the venue after them included"><input type="checkbox" class="eb-check" name="authorsfit" />fit</label>
                </span>
              </span>
              <span class="eb-dim" id="eb-marks-key">students</span>
              <span class="pilltoggle" id="eb-marks" role="radiogroup" aria-label="Marking of my students">
                <label title="My students set like any other co-author"><input type="radio" class="posradio" name="marks" value="plain" checked />plain</label>
                <label title="My students coloured, with † and ‡"><input type="radio" class="posradio" name="marks" value="marked" />marked</label>
              </span>
              {/* For a byline: each co-author a link — to their ORCID, or to the
                  papers we wrote together on the collaborator map — or not. */}
              <span class="eb-dim" id="eb-orcid-key">link</span>
              <span class="pilltoggle" id="eb-orcid" role="radiogroup" aria-label="Where each co-author links">
                <label title="The names as words"><input type="radio" class="posradio" name="authorlink" value="" checked />none</label>
                <label title="Each co-author a link to their ORCID, where they have one"><input type="radio" class="posradio" name="authorlink" value="orcid" />ORCID</label>
                <label title="Each co-author a link to the papers we wrote together, on the collaborator map at /research/, where they are on it"><input type="radio" class="posradio" name="authorlink" value="site" />our papers</label>
              </span>
              <span class="eb-dim">size</span>
              <span class="eb-px"><TextLook name="authors" label="The authors'" /></span>
            </span>
          </fieldset>

          {/* The venue line, where Published asks for it: where the paper
              stands as a pill at its end, as the title has one — the status
              extra — and its size and weight. Clicking it brings it up. */}
          <fieldset class="eb-row" id="eb-venue-row" data-tune="venue" hidden>
            <legend class="eb-key">Published</legend>
            <span class="eb-sub">
              {/* First, as every part has, its area: a line of its own in the
                  center, below the authors' or above it, and its position
                  across it; or the authors' line, shared, after them — at
                  their right, and only there. The Authors row's area is the
                  same choice, from their side. */}
              <span class="eb-dim">area</span>
              <span class="eb-px">
                <select name="venueline" class="eb-menu" aria-label="The area the venue sits in">
                  <option value="below" title="A line of its own, below the authors'" selected>below authors</option>
                  <option value="above" title="A line of its own, above the authors'">above authors</option>
                  <option value="left" title="An area of its own, left of the authors', on one line">left of authors</option>
                  <option value="right" title="An area of its own, right of the authors', on one line">right of authors</option>
                  <option value="authors" title="The authors' area, shared">with authors</option>
                </select>
                <span class="eb-dim eb-inkey" id="eb-vpos-key">position</span>
                <span id="eb-vpos"><Place h="venuealign" label="The venue line's position" /></span>
                {/* Beside the authors, the left column's width — a share or px;
                    the right takes the rest. Dragged by its grip, too. */}
                <span class="eb-dim eb-inkey" id="eb-vsplit-key">left width</span>
                <NumBox id="eb-vsplit" title="The left column's width, a share of the line or px; the right takes the rest" name="vsplitn" min="5" max="800" placeholder="auto" label="The left column's width" unitName="vsplitu" unitLabel="The left column's width, as"
                  units={[{ value: '%', label: '%', title: 'A share of the line', checked: true }, { value: 'px', label: 'px', title: 'In pixels' }]} />
                {/* Sharing the authors' line, which comes first. */}
                <span class="eb-dim eb-inkey" id="eb-vorder-key">order</span>
                <select name="venueorder" id="eb-vorder" class="eb-menu" aria-label="The venue before or after the authors, on their line">
                  <option value="after" selected>after authors</option>
                  <option value="before">before authors</option>
                </select>
              </span>
              {/* The journal's name in full or short, where it has a short one. */}
              <span class="eb-dim" id="eb-vname-key">length</span>
              <span class="pilltoggle" id="eb-vname" role="radiogroup" aria-label="The journal's name">
                <label title="The journal's name in full"><input type="radio" class="posradio" name="venuename" value="full" checked />full</label>
                <label id="eb-vname-short" title="The journal's short name"><input type="radio" class="posradio" name="venuename" value="short" />short</label>
              </span>
              {/* Whether the journal's name links to the article, where it has one. */}
              <span class="eb-dim" id="eb-vlink-key">link</span>
              <span class="pilltoggle" id="eb-vlink" role="radiogroup" aria-label="Where the journal's name links">
                <label title="The journal's name as words"><input type="radio" class="posradio" name="venuelink" value="none" />none</label>
                <label title="The journal's name a link to the article"><input type="radio" class="posradio" name="venuelink" value="journal" checked />journal</label>
              </span>
              {/* The year, and where the paper stands as a pill. */}
              <span class="eb-dim">show</span>
              <span class="pilltoggle eb-checks">
                <label title="The year it appeared"><input type="checkbox" class="eb-check" name="venuedate" checked />date</label>
                <label id="eb-varxiv" title="For a paper in no journal yet, its arXiv number in place of a journal; unticked, no venue at all"><input type="checkbox" class="eb-check" name="venuearxiv" checked />arXiv</label>
                <label id="eb-vstatus" title="Where it stands — submitted or accepted — as a pill at the end of the venue line"><input type="checkbox" class="eb-check" name="extra" value="status" />status</label>
              </span>
              <span class="eb-dim">size</span>
              <span class="eb-px"><TextLook name="venue" label="The venue line's" /></span>
            </span>
          </fieldset>

          {/* My author position, "1st", where Extras asks for it: an area —
              with the buttons, or a strip at the top or bottom — and a place
              there. Clicking it brings it up. */}
          <fieldset class="eb-row" id="eb-pos-row" data-tune="position" hidden>
            <legend class="eb-key">Position</legend>
            <span class="eb-sub">
              <span class="eb-dim">area</span>
              <span class="eb-px">
                <select name="posat" id="eb-posat" class="eb-menu" aria-label="The area my position sits in">
                  <option value="top" title="A strip across the card's top">top</option>
                  <option value="" title="With the buttons, in their area" selected class="eb-boxname">center</option>
                  <option value="bottom" title="A strip across the card's bottom" class="eb-stripbottom">bottom</option>
                  <option value="list" title="Among the buttons, a row of its own in their grid, ordered with them">among buttons</option>
                </select>
                <span class="eb-dim eb-inkey">position</span>
                <Place v="posv" vId="eb-posv" vValue="bottom" h="posh" label="My position" />
              </span>
              <span class="eb-dim">size</span>
              <span class="eb-px"><TextLook name="position" label="My position's" /></span>
            </span>
          </fieldset>

          {/* The year and the context link, where Extras asks for them: each in
              an area — with the buttons, or a strip at the top or bottom — and
              at a place there. Where my position is in the same place as the
              year, the two read as one, "1st | 2026". Clicking either brings
              up its own row. */}
          <fieldset class="eb-row" id="eb-year-row" data-tune="year" hidden>
            <legend class="eb-key">Year</legend>
            <span class="eb-sub">
              <span class="eb-dim">area</span>
              <span class="eb-px">
                <select name="yearat" id="eb-yearat" class="eb-menu" aria-label="The area the year sits in">
                  <option value="top" title="A strip across the card's top">top</option>
                  <option value="" title="With the buttons, in their area" selected class="eb-boxname">center</option>
                  <option value="bottom" title="A strip across the card's bottom" class="eb-stripbottom">bottom</option>
                  <option value="list" title="Among the buttons, a row of its own in their grid, ordered with them">among buttons</option>
                </select>
                <span class="eb-dim eb-inkey">position</span>
                <Place v="yearv" vId="eb-yearv" vValue="bottom" h="yearh" label="The year" />
              </span>
              <span class="eb-dim">size</span>
              <span class="eb-px"><TextLook name="year" label="The year's" /></span>
            </span>
          </fieldset>
          <fieldset class="eb-row" id="eb-ctx-row" data-tune="context" hidden>
            <legend class="eb-key">Context</legend>
            <span class="eb-sub">
              <span class="eb-dim">area</span>
              <span class="eb-px">
                <select name="ctxat" id="eb-ctxat" class="eb-menu" aria-label="The area the context link sits in">
                  <option value="top" title="A strip across the card's top">top</option>
                  <option value="" title="With the buttons, in their area" selected class="eb-boxname">center</option>
                  <option value="bottom" title="A strip across the card's bottom" class="eb-stripbottom">bottom</option>
                  <option value="list" title="Among the buttons, a row of its own in their grid, ordered with them">among buttons</option>
                </select>
                <span class="eb-dim eb-inkey">position</span>
                <Place v="ctxv" vId="eb-ctxv" vValue="bottom" h="ctxh" label="The context link" />
              </span>
              <span class="eb-dim">size</span>
              <span class="eb-px"><TextLook name="context" label="The context link's" /></span>
            </span>
          </fieldset>

          {/* Which text: the record's summary or its details — none is the
              tick box's above — then, as the title's, its position across the
              center, and its own size and weight. */}
          <fieldset class="eb-row" id="eb-text-row" data-tune="text" hidden>
            <legend class="eb-key">Text</legend>
            <span class="eb-sub">
              <span class="eb-dim">length</span>
              <span class="pilltoggle">
                {TEXTS.map((v) => <label hidden={v === 'none'}><input type="radio" class="posradio" name="text" value={v} />{v}</label>)}
              </span>
              {/* Its position, size and weight on one line, wrapping as the
                  page narrows. */}
              <span class="eb-dim">position</span>
              <span class="eb-px">
                <Place h="textalign" label="The text's position" />
                <span class="eb-dim eb-inkey">size</span>
                <TextLook name="body" label="The text's" />
              </span>
            </span>
          </fieldset>

          {/* The figure: its area — the left side, the center or the right
              side — and its position there: at a side, where in the card's
              height and across its column; in the center, its slot among
              the parts; its size in
              its column — filling it (auto), a share of it, or its own px;
              and whether it is a link. Clicking the figure in the preview
              brings it up. */}
          <fieldset class="eb-row" id="eb-figure-row" data-tune="figure" hidden>
            <legend class="eb-key">Figure</legend>
            <span class="eb-sub">
              {/* The area it sits in, then — in a side — where in that area. */}
              <span class="eb-dim">area</span>
              <span class="eb-px">
                <select name="figat" class="eb-menu" aria-label="The area the figure sits in">
                  {FIGURE_AT.map((v) => <option value={v} title={{ left: 'In the left side', center: 'In the center, among the words', right: 'In the right side' }[v]} selected={v === 'center'}>{{ left: 'LHS', center: 'center', right: 'RHS' }[v]}</option>)}
                </select>
                <span class="eb-dim eb-inkey">position</span>
                {/* In the center, which of its slots, among its parts; in a
                    side, up and down and across. */}
                <Place among={{ name: 'figslot', id: 'eb-figslot', value: 'title', options: FIGURE_SLOTS.map((v) => [v, v === 'top' ? 'above title' : `below ${v}`]) }}
                  v="figv" vId="eb-figv" vValue="center" h="figh" hId="eb-figh" hValue="center" label="The figure's position" />
              </span>
              <span class="eb-dim">size</span>
              <span class="eb-px">
                <NumBox title="The figure's width: a share of its column, or its own px; empty fills the column" name="figpx" min="8" max="800" placeholder="auto" label="Figure width" unitName="figunit" unitLabel="The figure's width, as"
                  units={[{ value: '%', label: '%', title: 'A share of its column', checked: true }, { value: 'px', label: 'px', title: 'Its own width in px' }]} />
                <span class="pilltoggle" role="radiogroup" aria-label="Figure size">
                  <label><input type="radio" class="posradio" name="figp" value="auto" />auto</label>
                </span>
              </span>
              <span class="eb-dim">link</span>
              <span class="pilltoggle eb-checks">
                <label title="The figure a link to the item"><input type="checkbox" class="eb-check" name="figlink" />link</label>
              </span>
              {/* The white around the figure: as it is, none, a step, or px. */}
              <span class="eb-dim">frame</span>
              <span class="eb-px">
                <NumBox title="The white around the figure, in pixels" name="framepx" min="0" max="32" placeholder="auto" label="Figure frame in pixels" unit="px" />
                <span class="pilltoggle" role="radiogroup" aria-label="Figure frame">
                  <label title="As it is"><input type="radio" class="posradio" name="frame" value="" checked />auto</label>
                  <label title="The bare image"><input type="radio" class="posradio" name="frame" value="none" />none</label>
                </span>
              </span>
            </span>
          </fieldset>

          {/* Space between two of the card's slots: added with the ⊕ that
              shows between two parts in the preview, each then px or flex —
              what room is left, pushing the two apart. */}
          <fieldset class="eb-row" data-tune="space" hidden>
            <legend class="eb-key">Space</legend>
            <span class="eb-sub">
              <span class="eb-dim">between</span>
              <span class="eb-tracks" id="eb-tracks"></span>
              {/* A space's box, the same as every other, copied for each. */}
              <template id="eb-trackbox"><NumBox min="0" max="64" placeholder="–" unit="px" /></template>
            </span>
            <span class="eb-sub">
              <span class="eb-dim">above each part</span>
              <NumBox title="The space above each part — the title, figure, authors, venue, text and buttons — in px; empty is the layout's own" name="partgap" min="0" max="32" step="0.1" by={1} placeholder="auto" label="Space above each part, in pixels" unit="px" />
            </span>
          </fieldset>

          {/* The buttons: their area — the left side, under the words, the
              right side, or the bottom — and their place in it, up and down
              in a side and across; and how they are laid out, so many to a
              row. Clicking any of them in the preview brings it up. */}
          <fieldset class="eb-row" data-tune="foot" hidden>
            <legend class="eb-key">Buttons</legend>
            <span class="eb-sub">
              {/* The area they sit in: a side, under the words, or the bottom.
                  Then where in it. */}
              <span class="eb-dim">area</span>
              <span class="eb-px">
                <select name="foot" class="eb-menu" aria-label="The area the buttons sit in">
                  {FOOT_AT.map((v) => <option value={v} title={{ left: 'In the left side, under its figure', center: 'Under the words', right: 'In the right side, under its figure', bottom: 'In the bottom area, the full width' }[v]}>{{ left: 'LHS', center: 'center', right: 'RHS', bottom: 'bottom' }[v]}</option>)}
                </select>
                <span class="eb-dim eb-inkey">position</span>
                <Place v="footend" vId="eb-footend" h="railalign" label="The buttons' position" />
              </span>
              {/* Their order: each shown button, moved earlier or later by its
                  < and > — or dragged among the others in the preview. */}
              <span class="eb-dim" id="eb-order-key">order</span>
              <span class="eb-px" id="eb-order"></span>
              <span class="eb-dim">layout</span>
              <span class="eb-px">
                <NumBox title="The link buttons to a row before the next" name="perrow" min="1" max="12" by={1} placeholder="√n" label="Link buttons per row" after="per row" />
                <span class="pilltoggle" role="radiogroup" aria-label="Link buttons to a row">
                  <label title="As near square as they go: ⌈√n⌉ to a row"><input type="radio" class="posradio" name="perp" value="square" checked />square</label>
                  <label title="As many to a row as fit"><input type="radio" class="posradio" name="perp" value="fit" />fit</label>
                </span>
                {/* And on the same line, the space between them. */}
                <span class="eb-dim eb-inkey">gap</span>
                <NumBox title="The space between the buttons, in px or a share of a button's size; empty is a third of the text's height" name="bgap" min="0" max="100" placeholder="auto" label="Space between buttons" unitName="bgapu" unitLabel="The space between the buttons, as"
                  units={[{ value: '%', label: '%', title: "A share of a button's size" }, { value: 'px', label: 'px', title: 'In pixels', checked: true }]} />
              </span>
              {/* Their size, typed or stepped; a step a name gives shows in px. */}
              <span class="eb-dim">size</span>
              <span class="eb-px">
                <NumBox title={STEP_PX.buttons.what} name="buttonspx" min={STEP_PX.buttons.min} max={STEP_PX.buttons.max} label="Button size in pixels" unit="px" />
                {/* The steps, kept for a name that gives one, but not offered:
                    the size is the box's, typed or stepped. */}
                <span class="pubfilter pubfilter--inline eb-sizes eb-dial" data-stops={LOOKS.length + 1} role="radiogroup" aria-label="Button size" hidden>
                  {LOOKS.map((v) => <label title={`${v}: ${STEP_PX.buttons[v]}px`}><input type="radio" class="posradio" name="buttons" value={v} />{STEP_PX.buttons[v]}</label>)}
                  <label class="eb-bywidth" title="Follows the box's width"><input type="radio" class="posradio" name="buttons" value="width" />by width</label>
                </span>
              </span>
            </span>
          </fieldset>

          {/* The paper button, a part of its own, where its pill above is
              ticked: its label, a word or the paper glyph; and where it links
              — the article, else arXiv, or one of them. Ticking the pill, or
              clicking the button in the preview, brings it up. */}
          <fieldset class="eb-row" id="eb-paper-row" data-tune="paper" hidden>
            <legend class="eb-key">Paper</legend>
            <span class="eb-sub">
              <span class="eb-dim">label</span>
              <span class="eb-px">
                <select name="paperlabel" class="eb-menu" aria-label="The paper button's label">
                  <option value="word" selected>word</option>
                  <option value="icon">icon</option>
                </select>
                <input type="text" name="paperword" class="eb-word" value="paper" maxlength="16" pattern="[A-Za-z0-9]{1,16}" aria-label="The paper button's word, letters and digits" />
              </span>
              <span class="eb-dim">color</span>
              <span class="eb-px">
                <select name="papercolor" class="eb-menu" aria-label="The paper button's color">
                  <option value="" title="In the accent" selected>blue</option>
                  <option value="grey" title="In the greys of the site's word buttons">grey</option>
                </select>
              </span>
              <span class="eb-dim">link</span>
              <span class="eb-px">
                <select name="paperto" class="eb-menu" aria-label="Where the paper button links">
                  <option value="" title="The article where it is out, else arXiv" selected>article, else arXiv</option>
                  <option value="journal">journal</option>
                  <option value="arxiv">arXiv</option>
                  <option value="ads">ADS</option>
                  <option value="site">/website/</option>
                </select>
              </span>
            </span>
          </fieldset>

          {/* The look, under the card it draws: the text size, then the
              card's tint — a scale: none, the lighter tint /publications/
              uses, the site's, and twice it — then padding and corners, each
              set on its own. On a fixed box each may instead follow the box's
              width — the last stop. The buttons' size is in the Buttons row. */}
          {DIALS.map((d) => (<>
            {d === 'padding' && (
              <fieldset class="eb-row" data-tune="background" hidden>
                <legend class="eb-key">Background</legend>
                <span class="pubfilter pubfilter--inline eb-sizes" data-stops={BACKGROUNDS.length} role="radiogroup" aria-label="Background">
                  {BACKGROUNDS.map((v) => <label><input type="radio" class="posradio" name="background" value={v} checked={v === 'normal'} />{v}</label>)}
                </span>
              </fieldset>
            )}
            {d !== 'buttons' && <fieldset class="eb-row" data-tune={d} hidden>
              <legend class="eb-key">{{ textsize: 'Text size' }[d] ?? d[0].toUpperCase() + d.slice(1)}</legend>
              {/* Text size, padding and corners may be any size typed, as a fixed
                  box's width may: the box shows the step's in px, and typing
                  leaves the steps. */}
              {STEP_PX[d] && (
                <span class="eb-px">
                  <NumBox title={STEP_PX[d].what} name={`${d}px`} min={STEP_PX[d].min} max={STEP_PX[d].max} step={d === 'textsize' ? '0.1' : '1'} label={`${d} in pixels`} unit="px" />
                </span>
              )}
              <span class="pubfilter pubfilter--inline eb-sizes eb-dial" data-stops={LOOKS.length + 1} role="radiogroup" aria-label={d}>
                {LOOKS.map((v) => <label title={STEP_PX[d] ? `${v}: ${STEP_PX[d][v]}px` : undefined}><input type="radio" class="posradio" name={d} value={v} />{STEP_PX[d] ? STEP_PX[d][v] : v}</label>)}
                <label class="eb-bywidth" title="Follows the box's width"><input type="radio" class="posradio" name={d} value="width" />by width</label>
              </span>
            </fieldset>}
          </>))}
        </div>

        {/* The format changes only the snippet, never the preview — which is
            always the live card — so it sits here, as a row of pills. */}
        <div class="eb-h eb-head">
          <h3>Use</h3>
          <span class="pilltoggle" role="radiogroup" aria-label="Format">
            <label title="An iframe that stays current"><input type="radio" class="posradio" name="format" value="iframe" checked />iframe</label>
            <label title="The PNGs, light and dark, for HTML"><input type="radio" class="posradio" name="format" value="html" />HTML</label>
            <label title="The PNG, for Markdown"><input type="radio" class="posradio" name="format" value="markdown" />Markdown</label>
            <label title="The PNGs themselves"><input type="radio" class="posradio" name="format" value="png" />PNG</label>
            <label title="The card as a PDF, drawn by Typst: its text selectable and its links live"><input type="radio" class="posradio" name="format" value="pdf" />PDF</label>
          </span>
        </div>
        <div class="eb-codebox">
          <textarea class="eb-code" id="eb-code" readonly rows="6" aria-label="Snippet to copy"></textarea>
          <span class="eb-tools">
            <button type="button" class="iconbtn" id="eb-copy" aria-label="Copy snippet" title="Copy snippet">
              <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-copy" /></svg>
            </button>
            {/* The PNGs and PDFs are drawn here, from the preview, when asked for. */}
            <button type="button" class="iconbtn" id="eb-download" hidden aria-label="Download PNG" title="Download PNG">
              <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-download" /></svg>
            </button>
          </span>
        </div>
        <p class="eb-note" id="eb-note"></p>
        {/* The card's name: what the snippet and the embed URL carry, and what
            a preset is called. Under the snippet, as what it is built from.
            Hidden until asked for — the controls above already say it — and
            then shown on the same line. A button, not <details>, so the name
            can sit beside it rather than below. */}
        <p class="eb-name">
          <button type="button" class="eb-fold" id="eb-name-toggle" aria-expanded="false" aria-controls="eb-slug">Name</button>
          <code id="eb-slug" hidden></code>
        </p>
        </form>
      </div>
    </section>
  </main>
</Base>

<script id="eb-data" type="application/json" set:html={JSON.stringify(data)} />

<script>
  import { mountCardBuilder } from '../../lib/cardbuilder/index.js';
  mountCardBuilder({
    form: document.getElementById('eb'),
    data: JSON.parse(document.getElementById('eb-data').textContent),
  });
</script>
