---
// /tools/ — the things built rather than shown: the site's own, on the
// database (Web Dev, at /webdev/), and those in repos of their own. Out of the
// nav on purpose: reached from the footer.
import Base from '../../layouts/Base.astro';
// Agent Skills come from nstarman/skills' index.json via scripts/collect-skills.mjs: every skill it
// registers, including those that live in other repositories (`from`).
import skillCards from '/config/skills.json';

const groups = [
  {
    id: 'webdev',
    name: 'Web Dev',
    tools: [
      {
        href: '/webdev/cv/',
        name: 'CV Builder',
        text: 'The complete CV with a tick box on every entry and line. Choose what goes in, then compile your own PDF in the browser.',
      },
      {
        href: '/webdev/card/',
        name: 'Card Builder',
        text: 'Any card on this site, for another page: an iframe that stays current, or an image for places that strip iframes, such as a GitHub README.',
      },
      {
        href: '/webdev/tiers/',
        name: 'Software Tiers',
        text: 'Every package and the tier that places it on the software page.',
      },
    ],
  },
  {
    id: 'software-development',
    name: 'Software Development',
    tools: [
      {
        href: 'https://github.com/nstarman/cz-gitmoji-action',
        name: 'cz-gitmoji-action',
        text: 'GitHub Actions for cz-gitmoji: gitmoji commit messages, checked in CI.',
      },
    ],
  },
  {
    id: 'paper-writing',
    name: 'Paper Writing',
    tools: [
      {
        href: 'https://github.com/nstarman/preamble',
        name: 'preamble',
        text: 'A LaTeX preamble worth reusing: packages of base commands, maths notation, and astronomy units, survey names and software links.',
      },
    ],
  },
  {
    id: 'agent-skills',
    name: 'Agent Skills',
    note: { text: 'Install any of them in Claude Code or claude.ai:', link: 'how', href: 'https://github.com/nstarman/skills#installing' },
    tools: skillCards.skills.map((s) => ({ href: s.href, name: s.name, text: s.description, from: s.from })),
  },
];
---
<Base title="Tools — Nathaniel Starkman" description="Tools built on the nstarkman.space database, for writing code and papers, and agent skills.">
  <main>
    {groups.map((g) => (
      <section id={g.id}>
        <div class="wrap">
          <div class="h2row"><h2>{g.name}</h2></div>
          {g.note && <p class="gnote">{g.note.text} <a href={g.note.href}>{g.note.link}</a>.</p>}
          <div class="soft">
            {g.tools.map((t) => (
              /* The whole card is the link: it is the only thing to do with it. */
              <a class="card toolcard" href={t.href}>
                <span class="name">{t.name}</span>
                <p>{t.text}</p>
                {t.from && <span class="from">from {t.from}</span>}
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}
  </main>
</Base>

<style>
  /* A skill that lives in another repository says where; the card links there. */
  .toolcard .from{font-family:var(--mono); font-size:.75rem; color:var(--ink-mute); margin-top:.35rem}
  .gnote{margin:-.4rem 0 .9rem; font-size:.88rem; color:var(--ink-mute)}
</style>
