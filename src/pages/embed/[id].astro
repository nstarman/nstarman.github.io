---
// /embed/<id>/ — one item's card, for an iframe and for the builder's PNGs.
// The query names the card (src/lib/cardname.js), and may pin the theme:
//
//   ?card=size:320:400-figure:center:auto-title:short-authors:none-text:none-extras:position,year-buttons:all-look:standard
//   ?card=size:800:200-figure:none-title:full:split-text:summary-buttons:all:right-look:textsize=feature,buttons=compact
//   ?card=size:fill:fit-figure:none-text:summary-buttons:all:right-look:compact&theme=dark
//
// Every part is rendered and the spec, as data attributes, chooses which show,
// so this applies it before the first paint; with no query it shows the
// item's default card. A name it cannot read leaves that default in place.
import Embed from '../../layouts/Embed.astro';
import Card from '../../components/Card.astro';
import { items } from '../../lib/data.js';
import { CARD_TYPES, defaultSlug, cardFacts } from '../../lib/cards.js';
import { parseName, placeOf, cardFace } from '../../lib/cardname.js';

export const getStaticPaths = () =>
  items.filter((i) => CARD_TYPES.includes(i.type)).map((item) => ({ params: { id: item.id }, props: { item } }));

const { item } = Astro.props;
// The same parser the site and the builder use, run here from its own source.
// The same parser the site and the builder use, and the same cardFace that
// draws Card.astro, run here from their own source: what is left is moving
// the parts the name moves.
const apply = `(function (facts) {
  ${placeOf.toString()}
  ${parseName.toString()}
  ${cardFace.toString()}
  var name = new URLSearchParams(location.search).get('card');
  if (!name) return;
  var spec; try { spec = parseName(name); } catch (e) { return; }
  var card = document.querySelector('.card'), d = card.dataset;
  var face = cardFace(spec, facts);
  Object.keys(face.data).forEach(function (k) { if (face.data[k] == null) delete d[k]; else d[k] = face.data[k]; });
  Object.keys(face.style).forEach(function (k) { if (face.style[k] == null) card.style.removeProperty(k); else card.style.setProperty(k, face.style[k]); });
  // Unlinked, the journal's name is words: its link loses its address.
  [].forEach.call(card.querySelectorAll('a.venuelink'), function (a) {
    if (spec.venueLink === false) a.removeAttribute('href'); else if (a.dataset.href) a.setAttribute('href', a.dataset.href);
  });
  // The title a link — to the item, its entry on this site, its ADS
  // abstract or its journal — or words, as the name asks; the status pill
  // after it either way.
  var ttl = card.querySelector('.c-name'), a = ttl.querySelector(':scope > a');
  var tHref = { link: ttl.dataset.href, site: ttl.dataset.site, ads: ttl.dataset.ads, journal: ttl.dataset.journal }[spec.titleLink];
  if (spec.titleLink && tHref) {
    if (!a) {
      a = document.createElement('a');
      ttl.querySelectorAll(':scope > .c-t').forEach(function (t) { a.append(t); });
      ttl.insertBefore(a, ttl.querySelector(':scope > .c-tstatus'));
    }
    a.href = tHref;
  } else if (a) {
    while (a.firstChild) ttl.insertBefore(a.firstChild, a);
    a.remove();
  }
  // The figure a link or not, as the name asks: the same picture, in an a or
  // a span, out of the tab order when the title is a link too.
  var old = card.querySelector('.c-fig');
  if (old) {
    var want = spec.figureLink && old.dataset.href ? 'A' : 'SPAN';
    if (old.tagName !== want) {
      var neu = document.createElement(want);
      neu.className = old.className;
      neu.dataset.href = old.dataset.href || '';
      if (want === 'A') neu.href = old.dataset.href;
      while (old.firstChild) neu.append(old.firstChild);
      old.replaceWith(neu);
      old = neu;
    }
    if (want === 'A' && spec.titleLink && tHref) old.tabIndex = -1; else old.removeAttribute('tabindex');
  }
  // So many names: each count is rendered, up to the whole list; show the one
  // asked for, or the whole list where it asks for more.
  var counted = typeof spec.authors === 'number';
  var cuts = card.querySelectorAll('.c-by-n');
  var show = function (n) { [].forEach.call(cuts, function (c) { c.hidden = +c.dataset.n !== n; }); };
  show(counted ? Math.min(spec.authors, cuts.length) : 0);
  // authors:…:fit — the most names, to the length asked, that keep the byline,
  // and the venue after it, to one line; again as the card's width changes.
  if (d.authors && spec.authorsFit && cuts.length) {
    var most = Math.min(counted ? spec.authors : spec.authors === 'short' ? 3 : 8, cuts.length);
    var fit = function () {
      var by = card.querySelector('.c-by'), line = parseFloat(getComputedStyle(by).lineHeight);
      d.authors = 'count';
      for (var n = most; n >= 1; n -= 1) { show(n); if (by.getBoundingClientRect().height < line * 1.5) break; }
    };
    // Once the rest of the name is applied — the sides set the words' width —
    // and before the first paint.
    requestAnimationFrame(fit);
    addEventListener('resize', fit);
    if (document.fonts) document.fonts.ready.then(fit);
  }
  // Each co-author a link — to their ORCID, or to our papers on the
  // collaborator map — or words, as the name asks and as they have one.
  [].forEach.call(card.querySelectorAll('.c-by :is([data-orcid], [data-site])'), function (s) {
    var a = s.querySelector(':scope > a');
    var href = spec.authorLink === 'orcid' ? s.dataset.orcid : spec.authorLink === 'site' ? s.dataset.site : null;
    if (href && !a) {
      a = document.createElement('a');
      a.className = 'authorlink';
      a.append(s.firstChild);
      s.prepend(a);
    }
    if (href) a.href = href;
    else if (a) a.replaceWith(a.textContent);
  });
  // The paper button: its link and its label, a word or the glyph.
  var pb = card.querySelector('.c-paperbtn');
  if (pb && face.paper) {
    var word = face.paper.label === 'icon' ? 'paper' : face.paper.label;
    pb.setAttribute('href', pb.dataset[face.paper.to || 'auto']);
    pb.querySelector('.c-pword').textContent = word;
    pb.setAttribute('aria-label', word);
    pb.title = word;
  }
  // The buttons in the name's order — as cardFace lists them, each kept or
  // not — each empty one a button's room, and each part listed among them
  // moved into a row of its own there.
  var foot = card.querySelector('.c-foot'), ul = foot.querySelector('.btns--icon');
  var part = { stamp: foot.querySelector('.c-stamp'), year: foot.querySelector('.c-year'), context: foot.querySelector('.c-context') };
  var paperLi = ul.querySelector('.c-paperli'), lis = [].filter.call(ul.children, function (li) { return li !== paperLi; });
  face.seq.forEach(function (x) {
    var li;
    if (x.paper) li = paperLi;
    else if (x.link != null) li = lis[x.link];
    else {
      li = document.createElement('li');
      li.dataset.rel = x.empty ? 'empty' : x.cell;
      if (x.empty) li.setAttribute('aria-hidden', 'true');
      else { li.className = 'c-cell'; li.appendChild(part[x.cell === 'position' ? 'stamp' : x.cell]); }
    }
    if (x.kept) delete li.dataset.off; else li.dataset.off = '';
    if (x.skip) li.dataset.skip = ''; else delete li.dataset.skip;
    ul.appendChild(li);
  });
  // The buttons, my position, the year and the context link, each in its
  // slot of the buttons' box, across it at its own place — or in a strip of
  // the card's padding; hidden, after the slots.
  [['buttons', ul], ['stamp', part.stamp], ['year', part.year], ['context', part.context]].forEach(function (p) {
    var k = p[0], el = p[1];
    if (!el || el.parentNode.tagName === 'LI') return;
    el.dataset.cross = face.cross[k];
    delete el.dataset.strip; delete el.dataset.across;
    if (face.strip[k]) { el.dataset.strip = face.strip[k].area; el.dataset.across = face.strip[k].h; }
    (face.slot[k] ? foot.querySelector('.c-slot[data-at="' + face.slot[k] + '"]') : foot).appendChild(el);
  });
})(${JSON.stringify(cardFacts(item, true))});`;
---
<Embed title={item.title}>
  <Card item={item} preset={defaultSlug(item)} allCounts />
  <script is:inline set:html={apply} />
</Embed>
