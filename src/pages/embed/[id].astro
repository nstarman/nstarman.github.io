---
// /embed/<id>/ — one item's card, for an iframe and for the builder's PNGs.
// The query names the card (src/lib/cardname.js), and may pin the theme:
//
//   ?card=size:320:400-figure:center:auto-title:short-authors:none-text:none-extras:position,year-buttons:all-look:standard
//   ?card=size:800:200-figure:none-title:full:split-text:summary-buttons:all:right-look:textsize=feature,buttons=compact
//   ?card=size:fill:fit-figure:none-text:summary-buttons:all:right-look:compact&theme=dark
//
// Every part is rendered and the spec, as data attributes, chooses which show,
// so this applies it before the first paint; with no query it shows the
// item's default card. A name it cannot read leaves that default in place.
import Embed from '../../layouts/Embed.astro';
import Card from '../../components/Card.astro';
import { items, splitTitle, authorPosition } from '../../lib/data.js';
import { CARD_TYPES, defaultSlug, hasFigure, hasPosition, hasRole, hasVenue, hasStatus, hasYear, hasContext, titleStatus } from '../../lib/cards.js';
import { parseName, placeOf } from '../../lib/cardname.js';

export const getStaticPaths = () =>
  items.filter((i) => CARD_TYPES.includes(i.type)).map((item) => ({ params: { id: item.id }, props: { item } }));

const { item } = Astro.props;
// The same parser the site and the builder use, run here from its own source.
const apply = `(function (parseName, placeOf, can) {
  var name = new URLSearchParams(location.search).get('card');
  if (!name) return;
  var spec; try { spec = parseName(name); } catch (e) { return; }
  var card = document.querySelector('.card'), d = card.dataset;
  var w = spec.width !== 'fill', h = spec.height !== 'fit';
  d.w = w ? 'px' : 'fill';
  d.h = h ? 'px' : 'fit';
  [['--wpx', w, spec.width + 'px'], ['--hpx', h, spec.height + 'px'], ['--aw', w && h, spec.width], ['--ah', w && h, spec.height]].forEach(function (x) {
    if (x[1]) card.style.setProperty(x[0], x[2]); else card.style.removeProperty(x[0]);
  });
  ['textsize', 'titlesize', 'padding', 'corners', 'buttons'].forEach(function (k) {
    if (spec.dials[k]) d[k] = spec.dials[k]; else delete d[k];
  });
  // A text, padding, corner or button size in px is set as itself — the
  // padding the same on every side — and a button's icon is half the button.
  [['textsize', [['--fs', 1]]], ['titlesize', [['--ts', 1]]], ['padding', [['--pad-t', 1], ['--pad-x', 1], ['--pad-b', 1]]], ['corners', [['--rad', 1]]], ['buttons', [['--ib', 1], ['--ii', 0.5]]]].forEach(function (k) {
    var v = spec.dials[k[0]];
    var n = /^[0-9]/.test(v || '') ? +v : null;
    if (n != null) delete d[k[0]];
    k[1].forEach(function (p) { if (n != null) card.style.setProperty(p[0], n * p[1] + 'px'); else card.style.removeProperty(p[0]); });
  });
  var fig = spec.figure !== 'none' && can.figure;
  if (fig) d.fig = spec.figure; else delete d.fig;
  if (fig && spec.figureAlign) d.figv = spec.figureAlign; else delete d.figv;
  // The figure's own width in its column — a share of it, or px, never
  // wider — and, at a side, where across it; then each side's width, as
  // Card.astro sets them.
  var figPx = typeof spec.figureSize === 'string' && /px$/.test(spec.figureSize) ? parseInt(spec.figureSize, 10) : null;
  if (fig && spec.figureSize !== 'auto') { d.figw = ''; card.style.setProperty('--figw', figPx ? 'min(' + figPx + 'px, 100%)' : spec.figureSize + '%'); } else { delete d.figw; card.style.removeProperty('--figw'); }
  if (fig && spec.figure !== 'center' && spec.figureH) d.figh = spec.figureH; else delete d.figh;
  if (fig && spec.figure === 'center' && spec.figureSlot) d.figslot = spec.figureSlot; else delete d.figslot;
  ['left', 'right'].forEach(function (side) {
    var w = ((spec.sides || {})[side] || {}).width, here = fig && spec.figure === side, v = null;
    if (w && w.indexOf('share=') === 0) v = w.slice(6) + '%';
    else if (w && w.indexOf('min=') === 0) v = 'minmax(' + Math.max(+w.slice(4), here ? figPx || 0 : 0) + 'px, auto)';
    else if (w === 'buttons') v = spec.foot === side ? 'auto' : null;
    else if (here && figPx) v = 'minmax(' + figPx + 'px, auto)';
    var p = side === 'left' ? '--colL' : '--colR';
    if (v) card.style.setProperty(p, v); else card.style.removeProperty(p);
  });
  d.foot = spec.foot;
  // The buttons' place in their area: in a side, up and down it; then
  // across, or along the box under the words or at the bottom.
  if (spec.footEnd) d.footend = spec.footEnd; else delete d.footend;
  if (spec.railAlign) d.railalign = spec.railAlign; else delete d.railalign;
  d.text = spec.text;
  if (spec.title === 'full') delete d.title; else d.title = spec.title;
  if (spec.titleAt === 'top' && spec.title !== 'none') d.titleat = 'top'; else delete d.titleat;
  if (spec.titleAlign) d.titlealign = spec.titleAlign; else delete d.titlealign;
  if (spec.titleAt === 'top' && spec.titleV) d.titlev = spec.titleV; else delete d.titlev;
  if (spec.titleStatus && can.tstatus) d.titlestatus = ''; else delete d.titlestatus;
  // The venue line: the journal's short name, without its year, across.
  if (spec.venueName) d.venuename = spec.venueName; else delete d.venuename;
  if (spec.venueDate === false) d.venueundated = ''; else delete d.venueundated;
  if (spec.venueArxiv === false) d.venuenoarxiv = ''; else delete d.venuenoarxiv;
  // Unlinked, the journal's name is words: its link loses its address.
  [].forEach.call(card.querySelectorAll('a.venuelink'), function (a) {
    if (spec.venueLink === false) a.removeAttribute('href'); else if (a.dataset.href) a.setAttribute('href', a.dataset.href);
  });
  if (spec.venueAlign) d.venuealign = spec.venueAlign; else delete d.venuealign;
  if (spec.venueAt) d.venueat = spec.venueAt; else delete d.venueat;
  if ((spec.venueAt === 'authors' || spec.venueAt === 'beside') && spec.venueFirst) d.venuefirst = ''; else delete d.venuefirst;
  // Beside the authors, the left column's width; the right takes the rest.
  if (spec.venueAt === 'beside' && spec.venueSplit) { d.vsplit = ''; card.style.setProperty('--vsplit', /px$/.test(spec.venueSplit) ? spec.venueSplit : spec.venueSplit + '%'); } else { delete d.vsplit; card.style.removeProperty('--vsplit'); }
  // The text across the center; and each part's own size and weight.
  if (spec.textAlign) d.textalign = spec.textAlign; else delete d.textalign;
  ['title', 'body', 'authors', 'venue', 'position', 'year', 'context'].forEach(function (p) {
    if ((spec.styles || {})[p]) card.style.setProperty('--fst-' + p, spec.styles[p]); else card.style.removeProperty('--fst-' + p);
  });
  ['body', 'authors', 'venue', 'position', 'year', 'context'].forEach(function (p) {
    var sz = (spec.sizes || {})[p], w = (spec.weights || {})[p];
    if (sz) card.style.setProperty('--fs-' + p, sz + 'px'); else card.style.removeProperty('--fs-' + p);
    if (w) card.style.setProperty('--fw-' + p, { regular: 400, medium: 500, bold: 600 }[w]); else card.style.removeProperty('--fw-' + p);
  });
  // The corners each side wins over the top and bottom areas, area:<side>:top,bottom.
  var wins = [];
  ['left', 'right'].forEach(function (side) { ['top', 'bottom'].forEach(function (a) { if (((spec.sides || {})[side] || {})[a]) wins.push(side + '-' + a); }); });
  if (wins.length) d.wins = wins.join(' '); else delete d.wins;
  // The title a link — to the item, its entry on this site, its ADS
  // abstract or its journal — or words, as the name asks.
  var ttl = card.querySelector('.c-name'), a = ttl.querySelector(':scope > a');
  var tHref = { link: ttl.dataset.href, site: ttl.dataset.site, ads: ttl.dataset.ads, journal: ttl.dataset.journal }[spec.titleLink];
  if (spec.titleLink && tHref) {
    if (!a) {
      a = document.createElement('a');
      ttl.querySelectorAll(':scope > .c-t').forEach(function (t) { a.append(t); });
      ttl.append(a);
    }
    a.href = tHref;
  } else if (a) {
    while (a.firstChild) ttl.insertBefore(a.firstChild, a);
    a.remove();
  }
  // The figure a link or not, as the name asks: the same picture, in an a or
  // a span, out of the tab order when the title is a link too.
  var old = card.querySelector('.c-fig');
  if (old) {
    var want = spec.figureLink && old.dataset.href ? 'A' : 'SPAN';
    if (old.tagName !== want) {
      var neu = document.createElement(want);
      neu.className = old.className;
      neu.dataset.href = old.dataset.href || '';
      if (want === 'A') neu.href = old.dataset.href;
      while (old.firstChild) neu.append(old.firstChild);
      old.replaceWith(neu);
      old = neu;
    }
    if (want === 'A' && spec.titleLink && tHref) old.tabIndex = -1; else old.removeAttribute('tabindex');
  }
  if (spec.title === 'full' && spec.rest === 'split' && can.split) d.rest = 'split'; else delete d.rest;
  var counted = typeof spec.authors === 'number';
  var bylined = (spec.authors === 'short' || spec.authors === 'full' || counted) && can.byline;
  if (bylined) d.authors = counted ? 'count' : spec.authors; else delete d.authors;
  // So many names: each count is rendered, up to the whole list; show the one
  // asked for, or the whole list where it asks for more.
  var cuts = card.querySelectorAll('.c-by-n');
  var pick = counted ? Math.min(spec.authors, cuts.length) : 0;
  var show = function (n) { [].forEach.call(cuts, function (c) { c.hidden = +c.dataset.n !== n; }); };
  show(pick);
  // authors:…:fit — the most names, to the length asked, that keep the byline,
  // and the venue after it, to one line; again as the card's width changes.
  if (bylined && spec.authorsFit && cuts.length) {
    var most = Math.min(counted ? spec.authors : spec.authors === 'short' ? 3 : 8, cuts.length);
    var fit = function () {
      var by = card.querySelector('.c-by'), line = parseFloat(getComputedStyle(by).lineHeight);
      d.authors = 'count';
      for (var n = most; n >= 1; n -= 1) { show(n); if (by.getBoundingClientRect().height < line * 1.5) break; }
    };
    // Once the rest of the name is applied — the sides set the words' width —
    // and before the first paint.
    requestAnimationFrame(fit);
    addEventListener('resize', fit);
    if (document.fonts) document.fonts.ready.then(fit);
  }
  if (bylined && spec.marks === 'plain') d.students = 'plain'; else delete d.students;
  // Each co-author a link — to their ORCID, or to our papers on the
  // collaborator map — or words, as the name asks and as they have one.
  [].forEach.call(card.querySelectorAll('.c-by :is([data-orcid], [data-site])'), function (s) {
    var a = s.querySelector(':scope > a');
    var href = spec.authorLink === 'orcid' ? s.dataset.orcid : spec.authorLink === 'site' ? s.dataset.site : null;
    if (href && !a) {
      a = document.createElement('a');
      a.className = 'authorlink';
      a.append(s.firstChild);
      s.prepend(a);
    }
    if (href) a.href = href;
    else if (a) a.replaceWith(a.textContent);
  });
  if (spec.extras.indexOf('position') >= 0 && can.position) d.pos = ''; else delete d.pos;
  ['venue', 'status', 'year', 'role', 'context'].forEach(function (x) {
    if (spec.extras.indexOf(x) >= 0 && can[x]) d[x] = ''; else delete d[x];
  });
  // The buttons, my position, the year and the context link, each in its
  // slot of the buttons' box — start, center or end along it, and across it
  // at its own place — or, in the top area or the bottom one where the
  // buttons are not, a strip; hidden, after the slots. My position and the
  // year read as one, "1st | 2026", where both are in one place.
  var foot = card.querySelector('.c-foot');
  var side = spec.foot === 'left' || spec.foot === 'right';
  var END = { top: 'start', left: 'start', center: 'center', bottom: 'end', right: 'end' };
  var at = { pos: placeOf(spec, 'pos'), year: placeOf(spec, 'year'), context: placeOf(spec, 'context') };
  var together = 'pos' in d && 'year' in d && at.pos.area === at.year.area && at.pos.v === at.year.v && at.pos.h === at.year.h;
  if (together) d.yearwith = ''; else delete d.yearwith;
  var strips = [];
  // The paper button: its label, a word or the glyph, and its link, as the
  // name asks — and with nowhere to go, none. It is the first of the
  // buttons, in their list.
  var pb = card.querySelector('.c-paperbtn'), pbt = spec.paperButton, pbHref = pb && pbt && pb.dataset[pbt.to || 'auto'];
  if (pbHref) { d.paper = ''; pb.setAttribute('href', pbHref); pb.querySelector('.c-pword').textContent = pbt.label === 'icon' ? 'paper' : pbt.label; } else delete d.paper;
  if (pbHref && pbt.label === 'icon') d.paperlabel = 'icon'; else delete d.paperlabel;
  var btnsAt = { v: side ? spec.footEnd || 'top' : 'bottom', h: spec.railAlign || (side ? spec.foot : 'left') };
  [['.btns--icon', true, btnsAt],
    ['.c-stamp', 'pos' in d, at.pos], ['.c-year', 'year' in d && !together, at.year], ['.c-context', 'context' in d, at.context]].forEach(function (p) {
    var el = foot.querySelector(p[0]), pl = p[2];
    if (!el) return;
    el.dataset.cross = END[side ? pl.h : pl.v];
    delete el.dataset.strip; delete el.dataset.h;
    if (p[1] && pl.strip) { el.dataset.strip = pl.area; el.dataset.h = pl.h; if (strips.indexOf(pl.area) < 0) strips.push(pl.area); }
    (p[1] && !pl.strip ? foot.querySelector('.c-slot[data-at="' + END[side ? pl.v : pl.h] + '"]') : foot).appendChild(el);
  });
  if (strips.length) d.strips = strips.join(' '); else delete d.strips;
  if (spec.links === 'all') delete d.links; else d.links = spec.links.join(' ') || 'none';
  // The buttons in the name's order, the keys it lists as it lists them, the
  // rest after — the paper button first of all.
  var ul = card.querySelector('.c-foot .btns--icon');
  var rank = function (li) { if (!li.dataset.rel) return -1; var r = spec.links.indexOf(li.dataset.rel); return r < 0 ? 1e9 : r; };
  if (ul && spec.links !== 'all') [].map.call(ul.children, function (li, i) { return [li, i]; })
    .sort(function (a, b) { return rank(a[0]) - rank(b[0]) || a[1] - b[1]; })
    .forEach(function (p) { ul.appendChild(p[0]); });
  // A button shown: the paper button where it is on; a link, where kept.
  var on = function (li) { return li.dataset.rel ? spec.links === 'all' || spec.links.indexOf(li.dataset.rel) >= 0 : 'paper' in d; };
  // The buttons to a row: as many as fit, so many — no more than are shown —
  // or as near square as the ones shown go.
  // Counted as the room they take: the paper button so many buttons wide —
  // its word in the mono face, rounded up to whole buttons — the rest one
  // each; a row never narrower than it.
  var pn = pbHref ? (pbt.label === 'icon' ? 1 : Math.ceil(0.27 * pbt.label.length + 0.62)) : 1;
  if (pbHref) card.style.setProperty('--pn', pn); else card.style.removeProperty('--pn');
  var cell = function (li) { return li.dataset.rel ? 1 : pn; };
  var shown = [].reduce.call(card.querySelectorAll('.c-foot .btns--icon > li'), function (n, li) { return n + (on(li) ? cell(li) : 0); }, 0);
  var per = spec.perRow === 'fit' || !shown ? 0 : Math.max(pbHref ? pn : 1, Math.min(shown, spec.perRow || Math.ceil(Math.sqrt(shown))));
  if (per) { d.per = ''; card.style.setProperty('--per', per); } else { delete d.per; card.style.removeProperty('--per'); }
  // On a right rail, a short last row sits at the right: its first button,
  // by its place among them all, starts --skip columns in.
  var lis = card.querySelectorAll('.c-foot .btns--icon > li'), short = per && (spec.railAlign || (spec.foot === 'right' ? 'right' : 'left')) === 'right' ? shown % per : 0, n = 0;
  delete d.skipat; card.style.removeProperty('--skip');
  if (short) [].forEach.call(lis, function (li, i) {
    if (!on(li)) return;
    if (n === shown - short) { d.skipat = i + 1; card.style.setProperty('--skip', per - short); }
    n += cell(li);
  });
  if (spec.background === 'normal') delete d.background; else d.background = spec.background;
  // The title's weight, and the frame around the figure: a step, or px.
  // mine: bold where I am first author, regular otherwise.
  if (spec.titleWeight) d.titleweight = spec.titleWeight === 'mine' ? (can.lead ? 'bold' : 'regular') : spec.titleWeight; else delete d.titleweight;
  // The gap between the buttons: px, or a share of a button's size.
  if (spec.buttonGap != null) card.style.setProperty('--bgap', /%$/.test(spec.buttonGap) ? 'calc(var(--ib) * ' + parseInt(spec.buttonGap, 10) / 100 + ')' : spec.buttonGap + 'px'); else card.style.removeProperty('--bgap');
  var framePx = /^[0-9]/.test(spec.frame || '');
  if (spec.frame) d.frame = framePx ? '' : spec.frame; else delete d.frame;
  if (framePx) card.style.setProperty('--frame', spec.frame + 'px'); else card.style.removeProperty('--frame');
  // space: a track between two slots is --sp-<a>_<b>, a length or flex —
  // a row taking what is left (100fr), a column sharing the width with the
  // words (1fr) — and one the name leaves out goes back to 0.
  var sp = spec.space || {};
  var rows = ['title_figure', 'figure_authors', 'authors_venue', 'venue_text', 'text_buttons', 'center_bottom'];
  rows.concat(['top_left', 'top_center', 'top_right', 'left_center', 'center_right']).forEach(function (t) {
    if (sp[t]) card.style.setProperty('--sp-' + t, sp[t] !== 'flex' ? sp[t] + 'px' : rows.indexOf(t) >= 0 ? '100fr' : '1fr'); else card.style.removeProperty('--sp-' + t);
  });
  if (rows.some(function (t) { return sp[t] === 'flex'; })) d.vflex = ''; else delete d.vflex;
  // With nothing left in it — every part hidden or in a strip — the box is
  // none: its column closes, and the words take its room.
  delete d.rail;
  var inRail = [].some.call(foot.querySelectorAll('.c-refs, li[data-rel], .c-paperli, .c-stamp, .c-year, .c-context'), function (e) {
    var s = getComputedStyle(e);
    return s.display !== 'none' && s.position !== 'absolute';
  });
  if (!inRail) d.rail = 'empty';
  // An area the name gives that nothing is in, there all the same: a side
  // its column, the top or bottom a strip of its height.
  var sides = spec.sides || {}, st = (d.strips || '').split(' ');
  var holds = { left: d.fig === 'left' || (d.foot === 'left' && d.rail !== 'empty'), right: d.fig === 'right' || (d.foot === 'right' && d.rail !== 'empty'),
    top: d.titleat === 'top' || st.indexOf('top') >= 0, bottom: (d.foot === 'bottom' && d.rail !== 'empty') || st.indexOf('bottom') >= 0 };
  var empty = ['left', 'right', 'top', 'bottom'].filter(function (a) { return sides[a] && !holds[a]; });
  if (empty.length) d.empty = empty.join(' '); else delete d.empty;
  [['--hT', 'top'], ['--hB', 'bottom']].forEach(function (x) { var h = (sides[x[1]] || {}).height; if (h != null) card.style.setProperty(x[0], h + 'px'); else card.style.removeProperty(x[0]); });
})(${parseName.toString()}, ${placeOf.toString()}, ${JSON.stringify({ lead: item.type !== 'software' && authorPosition(item) === 1, figure: hasFigure(item), position: hasPosition(item), role: hasRole(item), venue: hasVenue(item), status: hasStatus(item), year: hasYear(item), tstatus: !!titleStatus(item), context: hasContext(item), split: !!splitTitle(item), byline: item.type === 'publication' })});`;
---
<Embed title={item.title}>
  <Card item={item} preset={defaultSlug(item)} allCounts />
  <script is:inline set:html={apply} />
</Embed>
