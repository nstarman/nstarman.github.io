---
import Base from '../layouts/Base.astro';
import Publication from '../components/Publication.astro';
import LinkIcons from '../components/LinkIcons.astro';
import { byType, positionStops, year, assists, displayName, links, primaryLink } from '../lib/data.js';
import person from '/config/person.json';

// In-preparation papers stay out of the public list — they still appear in the
// full CV, which has its own In Preparation section.
// No status grouping: every unpublished entry already carries a status pill, so
// "Submitted" / "Published" headings would say it twice. One list, newest first.
// the same ADS and arXiv profile links the home page carries
const profiles = person.contacts.filter((c) => ['ads', 'arxiv'].includes(c.icon));
const pubs = byType('publication').filter((p) => p.status !== 'in-prep');
// A proceeding names its full paper (`preliminaryOf`) and is listed under it,
// not on its own. If that paper is in-prep and so absent, it stands alone.
const shown = new Set(pubs.map((p) => p.id));
const all = pubs.filter((p) => !shown.has(p.preliminaryOf));
const earlier = (p) => pubs.filter((q) => q.preliminaryOf === p.id);

// Stops for the author-position filter, built from the data rather than fixed:
// a stop that selects the same papers as the one before it, or as "All", is a
// stop that does nothing. Today that leaves All / 1st / 2nd.
const stops = positionStops(all);

// Topic filter: every tag in use, most common first. Slugs read fine as labels
// except acronyms.
const LABELS = { cmb: 'CMB', jax: 'JAX', 'milky-way': 'Milky Way', 'machine-learning': 'Machine learning' };
const label = (t) => LABELS[t] ?? (t[0].toUpperCase() + t.slice(1).replace(/-/g, ' '));
// Counts are my own papers. The filter reaches the Assists too, but they are
// filed under these same topics (tests/acknowledgements.test.js) and do not add
// to them.
const counts = {};
for (const p of all) for (const t of p.tags ?? []) counts[t] = (counts[t] ?? 0) + 1;
// Years for the left rail, newest first like the list itself.
const years = [...new Set(all.map(year))].filter(Boolean);
const tags = Object.keys(counts).sort((a, b) => counts[b] - counts[a] || a.localeCompare(b));

// "J. Nibauer & S. Pearson", "J. Nibauer et al." — a card has room for a byline, not a list.
const byline = (a) => {
  const names = a.authors.map(displayName);
  return names.length > 2 ? `${names[0]} et al.` : names.join(' & ');
};
---
<Base title="Publications — Nathaniel Starkman">
  <main>
    {/* Year rail: styled by .cvtoc (shared with the CV), shown only on wide screens. */}
    <nav class="cvtoc" aria-label="Publications by year">
      <ol>
        {years.map((y) => <li><a href={`#y-${y}`} data-year={y}>{y}</a></li>)}
        {/* After the years, as the section is after the papers. */}
        {assists.length > 0 && <li class="toc-assists"><a href="#assists">Assists</a></li>}
      </ol>
    </nav>
    <section>
      <div class="wrap">
        {/* Direct children of .wrap and ahead of .entries, so both the filtering
            and the slider's own position are plain sibling selectors on
            :checked — no :has(), and no JavaScript at all. Clipped rather than
            display:none so they stay focusable and arrow-navigable. */}
        {stops.map((s2) => <input type="radio" name="pos" id={`pos-${s2.n}`} class="posradio" />)}
        <input type="radio" name="pos" id="pos-all" class="posradio" checked />
        {/* Mobile only: opens the author-position row, which is hidden there to
            leave room for the title and the topic menu. */}
        <input type="checkbox" id="posmore" class="posradio" aria-label="Show author position filter" />

        <div class="h2row">
          <div class="ttlgroup">
            <h2>Publications</h2>
            <details class="tagmenu">
              <summary>Topics<span id="tagcount"></span></summary>
              <div class="tagpanel" role="group" aria-label="Filter by topic">
                <label><input type="checkbox" id="tag-all" checked /> All <small>{all.length}</small></label>
                {tags.map((t) => (
                  <label><input type="checkbox" class="tagbox" value={t} /> {label(t)} <small>{counts[t]}</small></label>
                ))}
              </div>
            </details>
          </div>
          <span class="more pubprofiles">
            <label for="posmore" class="posmore" title="Filter by author position">author&nbsp;#&nbsp;<span aria-hidden="true">▾</span></label>
            <span class="poslabel" aria-hidden="true">author&nbsp;# ≤</span>
            <span class="pubfilter" data-stops={stops.length + 1}>
              {stops.map((s2) => (
                <label for={`pos-${s2.n}`}
                       title={s2.n === 1
                         ? `${s2.count} papers where I am first author`
                         : `${s2.count} papers where I am among the first ${s2.n} authors`}>
                  {s2.n}
                </label>
              ))}
              <label for="pos-all" title={`All ${all.length} publications, any author position`}>All</label>
            </span>
            <span class="sep">|</span>
            {profiles.map((c) => (
              <a class="pill" href={c.url} aria-label={c.label} title={`All publications on ${c.label}`}>
                <svg class="ico" aria-hidden="true" focusable="false"><use href={`#i-${c.icon}`} /></svg>
              </a>
            ))}
            {/* The brace alone, no button around it — the profiles are places to
                go, this is a file to take. */}
            <a class="baremark" href="/nstarkman_publications.bib"
               aria-label="BibTeX" title="Every publication as BibTeX">
              <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-bibtex" /></svg>
            </a>
          </span>
        </div>
        <p class="stukey">Students I supervised or advised:{' '}
          <span class="stu--undergraduate">undergraduate<sup>†</sup></span>,{' '}
          <span class="stu--graduate">graduate<sup>‡</sup></span>.</p>
        <div class="entries">
          {all.map((item, i) => <Publication item={item} abstract earlier={earlier(item)} anchor={year(item) !== year(all[i - 1] ?? {}) ? `y-${year(item)}` : undefined} />)}
        </div>

        {/* Papers that thank me, from scripts/collect-acknowledgements.mjs.
            Outside .entries, so the author-position filter never reaches them;
            the topic filter does. */}
        {assists.length > 0 && (
          <div class="assists">
            <h3 id="assists">Assists</h3>
            <p class="lede">Papers that thank me in their acknowledgements.</p>
            <div class="soft">
              {assists.map((a) => {
                const href = primaryLink(a)?.url;
                return (
                  <article class="card card--mini assist" data-tags={a.tags.length ? a.tags.join(' ') : undefined}>
                    <div class="name">{href ? <a href={href}>{a.title}</a> : a.title}</div>
                    <p>{byline(a)} · {a.venue} {a.date.slice(0, 4)}</p>
                    <LinkIcons links={links(a)} />
                  </article>
                );
              })}
            </div>
          </div>
        )}

      </div>
    </section>
  </main>
</Base>

<script>
  import { currentSection } from '../lib/scrollspy.js';

  // Topic filter. A paper shows if it carries any ticked topic; none ticked is
  // "All". Hidden with a class so it composes with the author-position CSS.
  const menu = document.querySelector('.tagmenu');
  const all = document.getElementById('tag-all');
  const boxes = [...document.querySelectorAll('.tagbox')];
  const apply = () => {
    const on = boxes.filter((b) => b.checked).map((b) => b.value);
    all.checked = !on.length;
    document.getElementById('tagcount').textContent = on.length ? ` · ${on.length}` : '';
    document.querySelectorAll('.entry--full, .assist').forEach((e) => {
      const has = (e.dataset.tags ?? '').split(' ');
      e.classList.toggle('tagoff', on.length > 0 && !on.some((t) => has.includes(t)));
    });
    // A heading over no cards is a heading over nothing.
    const assists = document.querySelector('.assists');
    if (assists) assists.hidden = !assists.querySelector('.assist:not(.tagoff)');
  };
  all.addEventListener('change', () => { boxes.forEach((b) => (b.checked = false)); apply(); });
  boxes.forEach((b) => b.addEventListener('change', apply));
  document.addEventListener('click', (e) => { if (!menu.contains(e.target)) menu.open = false; });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') menu.open = false; });

  // Year rail. Years with no paper left after filtering are hidden; the current
  // year is the newest one whose first visible paper has reached the top. Once
  // the Assists section has, it is current instead, and it hides with it.
  const links = [...document.querySelectorAll('.cvtoc a[data-year]')];
  const ack = document.querySelector('.assists');
  const ackLink = document.querySelector('.cvtoc a[href="#assists"]');
  const shown = () => [...document.querySelectorAll('.entry--full')].filter((e) => e.offsetParent);
  const firstOf = (y) => shown().find((e) => e.dataset.year === y);
  // The same rule as the CV's section rail (lib/scrollspy.js): the last paper
  // within 120px of the top, which allows a pixel past its 119px gap.
  const spy = () => {
    const vis = shown();
    const cur = currentSection(
      vis.map((e) => ({ id: e.dataset.year, top: e.getBoundingClientRect().top })), 119);
    const have = new Set(vis.map((e) => e.dataset.year));
    // Or once the page bottoms out: the section is shorter than the viewport,
    // so its heading never climbs as far as a year's does.
    const bottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
    const inAck = Boolean(ack && !ack.hidden && (ack.getBoundingClientRect().top <= 120 || bottom));
    for (const a of links) {
      a.parentElement.hidden = !have.has(a.dataset.year);
      a.classList.toggle('is-current', !inAck && a.dataset.year === cur);
    }
    if (ackLink) {
      ackLink.parentElement.hidden = ack.hidden;
      ackLink.classList.toggle('is-current', inAck);
    }
  };
  document.querySelector('.cvtoc')?.addEventListener('click', (e) => {
    const a = e.target.closest('a[data-year]');
    if (!a) return;
    e.preventDefault();
    firstOf(a.dataset.year)?.scrollIntoView();
  });
  addEventListener('scroll', spy, { passive: true });
  addEventListener('resize', spy, { passive: true });
  document.addEventListener('change', () => requestAnimationFrame(spy));
  spy();
</script>
