---
import Base from '../layouts/Base.astro';
import Publication from '../components/Publication.astro';
import { byType, authorPosition } from '../lib/data.js';
import person from '/config/person.json';

// In-preparation papers stay out of the public list — they still appear in the
// full CV, which has its own In Preparation section.
// In-preparation papers stay out of the public list — they still appear in the
// full CV, which has its own In Preparation section.
// No status grouping: every unpublished entry already carries a status pill, so
// "Submitted" / "Published" headings would say it twice. One list, newest first.
// the same ADS and arXiv profile links the home page carries
const profiles = person.contacts.filter((c) => ['ads', 'arxiv'].includes(c.icon));
const all = byType('publication').filter((p) => p.status !== 'in-prep');

// Stops for the author-position filter, built from the data rather than fixed:
// a stop that selects the same papers as the one before it, or as "All", is a
// stop that does nothing. Today that leaves All / 1st / 2nd.
const positions = all.map(authorPosition).filter((n) => n != null);
const stops = [];
for (let n = 1; n <= 4; n += 1) {
  const count = positions.filter((p) => p <= n).length;
  const previous = stops.length ? stops[stops.length - 1].count : 0;
  if (count > previous && count < positions.length) stops.push({ n, count });
}

// Topic filter: every tag in use, most common first. Slugs read fine as labels
// except acronyms.
const LABELS = { cmb: 'CMB', jax: 'JAX', 'milky-way': 'Milky Way', 'machine-learning': 'Machine learning' };
const label = (t) => LABELS[t] ?? (t[0].toUpperCase() + t.slice(1).replace(/-/g, ' '));
const counts = {};
for (const p of all) for (const t of p.tags ?? []) counts[t] = (counts[t] ?? 0) + 1;
const tags = Object.keys(counts).sort((a, b) => counts[b] - counts[a] || a.localeCompare(b));
---
<Base title="Publications — Nathaniel Starkman">
  <main>
    <section>
      <div class="wrap">
        {/* Direct children of .wrap and ahead of .entries, so both the filtering
            and the slider's own position are plain sibling selectors on
            :checked — no :has(), and no JavaScript at all. Clipped rather than
            display:none so they stay focusable and arrow-navigable. */}
        {stops.map((s2) => <input type="radio" name="pos" id={`pos-${s2.n}`} class="posradio" />)}
        <input type="radio" name="pos" id="pos-all" class="posradio" checked />
        {/* Mobile only: opens the author-position row, which is hidden there to
            leave room for the title and the topic menu. */}
        <input type="checkbox" id="posmore" class="posradio" aria-label="Show author position filter" />

        <div class="h2row">
          <div class="ttlgroup">
            <h2>Publications</h2>
            <details class="tagmenu">
              <summary>Topics<span id="tagcount"></span></summary>
              <div class="tagpanel" role="group" aria-label="Filter by topic">
                <label><input type="checkbox" id="tag-all" checked /> All</label>
                {tags.map((t) => (
                  <label><input type="checkbox" class="tagbox" value={t} /> {label(t)} <small>{counts[t]}</small></label>
                ))}
              </div>
            </details>
          </div>
          <span class="more pubprofiles">
            <label for="posmore" class="posmore" title="Filter by author position">author&nbsp;#&nbsp;<span aria-hidden="true">▾</span></label>
            <span class="poslabel" aria-hidden="true">author&nbsp;# ≤</span>
            <span class="pubfilter" data-stops={stops.length + 1}>
              {stops.map((s2) => (
                <label for={`pos-${s2.n}`}
                       title={s2.n === 1
                         ? `${s2.count} papers where I am first author`
                         : `${s2.count} papers where I am among the first ${s2.n} authors`}>
                  {s2.n}
                </label>
              ))}
              <label for="pos-all" title={`All ${all.length} publications, any author position`}>All</label>
            </span>
            <span class="sep">|</span>
            {profiles.map((c) => (
              <a class="pill" href={c.url} aria-label={c.label} title={`All publications on ${c.label}`}>
                <svg class="ico" aria-hidden="true" focusable="false"><use href={`#i-${c.icon}`} /></svg>
              </a>
            ))}
            {/* The brace alone, no button around it — the profiles are places to
                go, this is a file to take. */}
            <a class="baremark" href="/nstarkman_publications.bib"
               aria-label="BibTeX" title="Every publication as BibTeX">
              <svg class="ico" aria-hidden="true" focusable="false"><use href="#i-bibtex" /></svg>
            </a>
          </span>
        </div>
        <div class="entries">
          {all.map((item) => <Publication item={item} abstract />)}
        </div>

      </div>
    </section>
  </main>
</Base>

<script>
  // Topic filter. A paper shows if it carries any ticked topic; none ticked is
  // "All". Hidden with a class so it composes with the author-position CSS.
  const menu = document.querySelector('.tagmenu');
  const all = document.getElementById('tag-all');
  const boxes = [...document.querySelectorAll('.tagbox')];
  const apply = () => {
    const on = boxes.filter((b) => b.checked).map((b) => b.value);
    all.checked = !on.length;
    document.getElementById('tagcount').textContent = on.length ? ` · ${on.length}` : '';
    document.querySelectorAll('.entry--full').forEach((e) => {
      const has = (e.dataset.tags ?? '').split(' ');
      e.classList.toggle('tagoff', on.length > 0 && !on.some((t) => has.includes(t)));
    });
  };
  all.addEventListener('change', () => { boxes.forEach((b) => (b.checked = false)); apply(); });
  boxes.forEach((b) => b.addEventListener('change', apply));
  document.addEventListener('click', (e) => { if (!menu.contains(e.target)) menu.open = false; });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') menu.open = false; });
</script>
