---
// /webdev/assets/ — every file the build already publishes, in one place to
// download: the CVs, the software cards, the bibliography and the indexes.
// The lists are the ones that build those files, so a new preset or card
// shows here without an edit.
import SiteLayout from '@nstarkman/site-layout/SiteLayout.astro';
import { presetNames } from '../../lib/presets.js';
import { softwareCards, THEMES, cardFile } from '../../lib/softwarecards.js';

const cvs = presetNames.map((p) => ({
  preset: p,
  page: p === 'np' ? '/cv/' : `/cv/${p}/`,
  pdf: `/cv/starkman-cv-${p}.pdf`,
  json: `/cv/${p}.json`,
}));
const data = [
  { href: '/nstarkman_publications.bib', name: 'Publications (BibTeX)', text: 'Every publication but those in preparation.' },
  { href: '/cards/index.json', name: 'Card index', text: 'The software cards below: size, row, and each theme’s file.' },
  { href: '/embed/index.json', name: 'Embed index', text: 'Every embeddable card, its presets, and how to name one.' },
  { href: '/records/item.schema.json', name: 'Record schema', text: 'The schema of every /records/<id>.json.' },
];
const file = (href) => href.split('/').pop();
---
<SiteLayout title="Assets — Nathaniel Starkman" description="Every pre-built file on nstarkman.space to download: CVs, software cards, the bibliography and the data indexes.">
  <main>
    <section id="cv">
      <div class="wrap">
        <div class="h2row"><h2>CV</h2></div>
        <p class="lede">Each CV as a PDF, and the model it is drawn from. To choose what goes in, use the <a href="/webdev/cv/">CV Builder</a>.</p>
        <ul class="assetlist">
          {cvs.map((c) => (
            <li>
              <a href={c.page}><code>{c.preset}</code></a>
              <span class="dl">
                <a href={c.pdf} download={file(c.pdf)}>PDF</a> · <a href={c.json} download={`starkman-cv-${c.preset}.json`}>JSON</a>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="cards">
      <div class="wrap">
        <div class="h2row"><h2>Software Cards</h2></div>
        <p class="lede">The cards the profile README shows, as SVG. Any other card is made in the <a href="/webdev/card/">Card Builder</a>.</p>
        <div class="cardgrid">
          {softwareCards.flatMap(({ input }) => THEMES.map((theme) => (
            <figure class:list={['cardasset', theme]}>
              <img src={cardFile(input.id, theme)} alt={`${input.title} card, ${theme}`} loading="lazy" />
              <figcaption>
                {input.title} · {theme}
                <a href={cardFile(input.id, theme)} download={file(cardFile(input.id, theme))}>SVG</a>
              </figcaption>
            </figure>
          )))}
        </div>
      </div>
    </section>

    <section id="data">
      <div class="wrap">
        <div class="h2row"><h2>Data</h2></div>
        <ul class="assetlist">
          {data.map((d) => (
            <li>
              <span><a href={d.href} download={file(d.href)}>{d.name}</a> — {d.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .assetlist { list-style: none; padding: 0; margin: 0 0 1.5em; }
  .assetlist li { display: flex; justify-content: space-between; gap: 1em; padding: .4em 0; border-bottom: 1px solid var(--rule); }
  .dl { font-family: var(--mono); font-size: .88rem; white-space: nowrap; }
  .cardgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 1rem; }
  .cardasset { margin: 0; }
  .cardasset img { display: block; width: 100%; height: auto; border-radius: 8px; }
  /* Each theme's card on its own ground, so the dark one reads in a light page and back. */
  .cardasset.dark img { background: #111; }
  .cardasset.light img { background: #fff; }
  .cardasset figcaption { display: flex; justify-content: space-between; font-size: .85rem; color: var(--ink-mute); margin-top: .3rem; }
  .cardasset figcaption a { font-family: var(--mono); }
</style>
