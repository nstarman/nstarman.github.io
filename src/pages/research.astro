    <section>
      <div class="wrap">
        <div class="h2row">
          <h2>Research</h2>
          <span class="more"><span class="statustag">WIP</span></span>
        </div>
        <p class="lede">
          Work in progress.
        </p>

        <h3 id="collaborators" class="cmap-head">Collaborators</h3>
        <p class="lede">Most people I have written a paper with:</p>
        <CollabMap />
      </div>
    </section>
  </main>
</Base>
