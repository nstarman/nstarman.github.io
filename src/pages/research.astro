---
import Base from '../layouts/Base.astro';
import CollabMap from '../components/CollabMap.astro';
import ConfMap from '../components/ConfMap.astro';
import Card from '../components/Card.astro';
import { byType, links, primaryLink, resolve, titleOf, HIGHLIGHT_TOPICS } from '../lib/data.js';
import { spans } from '../lib/inline.js';

// Syntheses lead, then each paper's own card; newest first within each.
const papers = byType('publication').filter((p) => p.highlight);
const highlights = [...byType('highlight'), ...papers];
const anchor = (id) => `hl-${id}`;

// A topic with no card yet is skipped.
const groups = HIGHLIGHT_TOPICS
  .map(([key, label, intro]) => ({ key, label, intro, items: highlights.filter((i) => i.highlight.topic === key) }))
  .filter((g) => g.items.length > 0);

const mainHref = (item) => (primaryLink(item) ?? links(item)[0])?.url;

// An intro's `[](item:id)` becomes that paper's inline-card. A typo fails the
// build rather than rendering a card that points nowhere.
const inlineCard = (s) => {
  const p = resolve(s.item);
  if (!p) throw new Error(`research highlights: [](item:${s.item}) names no item`);
  const name = s.t || titleOf(p, 'nick');
  return { name, href: p.highlight ? `#${anchor(p.id)}` : mainHref(p) };
};
---
<Base title="Research — Nathaniel Starkman">
  <main>
    <section>
      <div class="wrap">
        <div class="h2row">
          <h2>Research</h2>
        </div>
        <h3 id="collaborators" class="cmap-head">Collaborators</h3>
        <p class="lede">One of the great pleasures of astrophysics is doing fun work with fun people.
          This is an (incomplete) record of the people I have been lucky enough to write papers with,
          or to help with theirs.</p>
        <CollabMap />

        {highlights.length > 0 && <>
          <h3 id="highlights" class="cmap-head">Research Highlights</h3>
          {groups.map((g) => <>
          <h4 id={`hl-topic-${g.key}`} class="hl-topic">{g.label}</h4>
          {g.intro?.map((para) => (
            <p class="hl-intro">{spans(para, '/cv/').map((s) => {
              if (s.item) {
                const m = inlineCard(s);
                return <a class="inline-card" href={m.href}>{m.name}</a>;
              }
              return s.url ? <a href={s.url}>{s.t}</a> : s.t;
            })}</p>
          ))}
          {/* A carousel: one row that scrolls sideways, each card snapping to the
              start. Focusable so the arrow keys scroll it too. The buttons
              need the script, so they stay hidden until it runs. */}
          <div class="hl-wrap">
          <div class="hl-nav" hidden>
            <button type="button" class="iconbtn" data-step="-1" aria-label={`Previous ${g.label} highlight`}>‹</button>
            <button type="button" class="iconbtn" data-step="1" aria-label={`Next ${g.label} highlight`}>›</button>
          </div>
          <div class="hl" role="region" aria-label={`${g.label} highlights`} tabindex="0">
            {g.items.map((item) => <Card item={item} preset="size:fill:fit-figure:center:auto:link-title:short:link-authors:none-text:none-extras:position,year-buttons:ads,preprint,paper,doi,repo,code:fit-look:titleweight=mine" id={anchor(item.id)} heading="h5" />)}
          </div>
          </div>
          </>)}
        </>}

        <h3 id="conferences" class="cmap-head">Conferences</h3>
        <p class="lede">Every talk, poster and workshop, and where it happened:</p>
        <ConfMap />
      </div>
    </section>
  </main>
</Base>

<script>
  // Prev/next scroll a carousel by one card. Hidden when everything fits;
  // each disabled at its end.
  const motion = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
  for (const wrap of document.querySelectorAll('.hl-wrap')) {
    const row = wrap.querySelector('.hl');
    const nav = wrap.querySelector('.hl-nav');
    const [prev, next] = nav.querySelectorAll('button');
    const card = () => row.querySelector('.card').offsetWidth + parseFloat(getComputedStyle(row).columnGap);
    for (const b of [prev, next]) {
      b.addEventListener('click', () => row.scrollBy({ left: Number(b.dataset.step) * card(), behavior: motion }));
    }
    const update = () => {
      prev.disabled = row.scrollLeft <= 1;
      next.disabled = row.scrollLeft + row.clientWidth >= row.scrollWidth - 1;
      nav.hidden = prev.disabled && next.disabled;
    };
    row.addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
